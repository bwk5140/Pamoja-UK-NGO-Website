@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject ApplicationUserService ApplicationUserService
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

@rendermode InteractiveServer

@if ((!NavigationManager.Uri.Contains("Login") && !NavigationManager.Uri.Contains("Register") &&
    !NavigationManager.Uri.Contains("ConfirmEmail") && !NavigationManager.Uri.Contains("Invalid") &&
    !NavigationManager.Uri.Contains("AccessDenied") && !NavigationManager.Uri.Contains("Lockout") &&
    !NavigationManager.Uri.Contains("EmailConfirmation") && !NavigationManager.Uri.Contains("Forgot") &&
    !NavigationManager.Uri.Contains("Checkout") && !NavigationManager.Uri.Contains("OrderComplete") &&
    !NavigationManager.Uri.Contains("OrderAbandoned") && !NavigationManager.Uri!.Contains("checkout") &&
    !NavigationManager.Uri.Contains("2FAVerification") &&
    !NavigationManager.Uri.Contains("ResetPassword") && !NavigationManager.Uri.Contains("document-viewer") &&
    !NavigationManager.Uri!.Contains("invoice")) || NavigationManager.Uri.Contains("ExternalLogins"))
{

    <nav>
        <div class="nav-container container">
            <a href="/" class="flex space-x-3 logo">
                <img fetchpriority="high"
                     loading="eager" src="Images/PamojaLogo.webp" class="h-36 w-36" alt="Pamoja logo" width="128" height="128" />
            </a>

            <button class="mobile-menu-btn" style="padding: 20px;" @onclick="ToggleMobileMenu">☰</button>

            <ul class="nav-links @(isMobileMenuOpen ? "active" : "")">
                <li><a href="/" aria-label="Navigate to home page" @onclick="CloseMobileMenu" class="@GetNavClass("/")">Home</a></li>
                <li><a href="/about-us" aria-label="Navigate to about-us" @onclick="CloseMobileMenu" class="@GetNavClass("/about-us")">About Us</a></li>
                <li><a href="/services" aria-label="Navigate to services" @onclick="CloseMobileMenu" class="@GetNavClass("/services")">Services</a></li>
                <li><a href="/careers" aria-label="Navigate to careers" @onclick="CloseMobileMenu" class="@GetNavClass("/careers")">Careers</a></li>
                <li><a href="/events" aria-label="Navigate to events" @onclick="CloseMobileMenu" class="@GetNavClass("/events")">Events</a></li>
                <li><a href="/contact-us" aria-label="Navigate to contact-us" @onclick="CloseMobileMenu" class="@GetNavClass("/contact-us")">Contact</a></li>
                <li><a href="/resources" aria-label="Navigate to resources" @onclick="CloseMobileMenu" class="@GetNavClass("/resources")">Resources</a></li>
                <li>
                    <AuthorizeView>
                        <NotAuthorized>
                            <a href="/Account/Login" aria-label="Navigate to log in page" @onclick="CloseMobileMenu" class="flex space-x-2 hover:text-primary" data-bs-toggle="tooltip" title=@Loc["Login"]>
                                <img fetchpriority="high"
                                     loading="eager" src="Icons/account.png" alt="User Account" class="h-8 w-8" />
                                <span class="text-md text-gray-600 hover:text-primary">@Loc["Login"]</span>
                            </a>
                        </NotAuthorized>
                        <Authorized>
                            <a href="/Account/Manage" @onclick="CloseMobileMenu" aria-label="Navigate to manage user page" class="flex space-x-2 hover:text-primary" data-bs-toggle="tooltip" title=@Loc["YourAccount"]>
                                <img fetchpriority="high"
                                     loading="eager" src="Icons/account.png" alt="User Account" class="h-8 w-8" />
                                <span class="text-md text-gray-500 hover:text-primary">
                                    @if (ApplicationUser is not null)
                                    {
                                        @Username
                                    }
                                </span>
                            </a>
                        </Authorized>
                    </AuthorizeView>
                </li>
                <li style="padding-right: 5px;">
                    <AuthorizeView>
                        <Authorized>
                            <form action="Account/Logout" method="post" class="flex space-x-2">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit" @onclick="CloseMobileMenu" class="btn btn-sm font-medium hover:text-primary" style="background-color: transparent; padding: 0px; border: none;" data-bs-toggle="tooltip" title=@Loc["Logout"]>
                                    <img fetchpriority="high"
                                         loading="eager" src="Icons/logout.png" alt="Logout" class="h-8 w-8" />
                                </button>
                            </form>
                        </Authorized>
                    </AuthorizeView>
                </li>
                <li>
                    <button type="button" @onclick="GoToBookAppointment" aria-label="Navigate to book appointment page" class="border-2 border-green-700 rounded-lg" style="padding: 5px;">
                        Book an Appointment
                    </button>
                </li>
            </ul>
        </div>
    </nav>
}

@code {
    private bool showAboutUs = false;
    private bool showServices = false;
    private bool showSafeguarding = false;
    private bool showResources = false;
    private bool showPartnersClients = false;
    private bool showSupportUs = false;
    string? currentUrl { get; set; }
    private bool showAccountOptions = false;
    private bool IsFullScreen = false;

    [Parameter]
    public ApplicationUser? ApplicationUser { get; set; }

    [Parameter]
    public string? Username { get; set; }

    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
        StateHasChanged();
    }
    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
        StateHasChanged();
    }
    public void GoToBookAppointment()
    {
        CloseMobileMenu();
        NavigationManager.NavigateTo("/services/book-appointment", true);
    }
    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        ApplicationUser = await ApplicationUserService.GetApplicationUser();
        if (ApplicationUser is not null)
        {
            var index = ApplicationUser.Name.IndexOf(" ");
            if (index == -1)
            {
                index = ApplicationUser.Name.Length - 1;
            }
            Username = ApplicationUser.Name.Substring(0, index);
        }
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }
    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void OnBookAppointmentClicked()
    {
        NavigationManager.NavigateTo("/services/book-appointment", true);
    }
    private string GetNavClass(string href)
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        var targetPath = href.TrimStart('/').TrimEnd('/');
        return currentPath == targetPath
            ? "border-b-2 border-green-900 text-green-900 font-semibold"
            : "text-gray-600 hover:text-green-800";
    }
}
