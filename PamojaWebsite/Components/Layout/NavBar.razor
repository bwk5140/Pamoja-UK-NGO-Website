@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager NavigationManager
@inject ApplicationUserService ApplicationUserService
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

@rendermode InteractiveServer
@if ((!NavigationManager.Uri.Contains("Login") && !NavigationManager.Uri.Contains("Register") &&
    !NavigationManager.Uri.Contains("ConfirmEmail") && !NavigationManager.Uri.Contains("Invalid") &&
    !NavigationManager.Uri.Contains("AccessDenied") && !NavigationManager.Uri.Contains("Lockout") &&
    !NavigationManager.Uri.Contains("EmailConfirmation") && !NavigationManager.Uri.Contains("Forgot") &&
    !NavigationManager.Uri.Contains("Checkout") && !NavigationManager.Uri.Contains("OrderComplete") &&
    !NavigationManager.Uri.Contains("OrderAbandoned") && !currentUrl!.Contains("checkout") &&
    !NavigationManager.Uri.Contains("2FAVerification") &&
    !currentUrl!.Contains("invoice")) || NavigationManager.Uri.Contains("ExternalLogins"))
{
    <nav class="navbar navbar-expand-lg navbar-light bg-light sticky-top">
        <a class="navbar-brand ms-5 heading" style="padding: 8px; font-size: clamp(1.5rem, 2vw, 2.1rem); font-weight: 350; text-wrap: balance;" href="/">
            Pamoja Mental Health & Safeguarding Network
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <div class="dropdown">
                        <button class="btn btn-sm me-4" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                style="background-color:transparent; color: black; font-size: large; border: none;" @onmouseover="e => this.showAboutUs = true"
                                @onclick="OnAboutUsClicked" @onmouseout="e => this.showAboutUs = false">
                            @Loc["AboutUs"]
                        </button>
                        <ul class="dropdown-menu @(showAboutUs ? "show" : "")" @onmouseleave="e => this.showAboutUs = false"
                            @onmouseover="e => this.showAboutUs = true" style="left: -50%; top: 100%; text-align: center;">
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Mission"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Vision"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Team"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Governance"]</a>
                            </li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <div class="dropdown">
                        <button class="btn btn-sm me-4" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                style="background-color:transparent; color: black; font-size: large; border: none;" @onmouseover="e => this.showServices = true"
                                @onclick="e => this.showServices = !this.showServices" @onmouseout="e => this.showServices = false">
                            @Loc["Services"]
                        </button>
                        <ul class="dropdown-menu @(showServices ? "show" : "")" @onmouseleave="e => this.showServices = false"
                            @onmouseover="e => this.showServices = true" style="left: -50%; top: 100%; text-align: center;">
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Training"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Workshops"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Supervision"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["WellbeingPrograms"]</a>
                            </li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <div class="dropdown">
                        <button class="btn btn-sm me-4" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                style="background-color:transparent; color: black; font-size: large; border: none;" @onmouseover="e => this.showSafeguarding = true"
                                @onclick="e => this.showSafeguarding = !this.showSafeguarding" @onmouseout="e => this.showSafeguarding = false">
                            @Loc["Safeguarding"]
                        </button>
                        <ul class="dropdown-menu @(showSafeguarding ? "show" : "")" @onmouseleave="e => this.showSafeguarding = false"
                            @onmouseover="e => this.showSafeguarding = true" style="left: -30%; top: 100%; text-align: center;">
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Policy"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["ChildProtectionResources"]</a>
                            </li>
                            <hr class="ms-3 me-3" style="padding: 5px;" />
                            <li class="list-group-item dropdown-item ms-2 me-2" style="background-color: transparent;">
                                <button class="btn btn-sm btn-danger me-4 mb-3" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                        style="color: white; font-size: medium;">
                                    @Loc["ReportingAConcern"]
                                </button>
                            </li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <div class="dropdown">
                        <button class="btn btn-sm me-4" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                style="background-color:transparent; color: black; font-size: large; border: none;" @onmouseover="e => this.showResources = true"
                                @onclick="e => this.showResources = !this.showResources" @onmouseout="e => this.showResources = false">
                            @Loc["Resources"]
                        </button>
                        <ul class="dropdown-menu @(showResources ? "show" : "")" @onmouseleave="e => this.showResources = false"
                            @onmouseover="e => this.showResources = true" style="left: -20%; top: 100%; text-align: center;">
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Toolkits"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Blog"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["CaseStudies"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["ImpactReports"]</a>
                            </li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <div class="dropdown">
                        <button class="btn btn-sm me-4" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                style="background-color:transparent; color: black; font-size: large; border: none;" @onmouseover="e => this.showPartnersClients = true"
                                @onclick="e => this.showPartnersClients = !this.showPartnersClients" @onmouseout="e => this.showPartnersClients = false">
                            @Loc["Partners&Clients"]
                        </button>
                        <ul class="dropdown-menu @(showPartnersClients ? "show" : "")" @onmouseleave="e => this.showPartnersClients = false"
                            @onmouseover="e => this.showPartnersClients = true" style="left: 0%; top: 100%; text-align: center;">
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Partners"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Testimonials"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Consortiums"]</a>
                            </li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <div class="dropdown border-end">
                        <button class="btn btn-sm me-2" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                style="background-color:transparent; color: black; font-size: large; border: none;" @onmouseover="e => this.showSupportUs = true"
                                @onclick="e => this.showSupportUs = !this.showSupportUs" @onmouseout="e => this.showSupportUs = false">
                            @Loc["SupportUs"]
                        </button>
                        <ul class="dropdown-menu @(showSupportUs ? "show" : "")" @onmouseleave="e => this.showSupportUs = false" @onmouseover="e => this.showSupportUs = true"
                            style="left: -30%; top: 100%; text-align: center;">
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Donate"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Membership"]</a>
                            </li>
                            <li class="list-group-item dropdown-item ms-2 me-2 mb-2" style="background-color: transparent;">
                                <a class="navbar-brand ms-2" style="padding: 0px; font-size: medium;" href="/">@Loc["Sponsorship"]</a>
                            </li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <AuthorizeView>
                        <NotAuthorized>
                            <div class="dropdown">
                                <button class="btn btn-sm ms-2 me-3" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                        style="background-color:transparent; font-size: large; color: black; border: none;" @onmouseover="e => this.showAccountOptions = true"
                                        @onclick="e => this.showAccountOptions = !this.showAccountOptions" @onmouseout="e => this.showAccountOptions = false">
                                    <img src="Icons/person.svg" />
                                    @Loc["Hello"],
                                    @Loc["Login"]
                                </button>
                                <div class="dropdown-menu @(showAccountOptions ? "show" : "")" @onmouseleave="e => this.showAccountOptions = false" @onmouseover="e => this.showAccountOptions = true"
                                     style="left: -30%; top: 100%;">
                                    <div class="list-group-item dropdown-item ms-3 me-3 mb-2 row" style="background-color: transparent; width: max-content;
                                            max-width: 400px;">
                                        <div style="display: flex; justify-content: center; padding: 5px;">
                                            <button type="button" class="btn btn-md" @onclick=OnSignInClicked style="background-color: #2f4f4f; color:white;">
                                                @Loc["Login"]
                                            </button>
                                        </div>
                                        <div style="display: flex; justify-content: center; padding: 5px;">
                                            <p style="font-size: small;">@Loc["NoAccount"]? <a style="text-decoration: none; font-size: small;" href="/Account/Register">@Loc["Register"]</a></p>

                                        </div>
                                        <hr />
                                        <table class="table table-bordered ms-4 me-4" style="border-top-color: transparent; border-bottom-color: transparent; border-left-color: transparent;
                                                          border-right-color: transparent; width: fit-content;">
                                            <thead>
                                                <tr>
                                                    <th class="ms-4" style="justify-content: center;" scope="col">@Loc["YourAccount"]</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td style="justify-content: center;">
                                                        <div>
                                                            <a style="text-decoration: none; font-size: small; color: black;" href="/AccountSettings">@Loc["Account"]</a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </NotAuthorized>
                        <Authorized>
                            <div class="dropdown">
                                <button class="btn btn-sm ms-2 me-3" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                        style="background-color:transparent; font-size: large; color: black; border: none;" @onmouseover="e => this.showAccountOptions = true"
                                        @onclick="e => this.showAccountOptions = !this.showAccountOptions" @onmouseout="e => this.showAccountOptions = false">
                                    <img src="Icons/person.svg" />
                                    @Loc["Hello"],
                                    @if (ApplicationUser is not null)
                                    {
                                        @Username
                                    }
                                </button>
                                <div class="dropdown-menu @(showAccountOptions ? "show" : "")" @onmouseleave="e => this.showAccountOptions = false" @onmouseover="e => this.showAccountOptions = true"
                                     style="left: -30%; top: 100%;">
                                    <div class="list-group-item dropdown-item ms-3 me-3 mb-2 row" style="background-color: transparent; width: max-content;
                                        max-width: 400px;">
                                        <table class="table table-bordered ms-4 me-4" style="border-top-color: transparent; border-bottom-color: transparent; border-left-color: transparent;
                                                      border-right-color: transparent; width: fit-content;">
                                            <thead>
                                                <tr>
                                                    <th class="ms-4" style="justify-content: center;" scope="col">@Loc["YourAccount"]</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td style="justify-content: center;">
                                                        <form action="Account/Logout" method="post">
                                                            <AntiforgeryToken />
                                                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                                            <button type="submit" class="btn btn-sm" style="background-color: transparent; width: fit-content; padding: 0px;">
                                                                @Loc["Logout"]
                                                            </button>
                                                            <hr class="dropdown-divider">
                                                        </form>
                                                        <div>
                                                            <a style="text-decoration: none; font-size: small; color: black;" href="/AccountSettings">@Loc["Account"]</a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                </li>
            </ul>
        </div>
    </nav>
}

@code {
    private bool showAboutUs = false;
    private bool showServices = false;
    private bool showSafeguarding = false;
    private bool showResources = false;
    private bool showPartnersClients = false;
    private bool showSupportUs = false;
    string? currentUrl { get; set; }
    private bool showAccountOptions = false;

    [Parameter]
    public ApplicationUser? ApplicationUser { get; set; }

    [Parameter]
    public string? Username { get; set; }

    [SupplyParameterFromForm]
    private string? filter { get; set; } = "All";

    [SupplyParameterFromForm]
    public string? search { get; set; }

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        ApplicationUser ??= await ApplicationUserService.GetApplicationUser();
        using var context = await DbFactory.CreateDbContextAsync();
        if (ApplicationUser is not null)
        {
            var index = ApplicationUser.Name.IndexOf(" ");
            if (index == -1)
            {
                index = ApplicationUser.Name.Length - 1;
            }
            Username = ApplicationUser.Name.Substring(0, index);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        StateHasChanged();
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }
    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Search();
        }
    }
    private void OnAboutUsClicked()
    {
        NavigationManager.NavigateTo("/About");
    }
    private void Search()
    {
        if (currentUrl.Contains("searchresults"))
            NavigationManager.NavigateTo($"searchresults?search={search}&filter={filter}&render={true}");
        else
        {
            NavigationManager.NavigateTo($"searchresults?search={search}&filter={filter}&render={false}");
        }
    }
    private void Search(string search)
    {
        NavigationManager.NavigateTo($"searchresults?search={search}", true);
    }
    private void OnSignInClicked()
    {
        NavigationManager.NavigateTo("Account/Login", true);
    }
}
