@page "/contactusforms/edit"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Edit</h1>

    <h2>ContactUsForm</h2>
    <hr />
    @if (ContactUsForm is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="row">
            <div class="col-md-4">
                <EditForm method="post" Model="ContactUsForm" OnValidSubmit="UpdateContactUsForm" FormName="edit" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary role="alert" />
                    <input type="hidden" name="ContactUsForm.Id" value="@ContactUsForm.Id" />
                    <div class="mb-3">
                        <label for="name" class="form-label">Name:</label>
                        <InputText id="name" @bind-Value="ContactUsForm.Name" class="form-control" />
                        <ValidationMessage For="() => ContactUsForm.Name" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email:</label>
                        <InputText id="email" @bind-Value="ContactUsForm.Email" class="form-control" />
                        <ValidationMessage For="() => ContactUsForm.Email" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="subject" class="form-label">Subject:</label>
                        <InputText id="subject" @bind-Value="ContactUsForm.Subject" class="form-control" />
                        <ValidationMessage For="() => ContactUsForm.Subject" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="message" class="form-label">Message:</label>
                        <InputText id="message" @bind-Value="ContactUsForm.Message" class="form-control" />
                        <ValidationMessage For="() => ContactUsForm.Message" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="receivedat" class="form-label">ReceivedAt:</label>
                        <InputDate id="receivedat" @bind-Value="ContactUsForm.ReceivedAt" class="form-control" />
                        <ValidationMessage For="() => ContactUsForm.ReceivedAt" class="text-danger" />
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </EditForm>
            </div>
        </div>
    }

    <div>
        <a href="/contactusforms">Back to List</a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string Id { get; set; }

    [SupplyParameterFromForm]
    private ContactUsForm? ContactUsForm { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        ContactUsForm ??= await context.ContactUsForm.FirstOrDefaultAsync(m => m.Id == Id);

        if (ContactUsForm is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateContactUsForm()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(ContactUsForm!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ContactUsFormExists(ContactUsForm!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/contactusforms");
    }

    private bool ContactUsFormExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.ContactUsForm.Any(e => e.Id == id);
    }
}
