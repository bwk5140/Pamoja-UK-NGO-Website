@page "/contactusforms/delete"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Delete</h1>

    <p>Are you sure you want to delete this?</p>
    <div>
        <h2>ContactUsForm</h2>
        <hr />
        @if (contactusform is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Name</dt>
                <dd class="col-sm-10">@contactusform.Name</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Email</dt>
                <dd class="col-sm-10">@contactusform.Email</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Subject</dt>
                <dd class="col-sm-10">@contactusform.Subject</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Message</dt>
                <dd class="col-sm-10">@contactusform.Message</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">ReceivedAt</dt>
                <dd class="col-sm-10">@contactusform.ReceivedAt</dd>
            </dl>
            <EditForm method="post" Model="contactusform" OnValidSubmit="DeleteContactUsForm" FormName="delete" Enhance>
                <button type="submit" class="btn btn-danger" disabled="@(contactusform is null)">Delete</button> |
                <a href="/contactusforms">Back to List</a>
            </EditForm>
        }
    </div>
</div>

@code {
    private ContactUsForm? contactusform;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        contactusform = await context.ContactUsForm.FirstOrDefaultAsync(m => m.Id == Id);

        if (contactusform is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteContactUsForm()
    {
        using var context = DbFactory.CreateDbContext();
        context.ContactUsForm.Remove(contactusform!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/contactusforms");
    }
}
