@page "/contactusforms/create"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Create</h1>

    <h2>ContactUsForm</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="ContactUsForm" OnValidSubmit="AddContactUsForm" FormName="create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="ContactUsForm.Name" class="form-control" />
                    <ValidationMessage For="() => ContactUsForm.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email:</label>
                    <InputText id="email" @bind-Value="ContactUsForm.Email" class="form-control" />
                    <ValidationMessage For="() => ContactUsForm.Email" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="subject" class="form-label">Subject:</label>
                    <InputText id="subject" @bind-Value="ContactUsForm.Subject" class="form-control" />
                    <ValidationMessage For="() => ContactUsForm.Subject" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="message" class="form-label">Message:</label>
                    <InputText id="message" @bind-Value="ContactUsForm.Message" class="form-control" />
                    <ValidationMessage For="() => ContactUsForm.Message" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="receivedat" class="form-label">ReceivedAt:</label>
                    <InputDate id="receivedat" @bind-Value="ContactUsForm.ReceivedAt" class="form-control" />
                    <ValidationMessage For="() => ContactUsForm.ReceivedAt" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
        </div>
    </div>

    <div>
        <a href="/contactusforms">Back to List</a>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private ContactUsForm ContactUsForm { get; set; } = default!;

    protected override void OnInitialized() => ContactUsForm ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddContactUsForm()
    {
        using var context = DbFactory.CreateDbContext();
        context.ContactUsForm.Add(ContactUsForm);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/contactusforms");
    }
}
