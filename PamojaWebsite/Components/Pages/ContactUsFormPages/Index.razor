@page "/contactusforms"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using PamojaWebsite.Data
@using PamojaWebsite.Data.Contexts
@implements IAsyncDisposable
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

<PageTitle>Index</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Index</h1>

    <p>
        <a href="contactusforms/create">Create New</a>
    </p>

    <QuickGrid Class="table" Items="context.ContactUsForm">
        <PropertyColumn Property="contactusform => contactusform.Name" />
        <PropertyColumn Property="contactusform => contactusform.Email" />
        <PropertyColumn Property="contactusform => contactusform.Subject" />
        <PropertyColumn Property="contactusform => contactusform.Message" />
        <PropertyColumn Property="contactusform => contactusform.ReceivedAt" />

        <TemplateColumn Context="contactusform">
            <a href="@($"contactusforms/edit?id={contactusform.Id}")">Edit</a> |
            <a href="@($"contactusforms/details?id={contactusform.Id}")">Details</a> |
            <a href="@($"contactusforms/delete?id={contactusform.Id}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
</div>


@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
