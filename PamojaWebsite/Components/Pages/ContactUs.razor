@page "/contact-us"

<PageTitle>Contact Us | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
<script>
    function loadGA() {
      if (window.gaLoaded) return;
      window.gaLoaded = true;

      var script = document.createElement('script');
      script.src = "https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG";
      script.async = true;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'pamojasafeguardingnetwork.co.uk', 'anonymize_ip': true});
    }

    // Fire when browser is idle or after first interaction
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => setTimeout(loadGA, 2000));
    } else {
      setTimeout(loadGA, 3000);
    }
</script>

@using System.Linq.Expressions
@using System;
@using System.ComponentModel.DataAnnotations;
@implements IDisposable

@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject IStringLocalizer<SharedResource> Loc
@inject EmailService EmailSender
@inject IJSRuntime JS

@rendermode InteractiveServer
<div class="sm:pt-[10%] md:pt-[4%] mb-5 py-20">
    <!-- Hero Section -->
    <section class="relative py-20 mt-5 bg-green-900 text-white py-2 px-4 sm:px-6 lg:px-8 overflow-hidden">
        <div class="absolute inset-0">
            <img loading="lazy" alt="Banner image" class="relative object-cover object-top md:h-64 md:w-full sm:h-full" src="https://res.cloudinary.com/dzmfpxcwu/image/upload/v1771133161/tree_mullks.jpg" />
        </div>

        <!-- Content -->
        <div class="relative max-w-7xl mx-auto">
            <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
                <h1 class="text-4xl mt-5 md:text-5xl font-bold mb-2">Contact Us</h1>
            </div>
        </div>
    </section>

    <div class="container mx-auto px-4 py-20">
        <!-- Hero Section -->
        <section class="bg-green-900 text-white rounded-xl p-8 mb-12">
            <div class="max-w-4xl mx-auto text-center">
                <h1 class="text-4xl md:text-5xl font-bold mb-4">Get in Touch with Us</h1>
                <p class="text-xl mb-8">We're here to help with all your mental wellbeing & safeguarding needs.</p>
                <div class="flex flex-wrap justify-center gap-4">
                    @* <a href="tel:+447881 918234" aria-label="Call us" class="flex items-center gap-2 bg-white text-green-900 px-6 py-3 rounded-full font-medium hover:bg-blue-50 transition">
                        <i data-feather="phone"></i> +447881 918234
                    </a> *@
                    <a href="mailto:pamojamentalhealth@pamojasafeguarding.com" aria-label="Email us" class="flex min-w-0 items-center gap-2 bg-white text-green-900 px-6 py-3 rounded-full font-medium hover:bg-blue-50 transition">
                        <i data-feather="mail"></i> <div class="truncate">pamojamentalhealth@pamojasafeguarding.com</div>
                    </a>
                </div>
            </div>
        </section>

        <!-- Contact Form and Info -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
            <!-- Contact Form -->
            <div class="bg-white p-8 rounded-xl shadow-lg">
                <!--Notification-->
                @if (FormSubmitted)
                {
                    <div class="mt-2 mb-2 max-w-[1200px] text-green-900 border-l-4 border-green-900 bg-green-100">
                        <div class="p-4 flex items-center space-x-2">
                            <img fetchpriority="high"
                                 loading="eager" src="icons/info-circle.svg" alt="Info circle icon" class="w-5 h-5" />
                            <span>Form submitted successfully</span>
                        </div>
                    </div>
                }
                <h2 class="text-2xl font-bold mb-6 text-green-900">Send us a Message</h2>
                <EditForm Model="contactFormDTO" OnValidSubmit="RequestInformation" OnInvalidSubmit="HandleInvalidSubmit" FormName="create" Enhance class="space-y-6">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-sm text-red-600" />

                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Your Name</label>
                        <InputText id="name" @bind-Value="contactFormDTO.Name"
                                   class="@InputClass(() => contactFormDTO.Name)" />
                        <ValidationMessage For="@(() => contactFormDTO.Name)" class="text-sm text-red-600 mt-1" />
                    </div>

                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                        <InputText id="email" type="email" @bind-Value="contactFormDTO.Email"
                                   class="@InputClass(() => contactFormDTO.Email)" />
                        <ValidationMessage For="@(() => contactFormDTO.Email)" class="text-sm text-red-600 mt-1" />
                    </div>

                    <div>
                        <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
                        <InputText id="subject" type="tel" @bind-Value="contactFormDTO.Subject"
                                   class="@InputClass(() => contactFormDTO.Subject)" />
                        <ValidationMessage For="@(() => contactFormDTO.Subject)" class="text-sm text-red-600 mt-1" />
                    </div>

                    <div>
                        <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
                        <InputTextArea id="message" rows="4" @bind-Value="contactFormDTO.Message"
                                       class="@($"{InputClass(() => contactFormDTO.Message)} h-28")" />
                        <ValidationMessage For="@(() => contactFormDTO.Message)" class="text-sm text-red-600 mt-1" />
                    </div>

                    <div>
                        <button type="submit"
                                class="w-full bg-green-800 hover:bg-green-900 text-white font-medium py-3 px-6 rounded-lg transition duration-300">
                            Submit Message
                        </button>
                    </div>
                </EditForm>
            </div>

            <!-- Contact Info -->
            <div class="space-y-8">
                <div class="bg-white p-8 rounded-xl shadow-lg">
                    <h2 class="text-2xl font-bold mb-6 text-green-900">Pamoja Counselling, Mental Wellbeing and Safeguarding Services</h2>
                    <div class="space-y-4">
                        <div class="flex items-start gap-4">
                            <i data-feather="map-pin" class="text-green-800 mt-1"></i>
                            <div>
                                <h3 class="font-medium text-gray-800">Address</h3>
                                <p class="text-gray-600">
                                    Unit 3, Office A, 1st Floor, 6-7 St Mary At Hill

                                    London, EC3R 8EE, England
                                </p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <i data-feather="mail" class="text-green-800 mt-1"></i>
                            <div class="min-w-0">
                                <h3 class="font-medium text-gray-800">Email</h3>
                                <p class="text-gray-600 break-words">pamojamentalhealth@pamojasafeguardingnetwork.com</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Social Media -->
                <div class="bg-white p-8 rounded-xl shadow-lg">
                    <h2 class="text-2xl font-bold mb-6 text-green-900">Connect With Us</h2>
                    <div class="flex gap-4">
                        <a href="https://www.facebook.com/PamojaSafeguard/" aria-label="Visit our Facebook profile" class="bg-gray-100 text-green-900 p-3 rounded-full hover:bg-gray-200 transition">
                            <i data-feather="facebook"></i>
                        </a>
                        <a href="https://x.com/PamojaSafeguard" aria-label="Visit our X account" class="bg-gray-100 text-green-900 p-3 rounded-full hover:bg-gray-200 transition">
                            <img fetchpriority="high"
                                 loading="eager" src="Icons/twitter-x-green.svg" alt="X icon" class="w-6 h-6" />
                        </a>
                        <a href="https://www.instagram.com/pamoja_safeguarding/"aria-label="Visit our Instagram account" class="bg-gray-100 text-green-900 p-3 rounded-full hover:bg-gray-200 transition">
                            <i data-feather="instagram"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private ContactFormDTO contactFormDTO { get; set; } = new();

    private EditContext editContext;

    private bool FormSubmitted { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("featherInit");
        }
    }
    private async Task ScrollToTarget()
    {
        await JS.InvokeVoidAsync("scrollToSection", "contact");
    }
    private async Task RequestInformation()
    {
        ContactUsForm contactUs = new ContactUsForm();
        contactUs.Name = contactFormDTO.Name;
        contactUs.Email = contactFormDTO.Email;
        contactUs.Subject = contactFormDTO.Subject;
        contactUs.Message = contactFormDTO.Message;

        using var context = DbFactory.CreateDbContext();
        context.ContactUsForm.Add(contactUs);
        await context.SaveChangesAsync();

        contactFormDTO.Name = "";
        contactFormDTO.Subject = "";
        contactFormDTO.Email = "";
        contactFormDTO.Message = "";

        FormSubmitted = true;
        StateHasChanged();

        await EmailSender.SendContactRequestEmailAsync(contactUs);
    }
    private void HandleInvalidSubmit()
    {
        // Optionally focus first invalid field or show a message
    }

    // Helper to compute Tailwind classes and add red border when field has errors
    private string InputClass<T>(Expression<Func<T>> accessor)
    {
        var baseClasses = "w-full px-4 py-2 border rounded-md focus:ring-primary-500 focus:border-primary-500";
        return HasValidationError(accessor)
            ? $"{baseClasses} border-red-500 focus:border-red-500"
            : $"{baseClasses} border-gray-300";
    }

    private bool HasValidationError<T>(Expression<Func<T>> accessor)
    {
        if (editContext == null) return false;
        var field = FieldIdentifier.Create(accessor);
        return editContext.GetValidationMessages(field).Any();
    }

    public void Dispose()
    {
        if (editContext != null)
            editContext.OnFieldChanged -= (_, __) => StateHasChanged();
    }
    public class ContactFormDTO
    {

        [Required(ErrorMessage = "Name is required")]
        [StringLength(100, ErrorMessage = "Name must be 100 characters or fewer")]
        public string Name { get; set; }

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Enter a valid email address")]
        public string Email { get; set; }

        [Required(ErrorMessage = "Subject is required")]
        [StringLength(200, ErrorMessage = "Subject is too long")]
        public string Subject { get; set; }

        [Required(ErrorMessage = "Message is required")]
        [StringLength(2000, ErrorMessage = "Message is too long")]
        public string Message { get; set; }
    }
}