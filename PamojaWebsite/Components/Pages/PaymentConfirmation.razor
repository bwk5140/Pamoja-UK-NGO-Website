@page "/payment-confirmation"
@using Azure.Identity
@using Azure.Security.KeyVault.Secrets
@using MailKit.Net.Smtp
@using Microsoft.JSInterop
@using System.Linq.Expressions
@using System.ComponentModel.DataAnnotations
@using MimeKit
@using System.Security.Cryptography.X509Certificates

@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS
@inject IMemoryCache Cache
@inject MyApiService ApiService
@inject IHttpClientFactory ClientFactory
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IMemoryCache Cache
@inject ApplicationUserService ApplicationUserService

<PageTitle>Payment-Confirmation | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
<script>
    function loadGA() {
      if (window.gaLoaded) return;
      window.gaLoaded = true;

      var script = document.createElement('script');
      script.src = "https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG";
      script.async = true;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'pamojasafeguardingnetwork.co.uk', 'anonymize_ip': true});
    }

    // Fire when browser is idle or after first interaction
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => setTimeout(loadGA, 2000));
    } else {
      setTimeout(loadGA, 3000);
    }
</script>

@rendermode InteractiveServer
<div class="sm:pt-[10%] md:pt-[4%] mb-5 py-20">
    <div class="max-w-screen-sm mx-auto py-20">
        <div class="mt-5 text-center text-gray-600">
            <div class="mx-auto px-4">
                <div class="max-w-3xl mx-auto bg-white rounded-xl shadow-lg">
                    <!-- Header -->
                    <div class="px-4 py-2 border-b">
                        <strong>Appointment Confirmation</strong>
                    </div>

                    <!-- Body -->
                    <div class="p-4">
                        <div class="mt-2 mb-2 max-w-[1200px] border-l-8 border-r-2 border-t-2 border-b-2 border-green-600 bg-white rounded">
                            <div class="p-2 flex flex-col items-center gap-16">
                                <img fetchpriority="high"
                                     loading="eager" src="Icons/check-circle-fill.svg" alt="Info check circle icon" />
                                <span>Your payment was successful.</span>
                                <p>Thank you! Confirmation will be sent to your email.</p>

                                <!-- Appointment Details Card -->
                                <div class="bg-white p-6 rounded-lg shadow-md">
                                    <h1 class="text-lg font-bold text-center text-gray-800 mt-4 mb-4">
                                        Appointment Details
                                    </h1>

                                    <div class="bg-white p-6 rounded-lg shadow-md w-88">
                                        <div class="flex flex-col md:flex-row gap-8 justify-between">
                                            <!-- Logo -->
                                            <div class="mb-3 mt-3">
                                                <img fetchpriority="high"
                                                     loading="eager" src="Images/PamojaLogo.png"
                                                     width="200"
                                                     height="200"
                                                     alt="Pamoja logo" />
                                            </div>

                                            <!-- Appointment Info -->
                                            <div class="mb-3 mt-3">
                                                <p class="font-bold text-lg text-gray-800 mb-6">
                                                    Consultation with Pamoja Mental Health and Safeguarding Team
                                                </p>
                                                <p class="text-lg text-gray-600 mb-6">
                                                    20 minutes
                                                </p>

                                                @if (appointment is not null)
                                                {
                                                    <div class="flex flex-col">
                                                        <p class="font-bold text-lg text-gray-800 mb-3">
                                                            @appointment.Date.ToLocalTime().ToString("MMMM dd, yyyy") at @appointment.Time.ToString("hh:mm tt")
                                                        </p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- End Appointment Details Card -->

                            </div>
                        </div>
                    </div>
                    <!-- End Body -->

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    [SupplyParameterFromQuery]
    private string? AptId { get; set; }

    private string? id;
    private bool EmailSent { get; set; } = false;

    [Parameter]
    public Payment? payment { get; set; }

    [Parameter]
    public Appointment? appointment { get; set; }

    [Parameter]
    public string? Month { get; set; }


    Dictionary<string, string> CurrencySymbols = new()
            {
                { "USD", "$" },
                { "EUR", "€" },
                { "GBP", "£" },
                { "JPY", "¥" },
                { "CAD", "C$" },
                { "AUD", "A$" },
                { "KES", "KSh" }
            };

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var payments = await context.Payment.ToListAsync();
        if (payments is not null)
        {
            payment = payments.FirstOrDefault(d => d.Id == Id);
        }
        if (payment is null)
        {
            NavigationManager.NavigateTo("not-found");
        }
        var appointments = await context.Appointment.ToListAsync();
        if (appointments is not null){
            appointment = appointments.FirstOrDefault(a => a.Id == AptId);
        }

        if (appointment is null)
        {
            NavigationManager.NavigateTo("not-found");
        }
    }
    private string getMonth(int month)
    {
        switch (month)
        {
            case 1:
                Month = "January";
                break;
            case 2:
                Month = "February";
                break;
            case 3:
                Month = "March";
                break;
            case 4:
                Month = "April";
                break;
            case 5:
                Month = "May";
                break;
            case 6:
                Month = "June";
                break;
            case 7:
                Month = "July";
                break;
            case 8:
                Month = "August";
                break;
            case 9:
                Month = "September";
                break;
            case 10:
                Month = "October";
                break;
            case 11:
                Month = "November";
                break;
            case 12:
                Month = "December";
                break;
        }
        return Month;
    }
}
