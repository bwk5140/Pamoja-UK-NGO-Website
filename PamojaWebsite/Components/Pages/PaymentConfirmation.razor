                                    <div class="bg-white p-6 rounded-lg shadow-md w-88">
                                        <div class="flex flex-col md:flex-row gap-8 justify-between">
                                            <div class="md:w-3/4 flex flex-row md:flex-col gap-8">
                                                <div class="mb-3 mt-3">
                                                    <img src="Images/PamojaLogo.png"
                                                         width="200"
                                                         height="200" />
                                                </div>
                                                <div class="mb-3 mt-3">
                                                    <p class="font-bold text-lg text-gray-800 mb-6">
                                                        Consultation with Pamoja Mental Health and Safeguarding Team
                                                    </p>
                                                    <p class="text-lg text-gray-600 mb-6">
                                                        1 hour
                                                    </p>
                                                    @if (appointment is not null)
                                                    {
                                                        <div class="flex flex-col">
                                                            <p class="font-bold text-lg text-gray-800 mb-3">
                                                                @appointment.Date.DayOfWeek, @getMonth(appointment.Date.Month) @appointment.Date.Day at @appointment.Time.ToString("hh:mm tt")
                                                            </p>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    [SupplyParameterFromQuery]
    private string? AptId { get; set; }

    private readonly string smtpServer = "smtp.gmail.com";
    private readonly int smtpPort = 587;
    private string? id;
    private bool EmailSent { get; set; } = false;

    [Parameter]
    public Payment? payment { get; set; }

    [Parameter]
    public Appointment? appointment { get; set; }

    [Parameter]
    public string? Month { get; set; }


    Dictionary<string, string> CurrencySymbols = new()
            {
                { "USD", "$" },
                { "EUR", "€" },
                { "GBP", "£" },
                { "JPY", "¥" },
                { "CAD", "C$" },
                { "AUD", "A$" },
                { "KES", "KSh" }
            };

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var payments = await (await ApiService.GetClient()).GetFromJsonAsync<List<Payment>>("api/db/payments");
        payment = payments.FirstOrDefault(d => d.Id == Id);
        if (payment is null)
        {
            NavigationManager.NavigateTo("not-found");
        }
        var appointments = await (await ApiService.GetClient()).GetFromJsonAsync<List<Appointment>>("api/db/appointments");
        if (appointment is not null){
            appointment = appointments.FirstOrDefault(a => a.Id == AptId);
        }
        
        if (appointment is null)
        {
            NavigationManager.NavigateTo("not-found");
        }
    }
