@page "/relateddocuments/edit"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Edit</h1>

    <h2>RelatedDocument</h2>
    <hr />
    @if (RelatedDocument is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="row">
            <div class="col-md-4">
                <EditForm method="post" Model="RelatedDocument" OnValidSubmit="UpdateRelatedDocument" FormName="edit" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary role="alert" />
                    <input type="hidden" name="RelatedDocument.Id" value="@RelatedDocument.Id" />
                    <div class="mb-3">
                        <label for="title" class="form-label">Title:</label>
                        <InputText id="title" @bind-Value="RelatedDocument.Title" class="form-control" />
                        <ValidationMessage For="() => RelatedDocument.Title" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="lastupdated" class="form-label">LastUpdated:</label>
                        <InputDate id="lastupdated" @bind-Value="RelatedDocument.LastUpdated" class="form-control" />
                        <ValidationMessage For="() => RelatedDocument.LastUpdated" class="text-danger" />
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </EditForm>
            </div>
        </div>
    }

    <div>
        <a href="/relateddocuments">Back to List</a>
    </div>
</div>


@code {
    [SupplyParameterFromQuery]
    private string Id { get; set; }

    [SupplyParameterFromForm]
    private RelatedDocument? RelatedDocument { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        RelatedDocument ??= await context.RelatedDocument.FirstOrDefaultAsync(m => m.Id == Id);

        if (RelatedDocument is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateRelatedDocument()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(RelatedDocument!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!RelatedDocumentExists(RelatedDocument!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/relateddocuments");
    }

    private bool RelatedDocumentExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.RelatedDocument.Any(e => e.Id == id);
    }
}
