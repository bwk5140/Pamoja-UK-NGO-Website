@page "/relateddocuments/details"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Details</h1>

    <div>
        <h2>RelatedDocument</h2>
        <hr />
        @if (relateddocument is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Title</dt>
                <dd class="col-sm-10">@relateddocument.Title</dd>
                <dt class="col-sm-2">LastUpdated</dt>
                <dd class="col-sm-10">@relateddocument.LastUpdated</dd>
            </dl>
            <div>
                <a href="@($"/relateddocuments/edit?id={relateddocument.Id}")">Edit</a> |
                <a href="@($"/relateddocuments")">Back to List</a>
            </div>
        }
    </div>
</div>


@code {
    private RelatedDocument? relateddocument;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        relateddocument = await context.RelatedDocument.FirstOrDefaultAsync(m => m.Id == Id);

        if (relateddocument is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
