@page "/relateddocuments/delete"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Delete</h1>

    <p>Are you sure you want to delete this?</p>
    <div>
        <h2>RelatedDocument</h2>
        <hr />
        @if (relateddocument is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Title</dt>
                <dd class="col-sm-10">@relateddocument.Title</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">LastUpdated</dt>
                <dd class="col-sm-10">@relateddocument.LastUpdated</dd>
            </dl>
            <EditForm method="post" Model="relateddocument" OnValidSubmit="DeleteRelatedDocument" FormName="delete" Enhance>
                <button type="submit" class="btn btn-danger" disabled="@(relateddocument is null)">Delete</button> |
                <a href="/relateddocuments">Back to List</a>
            </EditForm>
        }
    </div>
</div>


@code {
    private RelatedDocument? relateddocument;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        relateddocument = await context.RelatedDocument.FirstOrDefaultAsync(m => m.Id == Id);

        if (relateddocument is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteRelatedDocument()
    {
        using var context = DbFactory.CreateDbContext();
        context.RelatedDocument.Remove(relateddocument!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/relateddocuments");
    }
}
