                                Caroline Nduta
                            </a>
                            <p class="text-black mt-2">Head of Operations and Compliance</p>
                        </div>
                        <!-- Brian Karimi -->
                        <div class="ms-2">
                            <a href="/about-us/brian-karimi" aria-label="View Brian Karimi's bio"
                               class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Brian Karimi
                            </a>
                            <p class="text-black mt-2">IT Support Specialist</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Boards Section -->
    <section class="py-20 bg-white">
        <div class="container mx-auto px-6">
            <div class="max-w-4xl mx-auto">
                <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-12">Meet The Board</h2>
                
                <div class="max-w-4xl mt-5 mx-auto bg-gray-100 text-white p-6">
                    <!-- Top horizontal rule -->
                    <hr class="border-t-2 border-blue-800 my-4" />

                    <!-- Grid for names + titles -->
                    <div class="grid grid-cols-2 gap-x-9 gap-y-6">
                        <!-- Irene Karimi -->
                        <div class="ms-2">
                            <a aria-label="View Irene Karimi's bio" href="/about-us/irene-Karimi" class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Irene Karimi
                            </a>
