                        </div>
                    </div>
                </div>
                <div class="max-w-4xl mt-5 mx-auto bg-gray-100 text-white p-6">
                    <h2 class="text-3xl md:text-xl font-bold text-gray-800">United Kingdom</h2>
                    <!-- Top horizontal rule -->
                    <hr class="border-t-2 border-blue-800 my-4" />

                    <!-- Grid for names + titles -->
                    <div class="grid grid-cols-2 gap-x-9 gap-y-6">
                        <!-- Claire Fuller -->
                        <div class="ms-2">
                            <a href="/about-us/claire-fuller"
                               class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Claire Fuller
                            </a>
                            <p class="text-black mt-2">Head of Therapies & Wellbeing</p>
                        </div>
                    </div>
                </div>
                <div class="max-w-4xl mt-5 mx-auto p-6">
                    <div class="flex justify-end mt-12">
                        <p class="text-s text-secondary">
                            Interested in joining the team? Find out more.
                        </p>
                    </div>
                    <div class="flex justify-end mt-2">
                        <a href="/careers"
                           class="bg-green-700 hover:bg-green-800 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition">
                            Careers
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>


