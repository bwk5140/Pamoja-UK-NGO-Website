        <div class="container mx-auto px-6">
            <div class="max-w-4xl mx-auto">
                <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-12">Meet The Pamoja Team</h2>
                <div class="max-w-4xl mx-auto bg-gray-100 text-white p-6">
                    <!-- Top green horizontal rule -->
                    <hr class="border-t-2 border-blue-800 my-4" />
                    <!-- Faith Mbula -->
                    <a href="/about-us/faith-mbula" class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                        Faith Mbula
                    </a>
                    <p class="text-black mt-3 mb-2">Chief Executive Officer</p>
                    
                    <!-- Bottom green horizontal rule -->
                    <hr class="border-t-2 border-blue-800 my-4" />
                </div>
                <div class="max-w-4xl mt-5 mx-auto bg-gray-100 text-white p-6">
                    <h2 class="text-3xl md:text-xl font-bold text-gray-800">Kenya</h2>
                    <!-- Top horizontal rule -->
                    <hr class="border-t-2 border-blue-800 my-4" />

                    <!-- Grid for names + titles -->
                    <div class="grid grid-cols-2 gap-x-9 gap-y-6">
                        <!-- Claire Fuller -->
                        <div class="ms-2">
                            <a href="/about-us/claire-fuller"
                               class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Claire Fuller
                            </a>
                            <p class="text-black mt-2">Head of Therapies & Wellbeing</p>
                        </div>
                        <!-- Raphael Imanyara -->
                        <div class="ms-2">
                            <a href="/about-us/raphael-imanyara"
                               class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Raphael Imanyara
                            </a>
                            <p class="text-black mt-2">Head of HR and Operations</p>
                        </div>

                        <!-- Brian Mahinda -->
                        <div class="ms-2">
                            <a href="/about-us/brian-mahinda"
                               class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Brian Mahinda
                            </a>
                            <p class="text-black mt-2">Head of Strategy and Communication</p>
                        </div>
                        <!-- Caroline Nduta -->
                        <div class="ms-2">
                            <a href="/about-us/caroline-nduta"
                               class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Caroline Nduta
                            </a>
                            <p class="text-black mt-2">Head of Operations and Compliance</p>
                        </div>
                        <!-- Brian Karimi -->
                        <div class="ms-2">
                            <a href="/about-us/brian-karimi"
                               class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Brian Karimi
                            </a>
