                    <!-- Top horizontal rule -->
                    <hr class="border-t-2 border-blue-800 my-4" />

                    <!-- Grid for names + titles -->
                    <div class="grid grid-cols-2 gap-x-9 gap-y-6">
                        <!-- Faith Mbula -->
                        <div class="ms-2">
                            <a aria-label="View Faith Mbula's bio" href="/about-us/faith-mbula" class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Faith Mbula
                            </a>
                            <p class="text-black mt-3 mb-2">CEO, Counsellor, Mental Health Nurse & Safeguarding Specialist</p>
                        </div>
                        <!-- Rony Okoth -->
                        <div class="ms-2">
                            <a href="/about-us/rony-okoth" aria-label="View Rony Okoth Ochieng's bio"
                               class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Rony Okoth Ochieng
                            </a>
                            <p class="text-black mt-2">Psychologist</p>
                        </div>
                        <!-- Benjamin Wafula -->
                        <div class="ms-2">
                            <a href="/about-us/benjamin-wafula" aria-label="View Benjamin Sifuna Wafula's bio"
                               class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Benjamin Sifuna Wafula
                            </a>
                            <p class="text-black mt-2">Occupational Therapist</p>
                        </div>
                        <!-- Billy Mukabana -->
                        <div class="ms-2">
                            <a href="/about-us/billy-mukabana" aria-label="View Billy Mukabana's bio"
                               class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Billy Mukabana
                            </a>
                            <p class="text-black mt-2">Researcher</p>
                        </div>
                        <!-- Bank of Therapists -->
                        <div class="ms-2">
                            <a href="/about-us/associate-clinicians" aria-label="View Associate Clinicians' bio"
                               class="border-b border-green-700 hover:border-green-800 text-no-wrap pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Associate Clinicians
                            </a>
                        </div>
                    </div>
                </div>
                <div class="max-w-4xl mt-5 mx-auto bg-gray-100 text-white p-6">
                    <!-- Top horizontal rule -->
                    <hr class="border-t-2 border-blue-800 my-4" />
                    <!-- Grid for names + titles -->
                    <div class="grid grid-cols-2 gap-x-9 gap-y-6">
                        <!-- Caroline Nduta -->
                        <div class="ms-2">
                            <a href="/about-us/caroline-nduta" aria-label="View Caroline Nduta's bio"
