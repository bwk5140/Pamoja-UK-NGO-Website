                                Wanja Mbuthia
                            </a>
                            <p class="text-black mt-2">Board Member</p>
                        </div>
                        <!-- Nadine Dennis -->
                        <div class="ms-2">
                            <a href="/about-us/nadine-dennis" aria-label="View Nadine Dennis's bio"
                               class="border-b border-green-700 hover:border-green-800 pb-1 mb-2 font-semibold text-green-700 hover:text-green-800">
                                Nadine Dennis
                            </a>
