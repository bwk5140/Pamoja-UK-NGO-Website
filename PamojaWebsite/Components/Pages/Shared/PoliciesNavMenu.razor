@using Microsoft.AspNetCore.Identity
@using PamojaWebsite.Data

@inject IStringLocalizer<SharedResource> Loc

<div class="sm:pt-[10%] md:pt-[5%] py-20">
    <div class="bg-white p-4 rounded shadow border border-gray-200 py-10">
        <ul class="bg-white flex flex-col space-y-2">
            <li>
                <NavLink href="privacy-policy" Match="NavLinkMatch.All"
                         class="block px-4 py-2 rounded-md hover:bg-blue-100 hover:text-blue-700"
                         activeClass="bg-green-800 text-white">
                    @Loc["PrivacyPolicy"]
                </NavLink>
            </li>
            <li>
                <NavLink href="accessibility-statement"
                         class="block px-4 py-2 rounded-md hover:bg-blue-100 hover:text-blue-700"
                         activeClass="bg-green-800 text-white">
                    @Loc["AccessibilityStatement"]
                </NavLink>
            </li>
            <li>
                <NavLink href="terms-of-use"
                         class="block px-4 py-2 rounded-md hover:bg-blue-100 hover:text-blue-700"
                         activeClass="bg-green-800 text-white">
                    @Loc["TermsofUse"]
                </NavLink>
            </li>
        </ul>
    </div>
</div>