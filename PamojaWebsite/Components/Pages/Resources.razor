    public async Task FilterDocs(string filter)
    {
        DocFilter = filter;
        using var context = await DbFactory.CreateDbContextAsync();
        if (!filter.Equals("All") && !filter.Equals("View All"))
        {
            Documents = await context.Document.OrderByDescending(b => b.Date).ToListAsync();
            var regexPattern = ".*" + Regex.Escape(filter.ToLower()) + ".*";

            Documents = Documents
                .Where(d =>
                    d.ContentType != null &&
                    Regex.IsMatch(GetShortExtension(d.ContentType).ToLowerInvariant(), regexPattern, RegexOptions.IgnoreCase)
                )
                .ToList();
        }
        else
        {
            Documents = await context.Document.OrderByDescending(b => b.Date).ToListAsync();
        }
        StateHasChanged();
    }
