    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        // Get the first selected file
        ImageFile = e.File;

        // Limit size (e.g. 5 MB) to avoid exceptions
        var maxSize = 5 * 1024 * 1024;
        if (ImageFile.Size > maxSize)
        {
            ProblemWBlogImage = true;
        }
        else if (GetShortImageExtension(ImageFile.ContentType) == "unknown")
        {
            ProblemWBlogImage = true;
            UnsupportedImage = true;
        }
        else
        {
            using var stream = ImageFile.OpenReadStream(maxSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            // Store raw bytes in BlogPost.PreviewImage
            blogPostDTO.Image = ms.ToArray();

            blogPostDTO.ImageContentType = ImageFile.ContentType;

            blogPost.PreviewImage = blogPostDTO.Image;
            blogPost.PreviewImageContentType = blogPostDTO.ImageContentType;
        }
        StateHasChanged();
    }
    public static string GetTimeAgo(DateTime dateTime)
    {
        TimeSpan timeSpan = DateTime.UtcNow - dateTime;

        if (timeSpan <= TimeSpan.FromSeconds(60))
            return $"{timeSpan.Seconds} seconds ago";

        if (timeSpan <= TimeSpan.FromMinutes(60))
            return timeSpan.Minutes > 1 ? $"{timeSpan.Minutes} minutes ago" : "1 minute ago";

        if (timeSpan <= TimeSpan.FromHours(24))
            return timeSpan.Hours > 1 ? $"{timeSpan.Hours} hours ago" : "1 hour ago";

        if (timeSpan <= TimeSpan.FromDays(30))
            return timeSpan.Days > 1 ? $"{timeSpan.Days} days ago" : "yesterday";

        if (timeSpan <= TimeSpan.FromDays(365))
            return timeSpan.Days > 30 ? $"{timeSpan.Days / 30} months ago" : "1 month ago";

        return timeSpan.Days > 365 ? $"{timeSpan.Days / 365} years ago" : "1 year ago";
    }
    private async Task ApplyFormat(string prefix, string suffix)
    {
        // Get selection info from JS
        var selection = await JS.InvokeAsync<SelectionInfo>("getSelection", "editor");

        if (selection != null)
        {
            var before = blogPostDTO.Content.Substring(0, selection.Start);
            var selected = blogPostDTO.Content.Substring(selection.Start, selection.Length);
            var after = blogPostDTO.Content.Substring(selection.End);

            blogPostDTO.Content = before + prefix + selected + suffix + after;
            StateHasChanged();
        }
    }
