    private async Task GetNavClass(string page, string searchTerm)
    {
        var uri = new Uri(NavigationManager.Uri);
        var path = uri.AbsolutePath.ToLowerInvariant();
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        NavClasses[searchTerm] = path == page.ToLowerInvariant() &&
               query["RedirectQuery"]?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true
            ? "font-medium border-b-2 border-green-900 hover:text-green-900"
            : "font-medium hover:text-green-900";
        foreach(var kvp in NavClasses)
        {
            if (kvp.Key != searchTerm)
            {
                NavClasses[kvp.Key] = "font-medium hover:text-green-900";
            }
        }
        StateHasChanged();
    }
