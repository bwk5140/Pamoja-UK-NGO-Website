    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        File = e.File; // Get the single file
        long maxFileSize = 1024 * 1024 * 50; // 5MB limit

        if (File.Size > maxFileSize)
        {
            ProblemWDocument = true;
        }
        else if (GetShortExtension(File.ContentType) == "unknown")
        {
            ProblemWDocument = true;
            UnsupportedDocument = true;
        }
        else
        {
            using var stream = File.OpenReadStream(maxFileSize);

            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            document.Data = ms.ToArray();
            fileUploadDTO.Data = document.Data;
            fileUploadDTO.Metadata = new DocumentMetadata();
            document.Metadata = fileUploadDTO.Metadata;

            if (File.ContentType.Contains("application/vnd.openxmlformats-officedocument.wordprocessingml.document") ||
            File.ContentType.Contains("application/msword"))
            {
                var tempPath = "wwwroot/Data";
                using var fs = new FileStream(tempPath, FileMode.Create);
                await stream.CopyToAsync(fs);

                int pageCount = GetWordPageCount(tempPath);
                fileUploadDTO.Metadata.PageCount = pageCount;
                document.Metadata.PageCount = pageCount;
            }
            else if (File.ContentType == "application/pdf")
            {
                int pageCount = await GetPdfPageCountAsync(ms);
                fileUploadDTO.Metadata.PageCount = pageCount;
                document.Metadata.PageCount = pageCount;
            }
            else if (File.ContentType == "text/plain")
            {
                fileUploadDTO.Metadata.PageCount = 1;
                document.Metadata.PageCount = 1;
            }
            else if (File.ContentType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" ||
             File.ContentType == "application/vnd.ms-excel")
            {
                int pageCount = await GetSheetCountAsync(ms);
                fileUploadDTO.Metadata.PageCount = pageCount;
                document.Metadata.PageCount = pageCount;
            }
            else if (File.ContentType == "application/vnd.openxmlformats-officedocument.presentationml.presentation")
            {
                int pageCount = await GetSlideCountAsync(ms);
                fileUploadDTO.Metadata.PageCount = pageCount;
                document.Metadata.PageCount = pageCount;
            }

            document.Size = File.Size;
            document.Downloads = 0;
            document.ContentType = File.ContentType;
        }

    }
    private async Task<int> GetPdfPageCountAsync(MemoryStream stream)
    {
        stream.Position = 0; // reset to beginning

        using var reader = new iTextSharp.text.pdf.PdfReader(stream);
        return reader.NumberOfPages;
    }

    public int GetWordPageCount(string filePath)
    {
        var wordApp = new Word.Application();
        var doc = wordApp.Documents.Open(filePath);

        if (doc is not null){
            int pageCount = doc.ComputeStatistics(Word.WdStatistic.wdStatisticPages);
            doc.Close();
            wordApp.Quit();
            return pageCount;
        }
        else{
            return 0;
        }
    }
    public async Task<int> GetSheetCountAsync(MemoryStream stream)
    {
        stream.Position = 0; // reset to beginning

        using var package = new ExcelPackage(stream);
        return package.Workbook.Worksheets.Count;
    }
    public async Task<int> GetSlideCountAsync(MemoryStream stream)
    {
        stream.Position = 0;

        using var presentationDoc = PresentationDocument.Open(stream, false);
        var slideCount = presentationDoc.PresentationPart.SlideParts.Count();

        return slideCount;
    }

