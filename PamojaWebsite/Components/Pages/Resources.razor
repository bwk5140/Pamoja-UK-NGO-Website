    public async Task Redirect()
    {
        RedirectQuery = RedirectQuery.Trim();
        using var context = await DbFactory.CreateDbContextAsync();

        if (RedirectQuery.Equals("All Resources"))
        {
            BlogPosts = await context.BlogPost.OrderByDescending(b => b.Date).ToListAsync();

            Documents = await context.Document.OrderByDescending(b => b.Date).ToListAsync();

        }
        else if (RedirectQuery.Equals("Blog Posts"))
        {
            BlogPosts = await context.BlogPost.OrderByDescending(b => b.Date).ToListAsync();

            if (Documents is not null && Documents.Any())
            {
                Documents.Clear();
            }
        }
        else if (RedirectQuery.Equals("My Uploads"))
        {
            BlogPosts = await context.BlogPost.OrderByDescending(b => b.Date).ToListAsync();
            var regexPattern = ".*" + Regex.Escape(User.Name.ToLower()) + ".*";
            if (!string.IsNullOrEmpty(User.Name))
            {
                BlogPosts = BlogPosts
                    .Where(bp =>
                        bp.Author != null &&
                        Regex.IsMatch(bp.Author.ToLowerInvariant(), regexPattern, RegexOptions.IgnoreCase)
                    )
                    .ToList();
            }
            Documents = await context.Document.OrderByDescending(b => b.Date).ToListAsync();
            if (!string.IsNullOrEmpty(User.Name))
            {
                Documents = Documents
                    .Where(d =>
                        d.ContentType != null &&
                        Regex.IsMatch(d.UploadedBy.ToLowerInvariant(), regexPattern, RegexOptions.IgnoreCase)
                    )
                    .ToList();
            }
        }
        else
        {
            BlogPosts = await context.BlogPost.OrderByDescending(b => b.Date).ToListAsync();
            var regexPattern = ".*" + Regex.Escape(RedirectQuery.ToLower()) + ".*";

            if (!string.IsNullOrEmpty(regexPattern))
            {
                BlogPosts = BlogPosts
                    .Where(bp =>
                string.IsNullOrEmpty(RedirectQuery) ||
                (bp.Category != null && Regex.IsMatch(bp.Category.ToLowerInvariant(), regexPattern, RegexOptions.IgnoreCase) ||
                bp.Tags.Any(t => Regex.IsMatch(t.ToLowerInvariant(), regexPattern, RegexOptions.IgnoreCase)))
            )
            .ToList();

            }
            Documents = await context.Document.OrderByDescending(b => b.Date).ToListAsync();
            if (!string.IsNullOrEmpty(RedirectQuery))
            {
                Documents = Documents
                    .Where(d =>
                        string.IsNullOrEmpty(RedirectQuery) ||
                        (d.Category != null && Regex.IsMatch(d.Category.ToLowerInvariant(), regexPattern, RegexOptions.IgnoreCase))
                    )
                    .ToList();
            }
        }
        RedirectQuery = "";
        StateHasChanged();
    }
    public async Task Search()
    {
        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            SearchTerm = SearchTerm.Trim();
            using var context = await DbFactory.CreateDbContextAsync();
            BlogPosts = await context.BlogPost.OrderByDescending(b => b.Date).ToListAsync();
            var regexPattern = ".*" + Regex.Escape(SearchTerm.ToLower()) + ".*";

            if (!string.IsNullOrEmpty(SearchTerm))
            {
                BlogPosts = BlogPosts
                    .Where(bp =>
                        string.IsNullOrEmpty(SearchTerm) ||
                        (bp.Author != null && Regex.IsMatch(bp.Author.ToLowerInvariant(), regexPattern, RegexOptions.IgnoreCase)) ||
                        (bp.Title != null && Regex.IsMatch(bp.Title.ToLowerInvariant(), regexPattern, RegexOptions.IgnoreCase)) ||
                        (bp.Category != null && Regex.IsMatch(bp.Category.ToLowerInvariant(), regexPattern, RegexOptions.IgnoreCase)) ||
                        bp.Tags.Any(t => t != null && Regex.IsMatch(t.ToLowerInvariant(), regexPattern, RegexOptions.IgnoreCase))
                    )
                    .ToList();
            }

            Documents = await context.Document.OrderByDescending(b => b.Date).ToListAsync();
            if (!string.IsNullOrEmpty(SearchTerm))
            {
                Documents = Documents
                    .Where(d =>
                        string.IsNullOrEmpty(SearchTerm) ||
                        (d.Author != null && Regex.IsMatch(d.Author.ToLowerInvariant(), regexPattern, RegexOptions.IgnoreCase)) ||
                        (d.Title != null && Regex.IsMatch(d.Title.ToLowerInvariant(), regexPattern, RegexOptions.IgnoreCase)) ||
                        (d.Category != null && Regex.IsMatch(d.Category.ToLowerInvariant(), regexPattern, RegexOptions.IgnoreCase))
                    )
                    .ToList();
            }

            SearchTerm = "";
            StateHasChanged();
        }

    }
