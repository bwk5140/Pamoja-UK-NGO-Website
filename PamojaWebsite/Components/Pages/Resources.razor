@page "/resources"
@using System.Text
@using System.Threading.Tasks
@using PamojaWebsite.Data.Contexts
@using Markdig
@using Radzen.Blazor
@using System
@using System.Text.RegularExpressions;
@using Word = Microsoft.Office.Interop.Word;

<PageTitle>Resources | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'auto'});
</script>

@inject IJSRuntime JS
@inject MyApiService ApiService
@inject NavigationManager NavigationManager
@inject ApplicationUserService ApplicationUserService
@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

@implements IDisposable

@rendermode @(new InteractiveServerRenderMode(prerender: false))
<div class="pt-[5%] mb-5 py-20 mt-5">
    <div class="min-h-screen bg-gray-50 font-sans">
        <!-- Header & Navigation -->
        <header class="bg-white shadow-sm sticky top-0 z-50">
            <nav class="container mx-auto px-4 py-10">
                <div class="flex flex-col md:flex-row justify-between items-center gap-4 md:gap-32">
                    <div class="flex items-center space-x-2 mb-4 md:mb-0">
                        <div class="w-10 h-10 bg-green-900-900 rounded-lg flex items-center justify-center">
                            <i class="fas fa-book-open text-white text-xl"></i>
                        </div>
                        <h1 class="text-2xl font-bold text-dark">Resources</h1>
                    </div>

                    <div class="flex-1 max-w-12xl md:max-w-6xl mx-4">
                        <div class="relative">
                            <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>

                            <InputText @bind-Value="SearchTerm" @bind-Value:after="Search" type="text"
                                       id="searchInput"
                                       placeholder="Search..."
                                       class="w-full px-12 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-900 focus:border-transparent">
                            </InputText>

                            <button @onclick="Search" class="absolute right-2 top-1/2 transform -translate-y-1/2 bg-green-900 text-white px-4 py-1.5 rounded-md hover:bg-secondary transition">
                                Search
                            </button>
                        </div>
                    </div>
                </div>
                <div class="mt-4 nav-links flex flex-wrap justify-center space-x-6 text-gray-600">
                    @if (SearchFilters is not null && SearchFilters.Any())
                    {
                        <a href="/resources?RedirectQuery=All%20Resources" class="@NavClasses["All Resources"]" @onclick="(() => GetNavClass(page, SearchFilters[0]))">
                            All Resources
                        </a>
                        <a href="/resources?RedirectQuery=Research" class="@NavClasses["Research"]" @onclick="(() => GetNavClass(page, SearchFilters[1]))">
                            Research
                        </a>
                        <a href="/resources?RedirectQuery=Blog%20Posts" class="@NavClasses["Blog Posts"]" @onclick="(() => GetNavClass(page, SearchFilters[2]))">
                            Blog Posts
                        </a>
                        <a href="/resources?RedirectQuery=Case%20Studies" class="@NavClasses["Case Studies"]" @onclick="(() => GetNavClass(page, SearchFilters[3]))">
                            Case Studies
                        </a>
                        <a href="/resources?RedirectQuery=Templates" class="@NavClasses["Templates"]" @onclick="(() => GetNavClass(page, SearchFilters[4]))">
                            Templates
                        </a>

                        @if (User is not null)
                        {
                            var userName = User.Name;
                            <a href="resources?RedirectQuery=My%20Uploads" class="@NavClasses["My Uploads"]" @onclick="(() => GetNavClass(page, SearchFilters[5]))">
                                My Uploads
                            </a>
                        }
                    }
                </div>
            </nav>
        </header>

        <main class="container mx-auto px-4 py-8">
            <div class="flex flex-col lg:flex-row gap-8">
                <!-- Left Column: Document Upload & List -->
                <div class="lg:w-2/3">
                    <AuthorizeView>
                        <Authorized>
                            @if (Authorized){
                                <!-- Upload Section -->
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
                                <div class="flex items-center justify-between mb-6">
                                    <h2 class="text-xl font-bold text-dark">Upload Research Document</h2>
                                    <button @onclick="ShowSubmissionsGuideline" class="text-green-900 hover:text-secondary font-medium flex items-center space-x-2">
                                        <i class="fas fa-info-circle"></i>
                                        <span>Upload Guidelines</span>
                                    </button>
                                    <DocSubmissionGuidelines @ref="DocSubmissionGuidelines"/>
                                </div>
                                <EditForm Model="fileUploadDTO" OnValidSubmit="UploadFile" OnInvalidSubmit="HandleInvalidSubmit" FormName="upload" Enhance Context="formContext">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary class="text-sm text-red-600" />

                                    <div class="border-2 border-dashed border-gray-300 rounded-xl p-8 text-center gradient-bg">
                                        <div class="w-20 h-20 mx-auto bg-white rounded-full flex items-center justify-center shadow-sm mb-4">
                                            <i class="fas fa-cloud-upload-alt text-green-900 text-3xl"></i>
                                        </div>
                                        @if (File is null)
                                        {
                                            <h3 class="text-lg font-semibold text-dark mb-2">Drag & drop your files here</h3>
                                            <p class="text-gray-600 mb-6">Supported formats: PDF, DOC, DOCX, PPT, TXT (Max 50MB)</p>
                                            <label for="fileUpload" class="cursor-pointer">
                                                <div class="bg-green-900 text-white px-6 py-3 rounded-lg font-medium hover:bg-secondary transition inline-flex items-center space-x-2">
                                                    <i class="fas fa-folder-open"></i>
                                                    <span>Browse Files</span>
                                                </div>
                                                <InputFile @bind-Value="fileUploadDTO.Data" id="fileUpload" type="file" style="display:none" multiple OnChange="HandleFileSelected" />
                                            </label>
                                            <ValidationMessage For="@(() => fileUploadDTO.Data)" class="text-sm text-red-600 mt-1" />
                                        }
                                        else
                                        {
                                            if (!ProblemWDocument)
                                            {
                                                <label class="cursor-pointer">
                                                    <div class="bg-green-900 text-white px-6 py-3 rounded-lg font-medium hover:bg-secondary transition inline-flex items-center space-x-2">
                                                        <i class="fas fa-folder-open"></i>
                                                        <span>@File.Name</span>
                                                        <div class="md:w-1/4 px-2">
                                                            <button type="button" class="p-2 rounded hover:bg-gray-500" @onclick="DeleteUpload">
                                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                                     fill="none"
                                                                     viewBox="0 0 24 24"
                                                                     stroke-width="2"
                                                                     stroke="white"
                                                                     class="w-6 h-6 text-gray-700">
                                                                    <path stroke-linecap="round"
                                                                          stroke-linejoin="round"
                                                                          d="M6 18L18 6M6 6l12 12" />
                                                                </svg>
                                                            </button>

                                                        </div>
                                                    </div>
                                                </label>
                                            }
                                            else
                                            {
                                                if (UnsupportedDocument)
                                                {
                                                    <label class="cursor-pointer">
                                                        <div class="bg-red-900 text-white px-6 py-3 rounded-lg font-medium hover:bg-secondary transition inline-flex items-center space-x-2">
                                                            <i class="fas fa-folder-open"></i>
                                                            <span>Unsupported File Type. Please view our upload guidelines</span>
                                                            <div class="md:w-1/4 px-2">
                                                                <button type="button" class="p-2 rounded hover:bg-red-500" @onclick="DeleteProblemFile">
                                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                                         fill="none"
                                                                         viewBox="0 0 24 24"
                                                                         stroke-width="2"
                                                                         stroke="white"
                                                                         class="w-6 h-6 text-white">
                                                                        <path stroke-linecap="round"
                                                                              stroke-linejoin="round"
                                                                              d="M6 18L18 6M6 6l12 12" />
                                                                    </svg>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </label>
                                                }
                                                else
                                                {
                                                    <label class="cursor-pointer">
                                                        <div class="bg-red-900 text-white px-6 py-3 rounded-lg font-medium hover:bg-secondary transition inline-flex items-center space-x-2">
                                                            <i class="fas fa-folder-open"></i>
                                                            <span>@File.Name is greater than 50MB. Please try a smaller size.</span>
                                                            <div class="md:w-1/4 px-2">
                                                                <button type="button" class="p-2 rounded hover:bg-red-500" @onclick="DeleteProblemFile">
                                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                                         fill="none"
                                                                         viewBox="0 0 24 24"
                                                                         stroke-width="2"
                                                                         stroke="white"
                                                                         class="w-6 h-6 text-white">
                                                                        <path stroke-linecap="round"
                                                                              stroke-linejoin="round"
                                                                              d="M6 18L18 6M6 6l12 12" />
                                                                    </svg>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </label>
                                                }
                                            }

                                        }
                                    </div>

                                    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-gray-700 text-sm font-medium mb-2">Primary Author</label>
                                            <InputText @bind-Value="fileUploadDTO.Author" type="text" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-900 focus:border-transparent" placeholder="Enter primary document author" />
                                            <ValidationMessage For="@(() => fileUploadDTO.Author)" class="text-sm text-red-600 mt-1" />
                                        </div>
                                        <div>
                                            <label class="block text-gray-700 text-sm font-medium mb-2">Category</label>
                                            <InputSelect @bind-Value="fileUploadDTO.Category" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-900 focus:border-transparent">
                                                <option>Select category</option>
                                                <option>Research Paper</option>
                                                <option>Case Study</option>
                                                <option>Technical Report</option>
                                                <option>Literature Review</option>
                                                <option>Methodology</option>
                                            </InputSelect>
                                            <ValidationMessage For="@(() => fileUploadDTO.Category)" class="text-sm text-red-600 mt-1" />
                                        </div>
                                    </div>
                                    <div class="mt-4">
                                        <label class="block text-gray-700 text-sm font-medium mb-2">Document Title</label>
                                        <InputText @bind-Value="fileUploadDTO.Title" type="text" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-900 focus:border-transparent" placeholder="Enter document title" />
                                        <ValidationMessage For="@(() => fileUploadDTO.Title)" class="text-sm text-red-600 mt-1" />
                                    </div>
                                    <div class="mt-4">
                                        <label class="block text-gray-700 text-sm font-medium mb-2">Description</label>
                                        <InputTextArea @bind-Value="fileUploadDTO.Description" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-900 focus:border-transparent h-32" placeholder="Brief description of the document content"></InputTextArea>
                                        <ValidationMessage For="@(() => fileUploadDTO.Description)" class="text-sm text-red-600 mt-1" />
                                    </div>

                                    <div class="mt-6 flex justify-end">
                                        <button type="submit" class="bg-green-900 text-white px-8 py-3 rounded-lg font-medium hover:bg-secondary transition flex items-center space-x-2">
                                            <i class="fas fa-upload"></i>
                                            <span>Upload Document</span>
                                        </button>
                                    </div>
                                </EditForm>

                            </div>
                            }
                        </Authorized>
                    </AuthorizeView>
                    <!-- Documents Grid -->
                    <div class="mb-8">
                        <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-6">
                            <h2 class="text-xl font-bold text-dark">Recent Document Uploads</h2>
                            <div class="flex space-x-2">
                                @if (DocFilters is not null && DocFilters.Any())
                                {
                                    foreach (var filter in DocFilters)
                                    {
                                        <button @onclick="(() => FilterDocs(filter))" class="@GetFilterClass(filter)">@filter</button>
                                    }
                                }
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            @if (Documents is not null && Documents.Any())
                            {
                                foreach (var Doc in Documents)
                                {
                                    var long_type = Doc.ContentType;
                                    var type = GetShortExtension(long_type);

                                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-3 card-hover">
                                        <div class="flex items-start justify-between mb-4">
                                            <div class="document-icon">
                                                <img src="@($"/Icons/{type}.png")" height="35%" width="25%" />
                                            </div>
                                            <span class="text-xs font-medium px-2 py-1 rounded-full bg-gray-100 text-gray-700">@Doc.Category</span>
                                        </div>

                                        <h3 class="font-bold text-dark text-lg mb-2 line-clamp-2">@Doc.Title</h3>
                                        <p class="text-gray-600 text-sm mb-4 line-clamp-2 overflow-hidden">
                                            @Truncate(Doc.Description, 200)
                                        </p>
                                        <div class="flex items-center justify-between text-sm text-gray-500 mb-4">
                                            <div class="flex items-center space-x-1">
                                                <i class="fas fa-user"></i>
                                                <span>@Doc.Author</span>
                                            </div>
                                            @{
                                                var dateString = ((Doc.Date.ToLongDateString()).Split(','))[1].Trim();
                                                var index = dateString.IndexOf(" ");
                                                var shortDateString = dateString.Substring(0, index);
                                            }
                                            <div>@Doc.Date.DayOfWeek @Doc.Date.Day, @Doc.Date.Year</div>
                                        </div>

                                        <div class="flex items-center justify-between pt-4 border-t">
                                            <div class="flex items-center space-x-4">
                                                <div class="flex items-center space-x-1">
                                                    <i class="fas fa-download text-gray-400"></i>
                                                    <span class="text-sm">@Doc.Downloads</span>
                                                </div>
                                                <div class="flex items-center space-x-1">
                                                    <i class="fas fa-file text-gray-400"></i>
                                                    <span class="text-sm">@FormatFileSize(Doc.Size)</span>
                                                </div>
                                            </div>
                                            <button type="button" @onclick="(() => GoToDocViewer(Doc))" class="text-green-800 hover:text-secondary font-medium flex items-center space-x-1">
                                                <i class="fas fa-eye"></i>
                                                <span>View</span>
                                            </button>
                                        </div>
                                    </div>

                                }
                            }
                            else
                            {
                                if (loadingDocs)
                                {
                                    <div class="center-container">
                                        <svg width="120" height="120" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
                                            <g class="spinner" transform="translate(60,60)">
                                                <circle cx="0" cy="-40" r="6" />
                                                <circle cx="28" cy="-28" r="6" />
                                                <circle cx="40" cy="0" r="6" />
                                                <circle cx="28" cy="28" r="6" />
                                                <circle cx="0" cy="40" r="6" />
                                                <circle cx="-28" cy="28" r="6" />
                                                <circle cx="-40" cy="0" r="6" />
                                                <circle cx="-28" cy="-28" r="6" />
                                            </g>
                                        </svg>
                                    </div>
                                }
                                else
                                {
                                    <div class="center-container">
                                        <p class="text-gray-600 mb-4 line-clamp-3">No Documents Found...</p>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Right Column: Blog Posts & Filters -->
                <div class="lg:w-1/3">
                    <AuthorizeView>
                        <Authorized>
                            @if (Authorized){
                                <!-- Create Blog Post -->
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
                                <h2 class="text-xl font-bold text-dark mb-6">Create New Blog Post</h2>
                                <EditForm Model="blogPostDTO" OnValidSubmit="CreateBlogPost" OnInvalidSubmit="HandleInvalidBlogSubmit" FormName="createblog" Enhance Context="formContext">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary class="text-sm text-red-600" />
                                    <div class="space-y-4">
                                        <div>
                                            <label class="block text-gray-700 text-sm font-medium mb-2">Post Title</label>
                                            <InputText @bind-Value="blogPostDTO.Title" type="text" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-900 focus:border-transparent" placeholder="Enter blog post title" />
                                        </div>
                                        <ValidationMessage For="@(() => blogPostDTO.Title)" class="text-sm text-red-600 mt-1" />
                                        <div>
                                            <label class="block text-gray-700 text-sm font-medium mb-2">Category</label>
                                            <div class="flex flex-wrap gap-2">
                                                @if (BlogCategories.Any())
                                                {
                                                    foreach (var cat in BlogCategories)
                                                    {
                                                        @if (!string.IsNullOrWhiteSpace(cat.Name) && !string.IsNullOrWhiteSpace(blogPostDTO.Category) && blogPostDTO.Category.Equals(cat.Name))
                                                        {
                                                            <button @onclick="(() => SelectCategory(cat.Name))" type="button" class="px-3 py-1.5 rounded-full bg-blue-200 text-green-900 text-sm hover:bg-blue-300 transition">
                                                                @cat.Name
                                                            </button>
                                                        }
                                                        else if (!string.IsNullOrWhiteSpace(cat.Name))
                                                        {
                                                            <button @onclick="(() => SelectCategory(cat.Name))" type="button" class="px-3 py-1.5 rounded-full bg-gray-100 text-gray-700 text-sm hover:bg-gray-200 transition">
                                                                @cat.Name
                                                            </button>
                                                        }
                                                    }
                                                }
                                                <button type="button" @onclick="ShowAddCategoryModal" class="px-3 py-1.5 rounded-full bg-gray-100 text-gray-700 text-sm hover:bg-gray-200 transition">
                                                    + Add
                                                </button>
                                                @{
                                                    var show = showAddCategoryModal ? "display:fixed" : "display:none";
                                                }
                                                <ValidationMessage For="@(() => blogPostDTO.Category)" class="text-sm text-red-600 mt-1" />
                                                <!-- Modal Overlay -->
                                                <div class="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50" style="@show">

                                                    <!-- Modal Box -->
                                                    <div class="bg-white rounded-lg shadow-lg w-96 p-6">
                                                        <h2 class="text-xl font-semibold mb-4">Enter Category Details</h2>

                                                        <!-- Input Field -->
                                                        <InputText @bind-Value="Category"
                                                                   type="text"
                                                                   placeholder="Category Name"
                                                                   class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-green-600 mb-4" />

                                                        <!-- Action Buttons -->
                                                        <div class="flex justify-end space-x-2">
                                                            <button type="button" @onclick="HideAddCategoryModal"
                                                                    class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400">
                                                                Cancel
                                                            </button>
                                                            <button type="button" @onclick="SaveAndHideAddCategoryModal"
                                                                    class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">
                                                                Save
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <label class="block text-gray-700 text-sm font-medium mb-2">Tags</label>
                                        <div class="flex flex-wrap gap-2">
                                            @if (Tags is not null && Tags.Any())
                                            {
                                                foreach (var tag in Tags)
                                                {
                                                    if (BlogTags is not null && BlogTags.Contains(tag))
                                                    {
                                                        <button @onclick="(() => RemoveTag(tag))" type="button" class=" px-3 py-1.5 rounded-full bg-gray-400 text-white text-sm hover:bg-gray-200 transition">@tag.Name</button>
                                                    }
                                                    else
                                                    {
                                                        <button @onclick="(() => AddTag(tag))" type="button" class=" px-3 py-1.5 rounded-full bg-gray-100 text-gray-700 text-sm hover:bg-gray-200 transition">@tag.Name</button>
                                                    }
                                                }
                                            }
                                            <button type="button" @onclick="ShowAddTagModal" class="px-3 py-1.5 rounded-full bg-gray-100 text-gray-700 text-sm hover:bg-gray-200 transition">
                                                + Add
                                            </button>
                                            @{
                                                var showTag = showAddTagModal ? "display:fixed" : "display:none";
                                            }
                                            <!-- Modal Overlay -->
                                            <div class="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50" style="@showTag">

                                                <!-- Modal Box -->
                                                <div class="bg-white rounded-lg shadow-lg w-96 p-6">
                                                    <h2 class="text-xl font-semibold mb-4">Enter Tag Details</h2>

                                                    <!-- Input Field -->
                                                    <InputText @bind-Value="CurrentTag.Name"
                                                               type="text"
                                                               placeholder="Tag Name"
                                                               class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-green-600 mb-4" />

                                                    <!-- Action Buttons -->
                                                    <div class="flex justify-end space-x-2">
                                                        <button type="button" @onclick="(() => HideAddTagModal(CurrentTag))"
                                                                class="px-4 py-2 bg-gray-300 rounded hover:bg-gray-400">
                                                            Cancel
                                                        </button>
                                                        <button type="button" @onclick="(() => SaveAndHideAddTagModal(CurrentTag))"
                                                                class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">
                                                            Save
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        @if (ImageFile is null)
                                        {
                                            <label for="fileUpload2" class="cursor-pointer text-green-900">
                                                <div class="bg-gray-300 px-6 py-3 rounded-lg font-medium hover:bg-secondary transition inline-flex items-center space-x-2">
                                                    <i class="fas fa-folder-open"></i>
                                                    <span>Upload Image</span>
                                                </div>
                                                <InputFile id="fileUpload2" type="file" style="display:none" multiple OnChange="UploadImage" />
                                            </label>
                                            <ValidationMessage For="@(() => blogPostDTO.Image)" class="text-sm text-red-600 mt-1" />
                                        }
                                        else
                                        {
                                            if (!ProblemWBlogImage)
                                            {
                                                <label for="fileUpload3" class="cursor-pointer text-green-900">
                                                    <div class="bg-gray-300 px-6 py-3 rounded-lg font-medium hover:bg-secondary transition inline-flex items-center space-x-2">
                                                        <i class="fas fa-folder-open"></i>
                                                        <span>@ImageFile.Name</span>
                                                        <button type="button" class="p-2 rounded hover:bg-gray-500" @onclick="DeleteImageUpload">
                                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                                 fill="none"
                                                                 viewBox="0 0 24 24"
                                                                 stroke-width="2"
                                                                 stroke="white"
                                                                 class="w-6 h-6 text-gray-700">
                                                                <path stroke-linecap="round"
                                                                      stroke-linejoin="round"
                                                                      d="M6 18L18 6M6 6l12 12" />
                                                            </svg>
                                                        </button>
                                                    </div>
                                                </label>
                                            }
                                            else
                                            {
                                                if (UnsupportedImage)
                                                {
                                                    <label for="fileUpload3" class="cursor-pointer text-green-900">
                                                        <div class="bg-red-300 px-6 py-3 rounded-lg font-medium hover:bg-secondary transition inline-flex items-center space-x-2">
                                                            <i class="fas fa-folder-open"></i>
                                                            <span>Unsupported Image Type. Supported image types are PNG, JPG, WEBP, or SVG</span>
                                                            <button type="button" class="p-2 rounded hover:bg-red-500" @onclick="DeleteProblemImage">
                                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                                     fill="none"
                                                                     viewBox="0 0 24 24"
                                                                     stroke-width="2"
                                                                     stroke="white"
                                                                     class="w-6 h-6 text-gray-700">
                                                                    <path stroke-linecap="round"
                                                                          stroke-linejoin="round"
                                                                          d="M6 18L18 6M6 6l12 12" />
