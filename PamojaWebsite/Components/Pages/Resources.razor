        {
            using var context = await DbFactory.CreateDbContextAsync();
            blogPost.Title = blogPostDTO.Title;
            blogPost.Content = blogPostDTO.Content;
            blogPost.Likes = 0;
            blogPost.ReadTime = ReadTimeMinutes;

            blogPost.Author = User.Name;
            var roles = await UserManager.GetRolesAsync(User);


            if (roles is not null)
            {
                var role = roles.FirstOrDefault(r => r != "PamojaMember");
                if (role is not null)
                {
                    blogPost.AuthorRole = role;
                }
            }
            if (User.Bio is not null)
            {
                blogPost.AuthorBio = User.Bio;
            }
            if (User.ProfilePicture is not null)
            {
                blogPost.AuthorImage = User.ProfilePicture;
                blogPost.AuthorImageContentType = User.ImageContentType;
            }
            if (User.ImageContentType is not null)
            {
                blogPost.AuthorImageContentType = User.ImageContentType;
            }
            var Facebook = context.SocialMediaLink.FirstOrDefault(s => s.UserId == User.Id && s.Platform == "Facebook");
            var X = context.SocialMediaLink.FirstOrDefault(s => s.UserId == User.Id && s.Platform == "X");
            var Instagram = context.SocialMediaLink.FirstOrDefault(s => s.UserId == User.Id && s.Platform == "Instagram");
            var LinkedIn = context.SocialMediaLink.FirstOrDefault(s => s.UserId == User.Id && s.Platform == "LinkedIn");
            var Github = context.SocialMediaLink.FirstOrDefault(s => s.UserId == User.Id && s.Platform == "Github");

            if (Facebook is not null && !string.IsNullOrWhiteSpace(Facebook.Url))
            {
                Facebook.BlogPostIds.Add(blogPost.Id);
                blogPost.AuthorSocialMediaIds.Add(Facebook.Id);
            }
            if (Instagram is not null && !string.IsNullOrWhiteSpace(Instagram.Url))
            {
                Instagram.BlogPostIds.Add(blogPost.Id); ;
            }
            if (X is not null && !string.IsNullOrWhiteSpace(X.Url))
            {
                X.BlogPostIds.Add(blogPost.Id);
            }
            if (Github is not null && !string.IsNullOrWhiteSpace(Github.Url))
            {
                Github.BlogPostIds.Add(blogPost.Id);
            }
            if (LinkedIn is not null && !string.IsNullOrWhiteSpace(LinkedIn.Url))
            {
                LinkedIn.BlogPostIds.Add(blogPost.Id);
            }

            var category = BlogCategories.FirstOrDefault(c => c.Name == blogPostDTO.Category);

            if (category is not null)
            {
                blogPost.CategoryId = category.Id;
                blogPost.Category = Category;
            }
            if (blogPostDTO.TagIds is not null)
            {
                foreach (var tagId in blogPostDTO.TagIds)
                {
                    var new_tag = await context.Tag.FirstOrDefaultAsync(t => t.Id.ToString() == tagId);
                    if (new_tag is not null)
                    {
                        new_tag.BlogPostIds.Add(blogPost.Id);
                        context.Attach(new_tag).State = EntityState.Modified;
                    }
                }
            }
            blogPost.TagIds = blogPostDTO.TagIds;
            if (BlogTags is not null)
            {
                foreach (var tag in BlogTags)
                {
                    blogPost.Tags.Add(tag.Name);
                }
            }
            blogPost.Comments = 0;
            BlogPosts.Add(blogPost);
            context.BlogPost.Add(blogPost);
            await context.SaveChangesAsync();
            blogPostDTO.Title = "";
            blogPostDTO.Content = "";
            blogPostDTO.Category = "";
            ImageFile = null;
            blogPostDTO.Image = null;
            blogPostDTO.ImageContentType = null;
            blogPostDTO.TagIds.Clear();
            BlogTags.Clear();

            StateHasChanged();
        }
    }
    public string Truncate(string value, int maxChars)
    {
        if (string.IsNullOrEmpty(value)) return value;
        return value.Length <= maxChars ? value : value.Substring(0, maxChars) + "...";
    }
