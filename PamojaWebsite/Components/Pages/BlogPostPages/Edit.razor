@page "/blogposts/edit"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Edit</h1>

    <h2>BlogPost</h2>
    <hr />
    @if (BlogPost is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="row">
            <div class="col-md-4">
                <EditForm method="post" Model="BlogPost" OnValidSubmit="UpdateBlogPost" FormName="edit" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary role="alert" />
                    <input type="hidden" name="BlogPost.Id" value="@BlogPost.Id" />
                    <div class="mb-3">
                        <label for="title" class="form-label">Title:</label>
                        <InputText id="title" @bind-Value="BlogPost.Title" class="form-control" />
                        <ValidationMessage For="() => BlogPost.Title" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="author" class="form-label">Author:</label>
                        <InputText id="author" @bind-Value="BlogPost.Author" class="form-control" />
                        <ValidationMessage For="() => BlogPost.Author" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="date" class="form-label">Date:</label>
                        <InputDate id="date" @bind-Value="BlogPost.Date" class="form-control" />
                        <ValidationMessage For="() => BlogPost.Date" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="readtime" class="form-label">ReadTime:</label>
                        <InputDate id="readtime" @bind-Value="BlogPost.ReadTime" class="form-control" />
                        <ValidationMessage For="() => BlogPost.ReadTime" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="content" class="form-label">Content:</label>
                        <InputText id="content" @bind-Value="BlogPost.Content" class="form-control" />
                        <ValidationMessage For="() => BlogPost.Content" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="imagecontenttype" class="form-label">ImageContentType:</label>
                        <InputText id="imagecontenttype" @bind-Value="BlogPost.PreviewImageContentType" class="form-control" />
                        <ValidationMessage For="() => BlogPost.PreviewImageContentType" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="likes" class="form-label">Likes:</label>
                        <InputNumber id="likes" @bind-Value="BlogPost.Likes" class="form-control" />
                        <ValidationMessage For="() => BlogPost.Likes" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="comments" class="form-label">Comments:</label>
                        <InputNumber id="comments" @bind-Value="BlogPost.Comments" class="form-control" />
                        <ValidationMessage For="() => BlogPost.Comments" class="text-danger" />
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </EditForm>
            </div>
        </div>
    }

    <div>
        <a href="/blogposts">Back to List</a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string Id { get; set; }

    [SupplyParameterFromForm]
    private BlogPost? BlogPost { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        BlogPost ??= await context.BlogPost.FirstOrDefaultAsync(m => m.Id == Id);

        if (BlogPost is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateBlogPost()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(BlogPost!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!BlogPostExists(BlogPost!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/blogposts");
    }

    private bool BlogPostExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.BlogPost.Any(e => e.Id == id);
    }
}
