@page "/blogposts/delete"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Delete</h1>

    <p>Are you sure you want to delete this?</p>
    <div>
        <h2>BlogPost</h2>
        <hr />
        @if (blogpost is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Title</dt>
                <dd class="col-sm-10">@blogpost.Title</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Author</dt>
                <dd class="col-sm-10">@blogpost.Author</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Date</dt>
                <dd class="col-sm-10">@blogpost.Date</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">ReadTime</dt>
                <dd class="col-sm-10">@blogpost.ReadTime</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Content</dt>
                <dd class="col-sm-10">@blogpost.Content</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">PreviewImageContentType</dt>
                <dd class="col-sm-10">@blogpost.PreviewImageContentType</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Image</dt>
                <dd class="col-sm-10">@blogpost.PreviewImage</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Likes</dt>
                <dd class="col-sm-10">@blogpost.Likes</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Comments</dt>
                <dd class="col-sm-10">@blogpost.Comments</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Category</dt>
                <dd class="col-sm-10">@blogpost.Category</dd>
            </dl>
            <EditForm method="post" Model="blogpost" OnValidSubmit="DeleteBlogPost" FormName="delete" Enhance>
                <button type="submit" class="btn btn-danger" disabled="@(blogpost is null)">Delete</button> |
                <a href="/blogposts">Back to List</a>
            </EditForm>
        }
    </div>
</div>

@code {
    private BlogPost? blogpost;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        blogpost = await context.BlogPost.FirstOrDefaultAsync(m => m.Id == Id);

        if (blogpost is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteBlogPost()
    {
        using var context = DbFactory.CreateDbContext();
        context.BlogPost.Remove(blogpost!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/blogposts");
    }
}
