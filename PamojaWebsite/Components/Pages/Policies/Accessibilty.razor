@page "/accessibility-statement"

@using Shared

@layout PoliciesLayout

<PageTitle>Accessibility Statement</PageTitle>

<div class="pt-[20%] mb-5 py-20 mt-5">
    <div class="flex justify-center max-w-xl mx-auto">
        <div class="bg-white p-8 rounded-xl shadow-lg border border-gray-200">
            <!-- h1 -->
            <h1 class="text-5xl text-green-700 font-bold mt-8 mb-3">Accessibility Statement</h1>
             <p class="mb-6">We strive to ensure our website is accessible to everyone, including individuals with disabilities. We are continually improving the user experience for all and applying the relevant accessibility standards.</p>
            <h3 class="text-[1.4rem] text-green-700 mt-10 mb-4 border-b border-green-700 pb-2">Conformance Status</h3>
            <p class="mb-6">Our goal is to meet WCAG 2.1 Level AA standards. If you encounter any barriers while using our site, please email us at <a href="mailto:pamojamentalhealth@pamojasafeguarding.com" class="text-green-700 hover:text-slate-700 transition-colors">our email</a>.</p>
        </div>
    </div>
</div>