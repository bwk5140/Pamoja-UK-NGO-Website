@page "/documentmetadata"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using PamojaWebsite.Data
@using PamojaWebsite.Data.Contexts
@implements IAsyncDisposable
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

<PageTitle>Index</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Index</h1>

    <p>
        <a href="documentmetadata/create">Create New</a>
    </p>

    <QuickGrid Class="table" Items="context.DocumentMetadata">
        <PropertyColumn Property="documentmetadata => documentmetadata.Title" />
        <PropertyColumn Property="documentmetadata => documentmetadata.Author" />
        <PropertyColumn Property="documentmetadata => documentmetadata.LastModified" />
        <PropertyColumn Property="documentmetadata => documentmetadata.Category" />
        <PropertyColumn Property="documentmetadata => documentmetadata.PageCount" />

        <TemplateColumn Context="documentmetadata">
            <a href="@($"documentmetadata/edit?id={documentmetadata.Id}")">Edit</a> |
            <a href="@($"documentmetadata/details?id={documentmetadata.Id}")">Details</a> |
            <a href="@($"documentmetadata/delete?id={documentmetadata.Id}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
</div>

@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
