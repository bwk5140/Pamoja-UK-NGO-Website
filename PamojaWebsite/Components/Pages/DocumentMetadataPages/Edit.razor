@page "/documentmetadata/edit"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Edit</h1>

    <h2>DocumentMetadata</h2>
    <hr />
    @if (DocumentMetadata is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="row">
            <div class="col-md-4">
                <EditForm method="post" Model="DocumentMetadata" OnValidSubmit="UpdateDocumentMetadata" FormName="edit" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary role="alert" />
                    <input type="hidden" name="DocumentMetadata.Id" value="@DocumentMetadata.Id" />
                    <div class="mb-3">
                        <label for="title" class="form-label">Title:</label>
                        <InputText id="title" @bind-Value="DocumentMetadata.Title" class="form-control" />
                        <ValidationMessage For="() => DocumentMetadata.Title" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="author" class="form-label">Author:</label>
                        <InputText id="author" @bind-Value="DocumentMetadata.Author" class="form-control" />
                        <ValidationMessage For="() => DocumentMetadata.Author" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="lastmodified" class="form-label">LastModified:</label>
                        <InputDate id="lastmodified" @bind-Value="DocumentMetadata.LastModified" class="form-control" />
                        <ValidationMessage For="() => DocumentMetadata.LastModified" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="category" class="form-label">Category:</label>
                        <InputText id="category" @bind-Value="DocumentMetadata.Category" class="form-control" />
                        <ValidationMessage For="() => DocumentMetadata.Category" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="pagecount" class="form-label">PageCount:</label>
                        <InputNumber id="pagecount" @bind-Value="DocumentMetadata.PageCount" class="form-control" />
                        <ValidationMessage For="() => DocumentMetadata.PageCount" class="text-danger" />
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </EditForm>
            </div>
        </div>
    }

    <div>
        <a href="/documentmetadata">Back to List</a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string Id { get; set; }

    [SupplyParameterFromForm]
    private DocumentMetadata? DocumentMetadata { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        DocumentMetadata ??= await context.DocumentMetadata.FirstOrDefaultAsync(m => m.Id == Id);

        if (DocumentMetadata is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateDocumentMetadata()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(DocumentMetadata!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!DocumentMetadataExists(DocumentMetadata!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/documentmetadata");
    }

    private bool DocumentMetadataExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.DocumentMetadata.Any(e => e.Id == id);
    }
}
