@page "/documentmetadata/details"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Details</h1>

    <div>
        <h2>DocumentMetadata</h2>
        <hr />
        @if (documentmetadata is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Title</dt>
                <dd class="col-sm-10">@documentmetadata.Title</dd>
                <dt class="col-sm-2">Author</dt>
                <dd class="col-sm-10">@documentmetadata.Author</dd>
                <dt class="col-sm-2">LastModified</dt>
                <dd class="col-sm-10">@documentmetadata.LastModified</dd>
                <dt class="col-sm-2">Category</dt>
                <dd class="col-sm-10">@documentmetadata.Category</dd>
                <dt class="col-sm-2">PageCount</dt>
                <dd class="col-sm-10">@documentmetadata.PageCount</dd>
            </dl>
            <div>
                <a href="@($"/documentmetadata/edit?id={documentmetadata.Id}")">Edit</a> |
                <a href="@($"/documentmetadata")">Back to List</a>
            </div>
        }
    </div>
</div>

@code {
    private DocumentMetadata? documentmetadata;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        documentmetadata = await context.DocumentMetadata.FirstOrDefaultAsync(m => m.Id == Id);

        if (documentmetadata is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
