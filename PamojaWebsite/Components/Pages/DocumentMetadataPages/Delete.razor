@page "/documentmetadata/delete"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Delete</h1>

    <p>Are you sure you want to delete this?</p>
    <div>
        <h2>DocumentMetadata</h2>
        <hr />
        @if (documentmetadata is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Title</dt>
                <dd class="col-sm-10">@documentmetadata.Title</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Author</dt>
                <dd class="col-sm-10">@documentmetadata.Author</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">LastModified</dt>
                <dd class="col-sm-10">@documentmetadata.LastModified</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Category</dt>
                <dd class="col-sm-10">@documentmetadata.Category</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">PageCount</dt>
                <dd class="col-sm-10">@documentmetadata.PageCount</dd>
            </dl>
            <EditForm method="post" Model="documentmetadata" OnValidSubmit="DeleteDocumentMetadata" FormName="delete" Enhance>
                <button type="submit" class="btn btn-danger" disabled="@(documentmetadata is null)">Delete</button> |
                <a href="/documentmetadata">Back to List</a>
            </EditForm>
        }
    </div>
</div>

@code {
    private DocumentMetadata? documentmetadata;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        documentmetadata = await context.DocumentMetadata.FirstOrDefaultAsync(m => m.Id == Id);

        if (documentmetadata is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteDocumentMetadata()
    {
        using var context = DbFactory.CreateDbContext();
        context.DocumentMetadata.Remove(documentmetadata!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/documentmetadata");
    }
}
