@page "/appointments"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using PamojaWebsite.Data
@using PamojaWebsite.Data.Contexts
@implements IAsyncDisposable
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

<PageTitle>Index</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Index</h1>

    <p>
        <a href="appointments/create">Create New</a>
    </p>

    <QuickGrid Class="table" Items="context.Appointment">
        <PropertyColumn Property="appointment => appointment.FirstName" />
        <PropertyColumn Property="appointment => appointment.LastName" />
        <PropertyColumn Property="appointment => appointment.Phone" />
        <PropertyColumn Property="appointment => appointment.Email" />
        <PropertyColumn Property="appointment => appointment.Date" />
        <PropertyColumn Property="appointment => appointment.Calendar" />
        <PropertyColumn Property="appointment => appointment.Message" />

        <TemplateColumn Context="appointment">
            <a href="@($"appointments/edit?id={appointment.Id}")">Edit</a> |
            <a href="@($"appointments/details?id={appointment.Id}")">Details</a> |
            <a href="@($"appointments/delete?id={appointment.Id}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
</div>

@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
