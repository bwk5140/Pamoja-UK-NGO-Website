@page "/appointments/create"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Create</h1>

    <h2>Appointment</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Appointment" OnValidSubmit="AddAppointment" FormName="create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <label for="firstname" class="form-label">FirstName:</label>
                    <InputText id="firstname" @bind-Value="Appointment.FirstName" class="form-control" />
                    <ValidationMessage For="() => Appointment.FirstName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="lastname" class="form-label">LastName:</label>
                    <InputText id="lastname" @bind-Value="Appointment.LastName" class="form-control" />
                    <ValidationMessage For="() => Appointment.LastName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="phone" class="form-label">Phone:</label>
                    <InputText id="phone" @bind-Value="Appointment.Phone" class="form-control" />
                    <ValidationMessage For="() => Appointment.Phone" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email:</label>
                    <InputText id="email" @bind-Value="Appointment.Email" class="form-control" />
                    <ValidationMessage For="() => Appointment.Email" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="date" class="form-label">Date:</label>
                    <InputDate id="date" @bind-Value="Appointment.Date" class="form-control" />
                    <ValidationMessage For="() => Appointment.Date" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="calendar" class="form-label">Calendar:</label>
                    <InputText id="calendar" @bind-Value="Appointment.Calendar" class="form-control" />
                    <ValidationMessage For="() => Appointment.Calendar" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="message" class="form-label">Message:</label>
                    <InputText id="message" @bind-Value="Appointment.Message" class="form-control" />
                    <ValidationMessage For="() => Appointment.Message" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
        </div>
    </div>

    <div>
        <a href="/appointments">Back to List</a>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Appointment Appointment { get; set; } = default!;

    protected override void OnInitialized() => Appointment ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddAppointment()
    {
        using var context = DbFactory.CreateDbContext();
        context.Appointment.Add(Appointment);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/appointments");
    }
}
