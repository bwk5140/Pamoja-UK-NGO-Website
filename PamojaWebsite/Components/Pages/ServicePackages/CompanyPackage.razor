    <!-- Stats Section -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-6 lg:px-8">
            <div class="max-w-4xl mx-auto text-center">
                <p class="text-gray-600 mb-8">In 2021, the estimated economic burden of mental health conditions on the Kenyan economy was Sh62.2 billion, or 0.6% of the GDP, with lost productivity due to premature mortality, absenteeism, 
                    and presenteeism accounting for the largest share at Sh56.6 billion</p>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
                    <div class="bg-green-50 p-6 rounded-xl">
                        <span class="text-4xl font-bold text-green-600">62.2B</span>
                        <p class="mt-2 text-gray-700">Economic burden in Kenya</p>
                    </div>
                    <div class="bg-green-50 p-6 rounded-xl">
                        <span class="text-4xl font-bold text-green-600">0.6%</span>
                        <p class="mt-2 text-gray-700">Of Kenya's GDP</p>
                    </div>
                    <div class="bg-green-50 p-6 rounded-xl">
                        <span class="text-4xl font-bold text-green-600">56.6B</span>
                        <p class="mt-2 text-gray-700">Lost productivity</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Our Comprehensive Services</h2>
                <p class="text-xl text-gray-600 max-w-3xl mx-auto">Expert-led, trauma-informed and culturally relevant services for your organization</p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Service Card 1 -->
                <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition duration-300">
                    <div class="p-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-green-100 p-3 rounded-full mr-4">
                                <i data-feather="alert-circle" class="text-green-600 w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900">Early Identification</h3>
                        </div>
                        <ul class="space-y-2 text-gray-600">
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Identify stress, burnout, anxiety, and depression early</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Prevent crisis situations</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Reduce absenteeism and turnover</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Service Card 2 -->
                <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition duration-300">
                    <div class="p-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-green-100 p-3 rounded-full mr-4">
                                <i data-feather="users" class="text-green-600 w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900">Employee Support</h3>
                        </div>
                        <ul class="space-y-2 text-gray-600">
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Employee Assistance Programs (EAPs)</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Flexible working arrangements</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Resilience and stress management training</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Return to Work plans</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Reasonable workplace adjustments</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Recognising signs of adult abuse, exploitation, or coercion</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Handling disclosures and building trauma-informed responses</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Bystander intervention and safe referral practices</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Promoting boundaries and dignity at work</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Medication Management</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Service Card 3 -->
                <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition duration-300">
                    <div class="p-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-green-100 p-3 rounded-full mr-4">
                                <i data-feather="heart" class="text-green-600 w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900">Employee Training</h3>
                        </div>
                        <ul class="space-y-2 text-gray-600">
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Reducing Stigma and Promoting Openness</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Mental Health, Safeguarding & Trauma-Informed Support from Pamoja</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Confidential staff mental wellbeing drop-in sessions</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Critical incident debriefing and post-trauma support</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Support planning for vulnerable employees</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>On-Call Safeguarding Consultancy</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Service Card 4 -->
                <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition duration-300">
                    <div class="p-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-green-100 p-3 rounded-full mr-4">
                                <i data-feather="briefcase" class="text-green-600 w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900">Manager Training</h3>
                        </div>
                        <ul class="space-y-2 text-gray-600">
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Full day wellbeing workshops</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Individual manager support</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Recognize early signs of mental distress</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Design policies to prevent overwork</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Encourage regular check-ins and transparent communication</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Foster inclusive team cultures</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Service Card 5 -->
                <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition duration-300">
                    <div class="p-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-green-100 p-3 rounded-full mr-4">
                                <i data-feather="trending-up" class="text-green-600 w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900">Organizational Level Support</h3>
                        </div>
                        <ul class="space-y-2 text-gray-600">
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Team building away day with our occupational therapist</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Train employees on creating  boundaries around after-hours communication</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Create career growth, learning, and creative expression pathways</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Innovation hubs and creativity spaces</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Team building days to foster collaboration, and improve communication</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Policy Review & Compliance Alignment</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Get Started With Our Company Services</h2>

            <div class="bg-white p-8 rounded-xl shadow-md">
                <form class="space-y-6">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Your Name</label>
                            <input type="text" id="name" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                        </div>
                        <div>
                            <label for="school" class="block text-sm font-medium text-gray-700 mb-1">School/Organization</label>
                            <input type="text" id="school" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                        </div>
                        <div>
                            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                            <input type="email" id="email" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                        </div>
                        <div>
                            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                            <input type="tel" id="phone" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                        </div>
                    </div>
                    <div>
                        <label for="program" class="block text-sm font-medium text-gray-700 mb-1">Service of Interest</label>
                        <select id="program" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                            <option value="">Select a service</option>
                            <option value="primary">Early Identification Services</option>
                            <option value="secondary">Employee Support Services</option>
                            <option value="university">Safeguarding Services</option>
                            <option value="staff">Wellbeing Support Services</option>
                            <option value="parents">Manager Training Services</option>
                            <option value="parents">Team Performance Services</option>
                        </select>
                    </div>
                    <div>
                        <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
                        <textarea id="message" rows="4" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500"></textarea>
                    </div>
                    <div>
                        <button type="submit" class="w-full bg-green-800 hover:bg-green-900 text-white font-bold py-3 px-6 rounded-md transition duration-300">
                            Request Information
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("featherInit");
        }
    }
    private async Task ScrollToTarget()
    {
        await JS.InvokeVoidAsync("scrollToSection", "contact");
    }

}
