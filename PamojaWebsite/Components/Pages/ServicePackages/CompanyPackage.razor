@page "/services/company-package"

<PageTitle>Company Package</PageTitle>

@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="container-xxxl">
        <!-- Banner Section -->
        <section class="relative bg-green-900 text-white py-2 px-4 sm:px-6 lg:px-8 overflow-hidden">
            <!-- Decorative background shapes -->
            <div class="absolute inset-0">
                <!-- Large blurred gradient blob -->
                <div class="absolute -top-32 -left-32 w-96 h-96 bg-gradient-to-r from-green-600 to-blue-800 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>

                <!-- Smaller accent circle -->
                <div class="absolute top-20 right-20 w-40 h-40 bg-green-700 rounded-full opacity-30 animate-bounce"></div>

                <!-- Diagonal rectangle -->
                <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-green-800 opacity-40 transform rotate-12"></div>

                <!-- Triangle using clip-path -->
                <div class="absolute top-1/2 right-0 w-64 h-64 bg-blue-900 opacity-30"
                     style="clip-path: polygon(0 0, 100% 0, 0 100%);">
                </div>
            </div>

            <!-- Content -->
            <div class="relative max-w-7xl mx-auto">
                <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
                        <h1 class="text-4xl mt-5 md:text-5xl font-bold mb-2">Company Package</h1>
                </div>
            </div>
        </section>
        <!-- Breadcrumb Section-->
        <section class="py-10">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Breadcrumb -->
                <nav class="flex items-center text-sm text-gray-600" aria-label="Breadcrumb">
                    <ol class="inline-flex items-center space-x-1 md:space-x-3">
                        <!-- About Us -->
                        <li class="inline-flex items-center">
                            <a href="/services"
                               class="inline-flex items-center text-green-700 hover:text-green-800 font-medium">
                                Services
                            </a>
                        </li>

                        <!-- Separator -->
                        <li>
                            <div class="flex items-center">
                                <svg class="w-4 h-4 text-gray-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd"
                                          d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                          clip-rule="evenodd" />
                                </svg>
                                <a href="/services/company-package"
                                   class="ml-1 text-green-700 hover:text-green-800 font-medium font-bold">
                                    Company Package
                                </a>
                            </div>
                        </li>
                    </ol>
                </nav>
            </div>
        </section>
    <!-- About Section -->
    <section class="py-10 bg-white">
        <div class="container mx-auto px-6">
            <div class="max-w-4xl mx-auto">
                <div class="prose prose-lg max-w-none">
                    <p class="text-xl md:text-2xl opacity-90 leading-relaxed">
                        Empower Your Team, Boost Productivity.
                        Build a safe and productive workspace with our tailored mental health and safeguarding packages.
                    </p>
                    <button type="button" class="mt-3 btn bg-green-800 hover:bg-green-900 text-white font-bold py-3 px-6 rounded-lg transition duration-300 inline-flex items-center"
                            @onclick="ScrollToTarget">
                        Get Started
                        <i data-feather="arrow-right" class="ml-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>
    <!-- Art Section-->
    <section class="relative bg-primary-100 text-gray-900 py-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
        <!-- Decorative background shapes -->
        <div class="absolute inset-0">
            <!-- Gradient blob -->
            <div class="absolute -top-24 -left-24 w-96 h-96 bg-gradient-to-tr from-green-300 to-blue-400 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>

            <!-- Accent circle -->
            <div class="absolute bottom-10 right-10 w-48 h-48 bg-green-200 rounded-full opacity-30 animate-bounce"></div>

            <!-- Diagonal rectangle -->
            <div class="absolute top-1/3 left-1/2 w-72 h-72 bg-blue-200 opacity-40 transform rotate-12"></div>
        </div>

        <!-- Content -->
        <div class="relative max-w-7xl mx-auto grid md:grid-cols-3 gap-12 items-center">
            <!-- Image overlay -->
            <div class="relative">
                <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1757405571523-MV10I664UB4UJ87L240N/unsplash-image-n95VMLxqM2I.jpg"
                     alt="Shaking hands"
                     class="relative z-10 rounded-lg shadow-lg">
            </div>
            <div class="relative">
                <img src="Images/Art/patient-meet-a-doctor-for-therapy.jpg"
                     alt="Patient meeting doctor for therapy"
                     class="relative z-10 rounded-lg shadow-lg">
            </div>
            <div class="relative">
                <img src="Images/Art/portrait-of-stressed-black-man.jpg" alt="Portrait of stressed black man"
                     class="relative z-10 rounded-lg shadow-lg" />
            </div>
        </div>
    </section>
@*     <!-- Hero Section -->
    <section class="relative bg-primary-600 text-gray-700 py-20 px-4 sm:px-6 lg:px-8">
