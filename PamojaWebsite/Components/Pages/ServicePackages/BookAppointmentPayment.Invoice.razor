@page "/book-appointment/payment/invoice"

<PageTitle>Appointment Payment Invoice | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!--Scripts-->
<head>
    <script src="payment.min.js" defer></script>
    <script defer src="https://js.stripe.com/v3/"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
    <script>
        function loadGA() {
          if (window.gaLoaded) return;
          window.gaLoaded = true;

          var script = document.createElement('script');
          script.src = "https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG";
          script.async = true;
          document.head.appendChild(script);

          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'pamojasafeguardingnetwork.co.uk', 'anonymize_ip': true});
        }

        // Fire when browser is idle or after first interaction
        if ('requestIdleCallback' in window) {
          requestIdleCallback(() => setTimeout(loadGA, 2000));
        } else {
          setTimeout(loadGA, 3000);
        }
    </script>
</head>

@inject IJSRuntime JS
@inject MyApiService ApiService
@inject HttpClient HttpClient
@inject IMemoryCache Cache
@inject PayPalOptions PayPalOpts
@inject EmailService EmailSender
@inject NavigationManager NavigationManager
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

@rendermode InteractiveServer

<div class="pt-[4%] mb-5 py-20">
    <div class="sm:max-w-none md:max-w-5xl mx-auto py-10 px-6">
        <main class="container mx-auto px-4 py-12">
            <div class="sm:max-w-none md:max-w-5xl mx-auto bg-white rounded-xl shadow-lg overflow-hidden">
                <div class="p-8">
                    <div class="text-center mb-8">
                        <i data-feather="check-circle" class="w-12 h-12 text-green-500 mx-auto"></i>
                        <h1 class="text-3xl font-bold text-gray-800 mt-4">Payment Invoice</h1>
                        <p class="text-gray-600 mt-2">Thank you!</p>
                    </div>

                    <div class="border-b border-gray-200 pb-6 mb-6">
                        <div class="flex justify-between items-center mb-4">
                            <div>
                                <h2 class="text-lg font-semibold text-gray-800 mb-3">
                                    Pamoja Counselling, Mental Wellbeing and
                                    Safeguarding Services
                                </h2>
                                <p class="text-sm text-gray-600">
                                    Unit 3, Office A, 1st Floor, 6-7 St Mary At Hill

                                    London, EC3R 8EE, England
                                </p>
                            </div>
                            <div class="text-right">
                                @if (donation is not null)
                                {
                                    <p class="text-sm text-gray-600 mb-3">Invoice <span id="invoice-number">@donation.InvoiceNumber</span></p>
                                }
                                else
                                {
                                    <p class="text-sm text-gray-600">Invoice #<span id="invoice-number">Loading...</span></p>
                                }
                                <p class="text-sm text-gray-600"><span id="invoice-date">@DateOnly.FromDateTime(DateTime.UtcNow).ToLongDateString()</span></p>
                            </div>
                        </div>
                    </div>

                    <div class="mb-8">
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                                    </tr>
                                </thead>
                                @if (donation is not null)
                                {
                                    <tbody class="bg-white divide-y divide-gray-200">
                                        <tr>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Appointment Payment</td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" id="donation-amount">@CurrencySymbols[donation.Currency]@donation.Amount</td>
                                        </tr>
                                        <tr>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Processing Fee</td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" id="processing-fee">@CurrencySymbols[donation.Currency]@donation.ProcessingFee</td>
                                        </tr>
                                        <tr class="bg-gray-50">
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Total</td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900" id="total-amount">@CurrencySymbols[donation.Currency]@donation.Total</td>
                                        </tr>
                                    </tbody>
                                }
                                else
                                {
                                    <tbody class="bg-white divide-y divide-gray-200">
                                        <tr>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Appointment Payment</td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" id="donation-amount">Loading...</td>
                                        </tr>
                                        <tr>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Processing Fee</td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" id="processing-fee">Loading...</td>
                                        </tr>
                                        <tr class="bg-gray-50">
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Total</td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900" id="total-amount">Loading...</td>
                                        </tr>
                                    </tbody>
                                }
                            </table>
                        </div>
                    </div>

                    <div class="bg-green-50 rounded-lg p-4 mb-6">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <i data-feather="info" class="h-5 w-5 text-green-600"></i>
                            </div>
                            <div class="ml-3">
                                <h3 class="text-sm font-medium text-green-800">Your payment is tax deductible</h3>
                                <div class="mt-2 text-sm text-green-700">
                                    <p>
                                        Pamoja Counselling, Mental Wellbeing and Safeguarding Services is a registered 501(c)(3)
                                        nonprofit organization. Your donation is tax-deductible to the extent allowed by law.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <h1 class="text-2xl font-semibold mb-4">Checkout</h1>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <button class=@($"px-4 py-2 rounded border-2 {(selected == PaymentMethod.Stripe ? "border-green-600" : "border-gray-300 hover:bg-gray-50")}")
                    @onclick="() => SelectMethod(PaymentMethod.Stripe)">
                Credit/Debit Card
            </button>

            @* <button class=@($"px-4 py-2 rounded border-2 {(selected == PaymentMethod.PayPal ? "border-green-600" : "border-gray-300 hover:bg-gray-50")}")
                    @onclick="() => SelectMethod(PaymentMethod.PayPal)">
                PayPal
            </button> *@

            <button class=@($"px-4 py-2 rounded border-2 {(selected == PaymentMethod.Mpesa ? "border-green-600" : "border-gray-300 hover:bg-gray-50")}")
                    @onclick="() => SelectMethod(PaymentMethod.Mpesa)">
                M‑Pesa
            </button>
        </div>

        <div class="mt-6" style="display:@(selected == PaymentMethod.Stripe ? "block" : "none")">
            <div id="stripe-payment-element" class="p-4 border rounded"></div>
            <button class="mt-4 px-4 py-2 bg-green-600 text-white rounded" @onclick="ConfirmStripe" disabled="@isProcessing">
                @(isProcessing ? "Processing" + "..." : "Pay")
            </button>
        </div>
        <div class="mt-6 space-y-4" style="display:@(selected == PaymentMethod.Mpesa ? "block" : "none")">
            <EditForm Model="payByMpesaDTO" OnValidSubmit="SendStkPush" OnInvalidSubmit="HandleInvalidSubmit" FormName="create" Enhance class="space-y-6">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-small text-red-600" />
                <label class="block">
                    <span class="text-sm text-gray-700">Phone (E.164, e.g., 2547XXXXXXXX)</span>
                    <InputText @bind-Value="mpesaPhone" class="mt-1 w-full border rounded px-3 py-2" />
                </label>
                <ValidationMessage For="@(() => mpesaPhone)" class="text-sm text-red-600 mt-1" />

                <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded" style="display: none;">Send STK Push</button>
            </EditForm>
            <p class="mt-2 text-sm text-green-700">Coming Soon...</p>
            @if (!string.IsNullOrEmpty(success_message))
            {
                <p class="mt-2 text-sm text-green-700">@success_message</p>
            }
            @if (!string.IsNullOrEmpty(failure_message))
            {
                <p class="mt-2 text-sm text-red-700">@failure_message</p>
            }
        </div>
    </div>
</div>

@code {
    enum PaymentMethod { Stripe, PayPal, Mpesa }

    PaymentMethod selected = PaymentMethod.Stripe;

    [Parameter]
    public PayByMpesaDTO payByMpesaDTO { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    [SupplyParameterFromQuery]
    private string? AptId { get; set; }

    private string id { get; set; }

    [Parameter]
    public Donation? donation { get; set; }
    [Parameter]
    public Appointment? appointment { get; set; }
    private Payment? Payment;
    private bool isProcessing = false;

    private IJSObjectReference? paymentModule;
    private IJSObjectReference? stripeSession;

    Dictionary<string, string> CurrencySymbols = new()
    {
        { "USD", "$" },
        { "EUR", "€" },
        { "GBP", "£" },
        { "JPY", "¥" },
        { "CAD", "C$" },
        { "AUD", "A$" },
        { "KES", "KSh" }
    };

    long amountCents;
    string mpesaPhone = "";
    string message = "";
    string currency = "USD";
    string failure_message = "";
    string success_message = "";

    // For PayPal script load
    string paypalClientId => PayPalOpts.ClientId;

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        donation = await context.Donation.FirstOrDefaultAsync(d => d.Id == Id);
        appointment = await context.Appointment.FirstOrDefaultAsync(a => a.Id == AptId);
        if (donation is not null)
        {
            amountCents = (long)(donation.Amount * 100);
            if (donation.Total == 0)
            {
                donation.Total = donation.Amount + donation.ProcessingFee;
                context.Attach(donation).State = EntityState.Modified;
                await context.SaveChangesAsync();
            }
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var donation = await context.Donation.FirstOrDefaultAsync(d => d.Id == Id);
            if (donation is not null)
                amountCents = (long)(donation.Amount * 100);

            // Import the module once
            paymentModule = await JS.InvokeAsync<IJSObjectReference>("import", "/payment.min.js");

            // Initialize Stripe and keep the returned session reference
            if (paymentModule is not null && donation is not null)
            {
                stripeSession = await paymentModule.InvokeAsync<IJSObjectReference>(
                "initStripePayment", amountCents, donation.Currency, donation.Email);
            }
            StateHasChanged();
        }
    }

    async Task ConfirmStripe()
    {
        if (stripeSession is null) return;

        isProcessing = true;
        var result = await stripeSession.InvokeAsync<PaymentResult>("submit");

        if (!result.Success && !string.IsNullOrEmpty(result.Error.ToString()))
        {
            NavigationManager.NavigateTo($"/payment-unsuccessful?message={result.Error}");
        }
        else
        {
            message = "Payment confirmed!";
            Payment = new Payment
            {
                Name = donation?.Name,
                InvoiceNumber = donation?.InvoiceNumber,
                Email = donation?.Email,
                Amount = donation?.Amount ?? 0,
                Total = donation?.Total ?? 0,
                Currency = donation?.Currency,
                ProcessingFee = donation?.ProcessingFee ?? 0,
                CentsAmount = amountCents,
                PaymentMethod = "Stripe"
            };

            using var context = DbFactory.CreateDbContext();
            context.Payment.Add(Payment);
            await context.SaveChangesAsync();
            Cache.TryGetValue("ClientAppointmentEmailSent", out var clientAppointmentEmailSent);
            if (clientAppointmentEmailSent is null)
            {
                var ClientEmailSent = await Cache.GetOrCreateAsync("ClientAppointmentEmailSent", async entry =>
                {
                    entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(30);
                    var client_email_sent = true;
                    return client_email_sent;
                });
                var ManagementEmailSent = await Cache.GetOrCreateAsync("ManagementAppointmentEmailSent", async entry =>
                {
                    entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(30);
                    var management_email_sent = true;
                    return management_email_sent;
                });
                await EmailSender.SendClientAppointmentEmailAsync(appointment);
                await EmailSender.SendManagementEmailAsync(appointment);
            }
            Cache.TryGetValue("ClientPaymentEmailSent", out var clientPaymentEmailSent);
            if (clientPaymentEmailSent is null)
            {
                var ClientPaymentEmailSent = await Cache.GetOrCreateAsync("ClientPaymentEmailSent", async entry =>
                {
                    entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(30);
                    var client_payment_email_sent = true;
                    return client_payment_email_sent;
                });
                await EmailSender.SendClientPaymentEmailAsync(Payment);
            }
            NavigationManager.NavigateTo($"/payment-confirmation?Id={Payment.Id}&AptId={AptId}");
        }
        isProcessing = false;

    }

    async Task SendStkPush()
    {
        isProcessing = true;
        var response = await HttpClient.PostAsJsonAsync("/api/mpesa/stkpush", new { phone = mpesaPhone, amount = donation.Total });

        if (response.IsSuccessStatusCode)
        {
            message = response.IsSuccessStatusCode ? "STK push sent. Check your phone." : "Failed to send STK push.";
            success_message = response.IsSuccessStatusCode ? "STK push sent. Check your phone." : null;
            // ✅ Redirect after backend confirms payment
            NavigationManager.NavigateTo($"/payment-confirmation?Id={Payment.Id}");
        }
        else
        {
            failure_message = response.IsSuccessStatusCode ? null : "Failed to send STK push.";
            NavigationManager.NavigateTo($"/payment-unsuccessful?message={failure_message}");
        }
        isProcessing = false;

    }
    public void HandleInvalidSubmit()
    {
        
    }
    async Task SelectMethod(PaymentMethod method)
    {
        selected = method;
        if (selected == PaymentMethod.PayPal)
        {
            // Call your exported function
            await paymentModule.InvokeVoidAsync("renderPayPal", (double)donation.Amount, donation.Currency);
        }
        message = "";
        StateHasChanged();
    }
    public class PaymentResult
    {
        public bool Success { get; set; }
        public object? Error { get; set; }
    }
    public class PayByMpesaDTO
    {
        public string MpesaPhone { get; set; }
    }
}