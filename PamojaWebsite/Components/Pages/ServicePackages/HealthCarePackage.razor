@page "/services/health-care-package"

<PageTitle>Health Care Package</PageTitle>

@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS

@rendermode InteractiveServer
<div class="container-xxxl">
        <!-- Banner Section -->
        <section class="relative bg-green-900 text-white py-2 px-4 sm:px-6 lg:px-8 overflow-hidden">
            <!-- Decorative background shapes -->
            <div class="absolute inset-0">
                <!-- Large blurred gradient blob -->
                <div class="absolute -top-32 -left-32 w-96 h-96 bg-gradient-to-r from-green-600 to-blue-800 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>

                <!-- Smaller accent circle -->
                <div class="absolute top-20 right-20 w-40 h-40 bg-green-700 rounded-full opacity-30 animate-bounce"></div>

                <!-- Diagonal rectangle -->
                <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-green-800 opacity-40 transform rotate-12"></div>

                <!-- Triangle using clip-path -->
                <div class="absolute top-1/2 right-0 w-64 h-64 bg-blue-900 opacity-30"
                     style="clip-path: polygon(0 0, 100% 0, 0 100%);">
                </div>
            </div>

            <!-- Content -->
        <div class="relative max-w-7xl mx-auto">
            <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
                <h1 class="text-4xl mt-5 md:text-5xl font-bold mb-2">Health Care Package</h1>
            </div>
        </div>
        </section>
        <!-- Breadcrumb Section-->
        <section class="py-10">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Breadcrumb -->
                <nav class="flex items-center text-sm text-gray-600" aria-label="Breadcrumb">
                    <ol class="inline-flex items-center space-x-1 md:space-x-3">
                        <!-- About Us -->
                        <li class="inline-flex items-center">
                            <a href="/services"
                               class="inline-flex items-center text-green-700 hover:text-green-800 font-medium">
                                Services
                            </a>
                        </li>

                        <!-- Separator -->
                        <li>
                            <div class="flex items-center">
                                <svg class="w-4 h-4 text-gray-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd"
                                          d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                          clip-rule="evenodd" />
                                </svg>
                                <a href="/services/health-care-package"
                                   class="ml-1 text-green-700 hover:text-green-800 font-medium font-bold">
                                    Health Care Package
                                </a>
                            </div>
                        </li>
                    </ol>
                </nav>
            </div>
        </section>
    <!-- About Section -->
    <section class="py-10 bg-white">
        <div class="container mx-auto px-6">
            <div class="max-w-4xl mx-auto">
                <div class="prose prose-lg max-w-none">
                    <p class="text-xl md:text-2xl opacity-90 leading-relaxed">
                        Strengthening Kenya's healthcare professionals through clinical training and confidential safeguarding support.
                        By aligning with the Mental Health Act 2022 and national priorities, we ensure healthcare professionals are equipped, protected,
                        and empowered because caring for carers means building a stronger, healthier, and more resilient Kenya.
                    </p>
                    <button type="button" class="mt-3 btn bg-green-800 hover:bg-green-900 text-white font-bold py-3 px-6 rounded-lg transition duration-300 inline-flex items-center"
                            @onclick="ScrollToTarget">
                        Get Started
                        <i data-feather="arrow-right" class="ml-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>
    <!-- Art Section-->
    <section class="relative bg-primary-100 text-gray-900 py-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
        <!-- Decorative background shapes -->
        <div class="absolute inset-0">
            <!-- Gradient blob -->
            <div class="absolute -top-24 -left-24 w-96 h-96 bg-gradient-to-tr from-green-300 to-blue-400 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>

            <!-- Accent circle -->
            <div class="absolute bottom-10 right-10 w-48 h-48 bg-green-200 rounded-full opacity-30 animate-bounce"></div>

            <!-- Diagonal rectangle -->
            <div class="absolute top-1/3 left-1/2 w-72 h-72 bg-blue-200 opacity-40 transform rotate-12"></div>
        </div>

        <!-- Content -->
        <div class="relative max-w-7xl mx-auto grid md:grid-cols-3 gap-12 items-center">
            <!-- Image overlay -->
            <div class="relative">
                <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/08729196-ff49-4901-a747-1457caab553a/unsplash-image-hgD5IfjyIt8.jpg"
                     alt="Happy black female doctor holding a stethoscope"
                     class="relative z-10 rounded-lg shadow-lg">
            </div>
            <div class="relative">
                <img src="Images/Art/close-up-team-hand-shake.jpg" alt="Close up of a team handshake"
                     class="relative z-10 rounded-lg shadow-lg" />
            </div>
            <div class="relative">
                <img src="Images/Art/happy-black-female-doctor.jpg"
                     alt="Happy black female doctor"
                     class="relative z-10 rounded-lg shadow-lg">
            </div>
        </div>
    </section>
    @* <!-- Hero Section -->
    <section class="relative bg-primary-600 text-gray-700 py-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
                <div>
                    <h1 class="text-4xl md:text-5xl font-bold mb-6">Health Care Package</h1>
                    <p class="text-xl mb-8">
                        Strengthening Kenya's healthcare professionals through clinical training and confidential safeguarding support.
                        By aligning with the Mental Health Act 2022 and national priorities, we ensure healthcare professionals are equipped, protected, 
                        and empowered because caring for carers means building a stronger, healthier, and more resilient Kenya.
                    </p>
                    <button type="button" class="btn bg-gray-100 hover:bg-gray-200 hover:text-green-600 text-green-500 font-bold py-3 px-6 rounded-lg transition duration-300 inline-flex items-center"
                            @onclick="ScrollToTarget">
                        Get Started
                        <i data-feather="arrow-right" class="ml-2"></i>
                    </button>
                </div>
                <div class="mt-10 md:mt-0">
                    <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/08729196-ff49-4901-a747-1457caab553a/unsplash-image-hgD5IfjyIt8.jpg" alt="Mental Health Support" class="rounded-lg shadow-2xl">
                </div>
            </div>
        </div>
    </section> *@

    <!-- Services Section -->
    <section id="services" class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Our Comprehensive Services</h2>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Service Card 1 -->
                <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition duration-300">
                    <div class="p-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-green-100 p-3 rounded-full mr-4">
                                <i data-feather="refresh-cw" class="text-green-600 w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900">Clinical Supervision & Reflective Practice</h3>                      
                        </div>
                        <div>
                            <p class="mb-3">
                                Essential for staff wellbeing, professional accountability, learning, and service safety.
                            </p>
                        </div>
                        <ul class="space-y-2 text-gray-600">
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Strengthen understanding of clinical supervision and reflective practice</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Provide structured models and frameworks</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Develop practical skills to engage in and facilitate supervision</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Promote a culture of learning and emotional safety</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Improve supervision quality, consistency, and impact across teams</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Service Card 2 -->
                <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition duration-300">
                    <div class="p-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-green-100 p-3 rounded-full mr-4">
                                <i data-feather="shield" class="text-green-600 w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900">Safeguarding Training</h3>
                        </div>
                        <div>
                            <p class="mb-3">
                                Safeguarding training Levels 1-4 aligned with national guidance on Violence Against Children.
                            </p>
                        </div>
                    
                        <ul class="space-y-2 text-gray-600">
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Identify signs, indicators, and patterns of abuse and neglect</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Understand your legal duties and thresholds for intervention</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Work with safeguarding procedures across child and adult services</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Make appropriate referrals and record concerns</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Manage complex or multi-agency safeguarding cases</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Ensure compliance with statutory and regulatory safeguarding framework</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Service Card 3 -->
                <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition duration-300">
                    <div class="p-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-green-100 p-3 rounded-full mr-4">
                                <i data-feather="file-text" class="text-green-600 w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900">Consent & Confidentiality</h3>
                        </div>
                        <div>
                            <p class="mb-3">
                                Enhancing clinical decision-making and rights-based care.
                            </p>
                        </div>
                        <!-- Consent -->
                        <div class="flex items-start">
                            <h4 class="mb-1 font-semibold text-gray-900">Consent – Adults and Children: </h4>
                        </div>
                        <ul class="space-y-2 text-gray-600">
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Define informed, voluntary, and specific consent</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Assess mental capacity under the Mental Health Act (Amended 2022)</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Navigate consent with children and young people (Gillick competence, Fraser guidelines)</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Address issues of coercion, distress, or fluctuating capacity</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Respond to refusal of treatment and advance decisions</span>
                            </li>
                        </ul>
                        <!-- Confidentiality -->
                        <div class="flex items-start">
                            <h4 class="mt-3 mb-1 font-semibold text-gray-900">Confidentiality: </h4>
                        </div>
                        <ul class="list-disc space-y-2 text-gray-600">
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Define informed, voluntary, and specific consent</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Assess mental capacity under the Mental Health Act (Amended 2022)</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Navigate consent with children and young people (Gillick competence, Fraser guidelines)</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Address issues of coercion, distress, or fluctuating capacity</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Respond to refusal of treatment and advance decisions</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Service Card 4 -->
                <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition duration-300">
                    <div class="p-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-green-100 p-3 rounded-full mr-4">
                                <i data-feather="heart" class="text-green-600 w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900">Trauma Informed Care</h3>
                        </div>
                        <div>
                            <p class="mb-3">
                                Delivering safe, compassionate, and person-centred care.
                            </p>
                        </div>
                        <ul class="space-y-2 text-gray-600">
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Understand neurobiology of trauma and its impact on mental health</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Recognise signs of trauma in behaviour, communication, and relationships</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Apply core principles of trauma-informed care</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Adjust clinical interventions to avoid re-traumatisation</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Promote emotional regulation and relational safety</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Work with individuals who have experienced abuse, neglect, violence, or complex trauma</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Foster a trauma-informed team and organisational culture</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Service Card 5 -->
                <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition duration-300">
                    <div class="p-6">
                        <div class="flex items-center mb-4">
                            <div class="bg-green-100 p-3 rounded-full mr-4">
                                <i data-feather="briefcase" class="text-green-600 w-6 h-6"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900">Forensic Mental Health</h3>
                        </div>
                        <div>
                            <p class="mb-3">
                                Bridging mental health care with criminal justice awareness.
                            </p>
                        </div>
                        <ul class="space-y-2 text-gray-600">
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Understand the role and responsibilities of forensic mental health practitioners</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Apply key legal frameworks including Mental Health Act</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Assess and manage violence risk, self-harm, and offending behaviour</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Work within secure environments (low, medium, high secure units)</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Build safe, respectful therapeutic relationships with forensic patients</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Understand rehabilitation and community re-integration for forensic patients</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Understand the impact of trauma, neurodiversity, and personality disorder in forensic settings</span>
                            </li>
                            <li class="flex items-start">
                                <i data-feather="check" class="text-secondary-500 mr-2 mt-1 w-4 h-4"></i>
                                <span>Navigate multi-agency working (e.g. criminal justice, probation, police, social care)</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Get Started With Our Health Care Package</h2>

            <div class="bg-white p-8 rounded-xl shadow-md">
                <form class="space-y-6">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Your Name</label>
                            <input type="text" id="name" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                        </div>
                        <div>
                            <label for="school" class="block text-sm font-medium text-gray-700 mb-1">School/Organization</label>
                            <input type="text" id="school" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                        </div>
                        <div>
                            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                            <input type="email" id="email" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                        </div>
                        <div>
                            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                            <input type="tel" id="phone" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                        </div>
                    </div>
                    <div>
                        <label for="program" class="block text-sm font-medium text-gray-700 mb-1">Program of Interest</label>
                        <select id="program" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                            <option value="">Select a program</option>
                            <option value="primary">Clinical Supervision & Reflective Practice Program</option>
                            <option value="secondary">Safeguarding Training Program</option>
                            <option value="university">Consent & Confidentiality Program</option>
                            <option value="staff">Trauma Informed Care Program</option>
                            <option value="parents">Forensic Mental Health Program</option>
                        </select>
                    </div>
                    <div>
                        <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
                        <textarea id="message" rows="4" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500"></textarea>
                    </div>
                    <div>
                        <button type="submit" class="w-full bg-green-800 hover:bg-green-900 text-white font-bold py-3 px-6 rounded-md transition duration-300">
                            Request Information
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("featherInit");
        }
    }
    private async Task ScrollToTarget()
    {
        await JS.InvokeVoidAsync("scrollToSection", "contact");
    }

}
