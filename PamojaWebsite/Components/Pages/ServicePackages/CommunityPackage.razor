@page "/services/community-package"

<PageTitle>Community Package</PageTitle>

@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="container-xxxl">
    <!-- Hero Section -->
    <section class="relative bg-green-900 text-white py-2 px-4 sm:px-6 lg:px-8 overflow-hidden">
        <!-- Decorative background shapes -->
        <div class="absolute inset-0">
            <!-- Large blurred gradient blob -->
            <div class="absolute -top-32 -left-32 w-96 h-96 bg-gradient-to-r from-green-600 to-blue-800 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>

            <!-- Smaller accent circle -->
            <div class="absolute top-20 right-20 w-40 h-40 bg-green-700 rounded-full opacity-30 animate-bounce"></div>

            <!-- Diagonal rectangle -->
            <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-green-800 opacity-40 transform rotate-12"></div>

            <!-- Triangle using clip-path -->
            <div class="absolute top-1/2 right-0 w-64 h-64 bg-blue-900 opacity-30"
                 style="clip-path: polygon(0 0, 100% 0, 0 100%);">
            </div>
        </div>

        <!-- Content -->
        <div class="relative max-w-7xl mx-auto">
            <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
                    <h1 class="text-4xl mt-5 md:text-5xl font-bold mb-2">Community Package</h1>
            </div>
        </div>
    </section>
    <!-- Breadcrumb Section-->
    <section class="py-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Breadcrumb -->
            <nav class="flex items-center text-sm text-gray-600" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <!-- About Us -->
                    <li class="inline-flex items-center">
                        <a href="/services"
                           class="inline-flex items-center text-green-700 hover:text-green-800 font-medium">
                            Services
                        </a>
                    </li>

                    <!-- Separator -->
                    <li>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 text-gray-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                      d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                      clip-rule="evenodd" />
                            </svg>
                            <a href="/services/community-package"
                               class="ml-1 text-green-700 hover:text-green-800 font-medium font-bold">
                                Community Package
                            </a>
                        </div>
                    </li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- About Section -->
    <section class="py-10 bg-white">
        <div class="container mx-auto px-6">
            <div class="max-w-4xl mx-auto">
                <div class="prose prose-lg max-w-none">
                    <p class="text-xl md:text-2xl opacity-90 leading-relaxed">
                        At Pamoja, our community engagement is rooted in empathy, unity, and a shared vision of mental wellness.
                    </p>
                    <p class="text-gray-700 text-lg leading-relaxed mt-4 mb-8">
                        Working together to create <span class="text-emerald-600">safer, healthier,</span> and thriving communities
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Art Section-->
    <section class="relative bg-primary-100 text-gray-900 py-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
        <!-- Decorative background shapes -->
        <div class="absolute inset-0">
            <!-- Gradient blob -->
            <div class="absolute -top-24 -left-24 w-96 h-96 bg-gradient-to-tr from-green-300 to-blue-400 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>

            <!-- Accent circle -->
            <div class="absolute bottom-10 right-10 w-48 h-48 bg-green-200 rounded-full opacity-30 animate-bounce"></div>

            <!-- Diagonal rectangle -->
            <div class="absolute top-1/3 left-1/2 w-72 h-72 bg-blue-200 opacity-40 transform rotate-12"></div>
        </div>

        <!-- Content -->
        <div class="relative max-w-7xl mx-auto grid md:grid-cols-3 gap-12 items-center">
            <!-- Image overlay -->
            <div class="relative">
                <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1756065844575-FYR6STBPIGWC8VPZKJAJ/unsplash-image-0cgpyigyIkM.jpg" 
                     alt="Mental Health Support"
                     class="relative z-10 rounded-lg shadow-lg" />
            </div>

            <div class="relative">
                <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1754160313094-Y5OGVPY6FLED9SOMHDW3/unsplash-image-KfoNVMCFb5M.jpg"
                     alt="Women's group meeting"
                     class="relative z-10 rounded-lg shadow-lg">
            </div>
            <div class="relative">
                <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1754158406744-QWTCN0L0P24ZS2GGNYKN/unsplash-image-2EGNqazbAMk.jpg"
                     alt="Men's group discussion"
                     class="relative z-10 rounded-lg shadow-lg">
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-white">
        <div class="container mx-auto px-6">
            <div class="max-w-4xl mx-auto">
                <div class="prose prose-lg max-w-none">
                    <p class="text-gray-700 text-lg leading-relaxed mt-4 mb-8">
                        Partnering with community organisations to educate and empower through safeguarding practices...
                        Supporting individuals who have experienced abuse and gender based violence and other vulnerable groups.
                    </p>
                </div>
            </div>
        </div>
    </section>

    @* <!-- About Section -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Our Mission</h2>
            <p class="text-lg mb-8">
                Working together to create <span class="text-emerald-600">safer, healthier,</span> and thriving communities
            </p>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 lg:px-8">
            <div class="flex flex-col md:flex-row items-center mb-16 gap-16">
                <div class="md:w-1/2 order-2 md:order-1">
                    <h2 class="text-3xl font-bold text-gray-800 mb-6">Partnering with Women's Groups</h2>
                    <p class="text-gray-600 mb-6">
                        Women's groups in Kenya are powerful drivers of community healing, empowerment, and family wellbeing. We are committed to walking alongside these groups, supporting their leadership and amplifying their voices.
                    </p>
                    <ul class="space-y-3 mb-6">
                        <li class="flex items-start">
                            <i data-feather="check-circle" class="text-emerald-500 mr-2 mt-1"></i>
                            <span class="text-gray-600">Building trust-based collaborations that honour women's lived experiences</span>
                        </li>
                        <li class="flex items-start">
                            <i data-feather="check-circle" class="text-emerald-500 mr-2 mt-1"></i>
                            <span class="text-gray-600">Strengthening mental health awareness and trauma-informed care</span>
                        </li>
                        <li class="flex items-start">
                            <i data-feather="check-circle" class="text-emerald-500 mr-2 mt-1"></i>
                            <span class="text-gray-600">Supporting community-led safeguarding solutions that protect women, girls, and families.</span>
                        </li>
                        <li class="flex items-start">
                            <i data-feather="check-circle" class="text-emerald-500 mr-2 mt-1"></i>
                            <span class="text-gray-600">Amplifying women's leadership in mental health initiatives and protection initiatives</span>
                        </li>
                    </ul>
                    <blockquote class="border-l-4 border-emerald-500 pl-4 italic text-gray-700">
                        "When women are supported, entire communities thrive."
                    </blockquote>
                </div>
                <div class="md:w-1/2 order-1 md:order-2">
                    <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1754160313094-Y5OGVPY6FLED9SOMHDW3/unsplash-image-KfoNVMCFb5M.jpg"
                         alt="Women's group meeting"
                         class="rounded-xl shadow-lg w-full h-auto">
                </div>
            </div>
        </div>
    </section>
    <!-- Services Section -->
    <section id="services" class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 lg:px-8">
            <div class="flex flex-col md:flex-row items-center mb-16 gap-16">
                <div class="md:w-1/2">
                    <h2 class="text-3xl font-bold text-gray-800 mb-6">Partnering with Men's Groups</h2>
                    <p class="text-gray-600 mb-6">
                        Men's groups are vital to fostering positive masculinity, mentorship, and mental wellbeing. We work with men's groups to break stigma,
                        promote healing, and create safer spaces for everyone.
                    </p>
                    <ul class="space-y-3 mb-6">
                        <li class="flex items-start">
                            <i data-feather="check-circle" class="text-emerald-500 mr-2 mt-1"></i>
                            <span class="text-gray-600">Creating safe spaces for open conversations on mental health, identity, and trauma</span>
                        </li>
                        <li class="flex items-start">
                            <i data-feather="check-circle" class="text-emerald-500 mr-2 mt-1"></i>
                            <span class="text-gray-600">Supporting mentorship and leadership programmes that encourage responsibility and empathy</span>
                        </li>
                        <li class="flex items-start">
                            <i data-feather="check-circle" class="text-emerald-500 mr-2 mt-1"></i>
                            <span class="text-gray-600">Equipping groups with mental health tools</span>
                        </li>
                        <li class="flex items-start">
                            <i data-feather="check-circle" class="text-emerald-500 mr-2 mt-1"></i>
                            <span class="text-gray-600">Collaborating on safeguarding strategies promote respectful and safe relationships</span>
                        </li>
                    </ul>
                    <blockquote class="border-l-4 border-emerald-500 pl-4 italic text-gray-700">
                        "When men are supported to heal and lead positively, families and communities grow stronger."
                    </blockquote>
                </div>
                <div class="md:w-1/2">
                    <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1754158406744-QWTCN0L0P24ZS2GGNYKN/unsplash-image-2EGNqazbAMk.jpg"
                         alt="Men's group discussion"
                         class="rounded-xl shadow-lg w-full h-auto">
                </div>
            </div>
        </div>
    </section> *@

    <!-- Contact Section -->
    <section id="contact" class="py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
        <div class="max-w-4xl mx-auto">
            <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Join Our Movement</h2>
            <p class="text-xl mb-6 max-w-3xl mx-auto">
                For more information on how we can support your community, please contact us:
            </p>
            <div class="bg-white p-8 rounded-xl shadow-md">
                <form class="space-y-6">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Your Name</label>
                            <input type="text" id="name" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                        </div>
                        <div>
                            <label for="school" class="block text-sm font-medium text-gray-700 mb-1">School/Organization</label>
                            <input type="text" id="school" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                        </div>
                        <div>
                            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                            <input type="email" id="email" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                        </div>
                        <div>
                            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                            <input type="tel" id="phone" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500">
                        </div>
                    </div>
                    <div>
                        <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
                        <textarea id="message" rows="4" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500"></textarea>
                    </div>
                    <div>
                        <button type="submit" class="w-full bg-green-800 hover:bg-green-900 text-white font-bold py-3 px-6 rounded-md transition duration-300">
                            Request Information
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("featherInit");
        }
    }
    private async Task ScrollToTarget()
    {
        await JS.InvokeVoidAsync("scrollToSection", "contact");
    }

}


