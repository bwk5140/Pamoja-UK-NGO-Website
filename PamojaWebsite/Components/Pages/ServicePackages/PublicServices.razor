                        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
                            <div class="p-6">
                                <div class="flex items-center mb-4">
                                    <div class="bg-red-200 p-3 rounded-full mr-4">
                                        <i data-feather="globe" class="text-red-600"></i>
                                    </div>
                                    <h3 class="text-xl font-bold text-gray-900">Culturally Sensitive Interventions</h3>
                                </div>
