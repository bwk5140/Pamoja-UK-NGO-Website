@page "/services/book-appointment"

<PageTitle>Book Appointment | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@using RestSharp
@inject HttpClient httpClient
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
<script>
    function loadGA() {
      if (window.gaLoaded) return;
      window.gaLoaded = true;

      var script = document.createElement('script');
      script.src = "https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG";
      script.async = true;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'pamojasafeguardingnetwork.co.uk', 'anonymize_ip': true});
    }

    // Fire when browser is idle or after first interaction
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => setTimeout(loadGA, 2000));
    } else {
      setTimeout(loadGA, 3000);
    }
</script>

@rendermode InteractiveServer


<div class="sm:pt-[10%] md:pt-[4%] mb-5 py-20">
    <div class="container-xxxl">
        <!-- Banner Section -->
        <section class="relative py-20 mt-5 bg-green-900 text-white py-2 px-4 sm:px-6 lg:px-8 overflow-hidden">
            <div class="absolute inset-0">
                <img loading="lazy" alt="Banner image" class="relative object-cover object-top md:h-64 md:w-full sm:h-full" src="https://res.cloudinary.com/dzmfpxcwu/image/upload/v1771133161/tree_mullks.jpg" />
            </div>

            <!-- Content -->
            <div class="relative max-w-7xl mx-auto">
                <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
                    <h1 class="text-4xl mt-5 md:text-5xl font-bold mb-2">Custom Package Solutions</h1>
                </div>
            </div>
        </section>

        <!-- Breadcrumb Section-->
        <div class="py-10">
            <section class="py-10">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <!-- Breadcrumb -->
                    <nav class="flex items-center text-sm text-gray-600" aria-label="Breadcrumb">
                        <ol class="inline-flex items-center space-x-1 md:space-x-3">
                            <!-- About Us -->
                            <li class="inline-flex items-center">
                                <a href="/services"  aria-label="Navigate to services"
                                   class="inline-flex items-center text-green-700 hover:text-green-800 font-medium">
                                    Services
                                </a>
                            </li>

                            <!-- Separator -->
                            <li>
                                <div class="flex items-center">
                                    <svg aria-label="Separator" class="w-4 h-4 text-gray-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd"
                                              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                              clip-rule="evenodd" />
                                    </svg>
                                    <a href="/services/book-appointment"  aria-label="Navigate to book appointment page"
                                       class="ml-1 text-green-700 hover:text-green-800 font-medium font-bold">
                                        Book an Appointment
                                    </a>
                                </div>
                            </li>
                        </ol>
                    </nav>
                </div>
            </section>

            <section class="bg-white py-12 px-6 md:max-w-4xl sm:max-w-5xl mx-auto">
                <h1 class="text-3xl font-bold text-center mb-4">Book an Appointment</h1>
                <p class="text-center font-bold text-lg mb-3">Limited 20-minute Consultations Now Available</p>
                <p class="text-center text-lg mb-6">
                    Please book your 20 minute consultation designed to assess your needs and determine the most appropriate service package for your objectives.
                    This consultation provides an opportunity for an open and thoughtful discussion about your goals and how we can best support them.
                    Availability is limited, and appointments are scheduled on a first-come, first-served basis.
                </p>
                <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
                    <h1 class="text-l font-bold text-center mt-4 mb-4">Book an Appointment</h1>
                    <div class="bg-white p-6 rounded-lg shadow-md w-full">
                        <div class="flex flex-col md:flex-row">
                            <div class="mb-3 mt-3">
                                <img loading="lazy" src="Images/PamojaLogo.webp"
                                     width="200"
                                     height="200" 
                                    alt="Pamoja logo"/>
                            </div>
                            <div class="mb-3 mt-3">
                                <p class="font-bold text-lg mb-6">
                                    Consultation with Pamoja Mental Health and Safeguarding Team
                                </p>
                                <p class="text-lg mb-6">
                                    20 minutes
                                </p>
                            </div>
                        </div>
                    </div>
                    @if (dateProblem)
                    {
                        <div class="mt-2 mb-2 w-full text-red-700 border-l-4 border-red-700 bg-red-100">
                            <div class="p-4 flex items-center space-x-2">
                                <img fetchpriority="high"
                                     loading="eager" src="icons/info-circle.svg" alt="Info circle icon" class="w-5 h-5" />
                                <span class="text-sm">Bookings can only be done at least 1 day in advance and they should be for a weekday</span>
                            </div>
                        </div>
                    }
                    @if (!PaymentImplemented)
                    {
                        <div class="mt-2 mb-2 w-full text-green-700 border-l-4 border-green-700 bg-gray-100">
                            <div class="p-4 flex items-center space-x-2">
                                <img fetchpriority="high"
                                     loading="eager" src="icons/info-circle.svg" alt="Info circle icon" class="w-5 h-5" />
                                <span class="text-sm">Bookings will become available soon. Please bear with us as we work on making these services available.</span>
                            </div>
                        </div>
                    }
                    <div class="flex flex-col md:flex-row gap-8 py-10">
                        <div class="w-full md:w-1/2 ">
                            @if (SelectedDay is not null)
                            {
                                <Calendar>
                                    <DayTemplate Context="day">
                                        @{
                                            bool isSelected = SelectedDay.Date == day.Date;
                                            bool isToday = DateOnly.FromDateTime(day.Date) == DateOnly.FromDateTime(DateTime.Today);
                                            var SelectedClass = isSelected ? "bg-gradient-to-b from-green-800 to-green-700 text-white" : "";
                                            var TodayClass = isToday ? "bg-gradient-to-b from-green-100 to-green-200 text-gray-800" : "";
                                        }
                                        @if (day.IsInThisMonth && day.Date.DayOfWeek != DayOfWeek.Saturday && day.Date.DayOfWeek != DayOfWeek.Sunday)
                                        {
                                            if (day.Date >= DateTime.UtcNow && day.Date.Month >= DateTime.UtcNow.Month && day.Date.Year >= DateTime.UtcNow.Year)
                                            {
                                                <button disabled class="day p-2 md:p-4 cursor-pointer text-center @SelectedClass @TodayClass"
                                                        @onclick="(() => SelectDate(day, currentDay))">
                                                    @day.Day
                                                </button>
                                            }
                                            else
                                            {
                                                <button disabled class="day p-2 md:p-4" style="background-color: transparent; color:darkgrey;">
                                                    @day.Day
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <button disabled class="day p-2 md:p-4" style="background-color: transparent; color:darkgrey;">
                                                @day.Day
                                            </button>
                                        }
                                    </DayTemplate>
                                </Calendar>

                            }
                        </div>
                        <div class="md:w-1/2 flex flex-col mx-auto">
                            <p class="font-bold text-lg text-gray-800 mb-3">
                                @SelectedDay.Date.DayOfWeek, @getMonth(SelectedDay.Date.Month) @SelectedDay.Date.Day
                            </p>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                                @foreach (var time in TimeSlots)
                                {
                                    bool isSelected = SelectedTime == time;
                                    <div class="">
                                        <button disabled class="px-4 py-1 border border-gray-300 rounded-md bg-gray-100 text-nowrap cursor-pointer hover:bg-gray-200
                                                            disabled:bg-gray-300 disabled:cursor-default
                                                        @(isSelected ? "bg-gradient-to-b from-green-800 to-green-700 text-nowrap text-white border-blue-600" : "")"
                                                @onclick="(() => SelectTime(time))">
                                            @time.ToString("hh:mm tt")
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@code {
    private List<DateTime> TimeSlots = new();
    private DateTime SelectedTime;

    [Parameter]
    public string currentDay { get; set; }

    [Parameter]
    public bool dateProblem { get; set; }

    [Parameter]
    public bool PaymentImplemented { get; set; }

    [Parameter]
    public CalendarDay SelectedDay { get; set; }

    [Parameter]
    public string? Month { get; set; }
    private DateTime dateToday = DateTime.UtcNow.Date;

    protected override void OnInitialized()
    {
        PaymentImplemented = false;
        currentDay = "today";
        SelectedDay = new CalendarDay();
        SelectedDay.Date = DateTime.UtcNow;
        var start = DateTime.Today.AddHours(9);   // 9 AM
        var end = DateTime.Today.AddHours(17);    // 5 PM
        for (var t = start; t <= end; t = t.AddMinutes(20))
        {
            if (t.Hour == 17)
                return;
            TimeSlots.Add(t);
        }
    }
    private string getMonth(int month)
    {
        switch (month)
        {
            case 1:
                Month = "January";
                break;
            case 2:
                Month = "February";
                break;
            case 3:
                Month = "March";
                break;
            case 4:
                Month = "April";
                break;
            case 5:
                Month = "May";
                break;
            case 6:
                Month = "June";
                break;
            case 7:
                Month = "July";
                break;
            case 8:
                Month = "August";
                break;
            case 9:
                Month = "September";
                break;
            case 10:
                Month = "October";
                break;
            case 11:
                Month = "November";
                break;
            case 12:
                Month = "December";
                break;
        }
        return Month;
    }
    private async void SelectTime(DateTime time)
    {
        if (SelectedDay.Date >= DateTime.UtcNow && SelectedDay.Date.Month >= DateTime.UtcNow.Month && SelectedDay.Date.Year >= DateTime.UtcNow.Year)
        {
            SelectedTime = time;
            Appointment appointment = new Appointment();
            appointment.Date = time;
            using var context = await DbFactory.CreateDbContextAsync();
            appointment.Amount = 2900;
            appointment.FirstName = "";
            appointment.Date = SelectedDay.Date.ToUniversalTime();
            appointment.Time = TimeOnly.FromDateTime(SelectedTime);
            appointment.LastName = "";
            appointment.Phone = "";
            appointment.Email = "";
            appointment.Message = "";
            appointment.Calendar = "";
            context.Appointment.Add(appointment);
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo($"/services/book-appointment/details?Id={appointment.Id}");
        }
        else
        {
            dateProblem = true;
        }
    }
    private async Task SelectDate(CalendarDay selectedDate, String CurrentDay)
    {
        if (selectedDate.Date >= DateTime.UtcNow && selectedDate.Date.Month >= DateTime.UtcNow.Month && selectedDate.Date.Year >= DateTime.UtcNow.Year)
        {
            dateProblem = false;
        }
        SelectedDay = selectedDate;
        CurrentDay = "";
        StateHasChanged();
    }
}
