@page "/careers/search"
@using Microsoft.Extensions.Caching.Memory
@using PamojaWebsite.Data.Contexts

<PageTitle>Search Careers | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
<script>
    function loadGA() {
      if (window.gaLoaded) return;
      window.gaLoaded = true;

      var script = document.createElement('script');
      script.src = "https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG";
      script.async = true;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'pamojasafeguardingnetwork.co.uk', 'anonymize_ip': true});
    }

    // Fire when browser is idle or after first interaction
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => setTimeout(loadGA, 2000));
    } else {
      setTimeout(loadGA, 3000);
    }
</script>

@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager NavManager
@inject IMemoryCache Cache
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject MyApiService ApiService

@rendermode InteractiveServer

<div class="sm:pt-[10%] md:pt-[4%] mb-5 py-20">
    <!-- Hero Section -->
    <section class="relative py-20 mt-5 bg-green-900 text-white py-2 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="absolute inset-0">
            <img loading="lazy" alt="Banner image" class="relative object-cover object-top md:h-64 md:w-full sm:h-full" src="https://res.cloudinary.com/dzmfpxcwu/image/upload/v1771133161/tree_mullks.jpg" />
    </div>

    <!-- Content -->
    <div class="relative max-w-7xl mx-auto">
        <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
            <h1 class="text-4xl mt-5 md:text-5xl font-bold mb-2">Search Careers</h1>
        </div>
    </div>
</section>

<section class="mb-16 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="flex items-center text-sm text-gray-600 mb-6" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <!-- About Us -->
                <li class="inline-flex items-center">
                    <a href="/careers"
                        aria-label="Navigate to careers"
                       class="inline-flex items-center text-secondary hover:text-gray-800 font-medium">
                        Careers
                    </a>
                </li>

                <!-- Separator -->
                <li>
                    <div class="flex items-center">
                            <svg aria-label="Separator" class="w-4 h-4 text-gray-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                  clip-rule="evenodd" />
                        </svg>
                        @if (!string.IsNullOrWhiteSpace(role))
                        {
                            <a href="/careers/search/?role=@role"
                                aria-label="Navigate to search careers"
                               class="ml-1 text-secondary hover:text-gray-800 font-medium font-bold">
                                Search
                            </a>
                        }
                        else
                        {
                            <a href="/careers/search"
                                aria-label="Navigate to search careers"
                               class="ml-1 text-secondary hover:text-gray-800 font-medium font-bold">
                                Search
                            </a>
                        }
                    </div>
                </li>
            </ol>
        </nav>
        <h1 class="text-5xl font-bold text-gray-900 mb-6">
            Find your next job
        </h1>
    </div>
    <!-- Image + background art container -->
    <div class="relative w-full h-64">
        <!-- Background art layer -->
        <div class="absolute inset-0">
            <!-- Gradient blob -->
            <div class="absolute -top-24 -left-24 w-96 h-96 bg-gradient-to-tr from-green-300 to-blue-400 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <img fetchpriority="high"
                     loading="eager"
                     decoding="async"
                     src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1764053404132-QYCN6NRDWJ5KU4BC7EFC/unsplash-image-F2WX4BTIkpQ.jpg?format=webp&width=600"
                     alt="Start a career with us"
                     width="800" height="450"
                     class="w-full h-72 object-fit:fill relative z-10 rounded-lg shadow-lg">
        </div>
    </div>
</section>
<div class="max-w-7xl mx-auto px-4 py-15">
    <div class="flex flex-col lg:flex-row gap-8">
        <!-- Filter Card -->
        <div class="lg:w-1/4 bg-white shadow-md rounded-lg p-6">
            <h2 class="text-lg font-semibold mb-4">Filter Roles</h2>

            <!-- Hybrid and Remote -->
            <label class="block text-sm font-medium text-gray-700 mb-1">Work Type</label>
                <InputSelect @bind-Value="selectedWorkType" class="w-full mb-4 px-3 py-2 border border-gray-300 rounded-md">
                <option value="">All</option>
                <option value="Hybrid">Hybrid</option>
            </InputSelect>

            <!-- Field -->
            <label class="block text-sm font-medium text-gray-700 mb-1">Field</label>
                <InputSelect @bind-Value="selectedField" class="w-full mb-4 px-3 py-2 border border-gray-300 rounded-md">
                <option value="">All</option>
                @if (AvailableFields is not null)
                {
                    @foreach (var field in AvailableFields)
                    {
                        <option value="@field.Name">@field.Name</option>
                    }
                }
            </InputSelect>

            <!-- Experience Level -->
            <label class="block text-sm font-medium text-gray-700 mb-1">Experience Level</label>
                <InputSelect @bind-Value="selectedExperienceLevel" class="w-full mb-4 px-3 py-2 border border-gray-300 rounded-md">
                <option value="">All</option>
                @foreach (var level in ExperienceLevels)
                {
                    <option value="@level">@level</option>
                }
            </InputSelect>

            <!-- Location -->
            <label class="block text-sm font-medium text-gray-700 mb-1">Location</label>
                <InputSelect @bind-Value="selectedLocation" class="w-full mb-4 px-3 py-2 border border-gray-300 rounded-md">
                <option value="">All</option>
                @foreach (var location in AvailableLocations)
                {
                    <option value="@location">@location</option>
                }
            </InputSelect>

            <button @onclick="ApplySearch"
                    class="w-full mt-2 px-4 py-2 btn-primary text-white rounded-md hover:bg-blue-700">
                Apply Filters
            </button>
        </div>

        <!-- Results Column -->
        <div class="lg:w-3/4 flex flex-col gap-6">
            <!-- Job Cards Grid -->
            <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-6">
                @foreach (var job in FilteredJobs)
                {
                    <div class="bg-white shadow-md rounded-lg p-4">
                        <h3 class="text-lg font-semibold text-gray-800">@job.Name</h3>
                        <p class="text-sm text-gray-600">@job.Description</p>
                            @if (job.Expiration > DateTime.UtcNow)
                            {
                                <a href="@job.Link?Id=@job.Id" aria-label="View job details" class="text-blue-500 mt-2 inline-block">View Details →</a>
                            }
                            else
                            {
                                <a href="@job.Link?Id=@job.Id" aria-label="View job details" class="text-red-500 mt-2 inline-block">View Details →</a>
                            }
                        </div>
                }
            </div>
            @if (totalPages > 0)
            {
                <!-- Pagination Controls: Full Width -->
                <div class="mt-8 w-full flex justify-between items-center gap-2 mb-5">
                    <!-- Items per page -->
                    <div class="flex items-center gap-2">
                        <label class="text-sm font-medium text-gray-700">Items per page:</label>
                            <InputSelect @bind-Value="itemsPerPage" class="px-3 py-2 border border-gray-300 rounded-md">
                            @foreach (var size in pageSizeOptions)
                            {
                                <option value="@size">@size</option>
                            }
                        </InputSelect>
                    </div>

                    <!-- Page navigation -->
                    <div class="flex items-center gap-2">
                        <button @onclick="PreviousPage" disabled="@((currentPage == 1))"
                                class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300 disabled:opacity-50">
                            ← Prev
                        </button>

                        <span class="text-sm text-gray-700">Page @currentPage of @totalPages</span>

                        <button @onclick="NextPage" disabled="@((currentPage == totalPages))"
                                class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300 disabled:opacity-50">
                            Next →
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="mt-8 w-full flex justify-center items-center gap-2 mb-5">
                    <p>
                        There were no jobs found
                    </p>
                </div>
            }
        </div>

    </div>
</div>
</div>

@code {
    private string searchQuery = "";
    private string selectedWorkType = "";
    private string selectedField = "";
    private string selectedExperienceLevel = "";
    private string selectedLocation = "";
    private int currentPage = 1;
    private int itemsPerPage = 6;
    private List<int> pageSizeOptions = new() { 6, 12, 24 };
    private int totalPages = 1;

    private List<string> ExperienceLevels = new() { "Entry", "Mid", "Senior", "Lead" };
    private List<string> AvailableLocations = new() { "Nairobi", "Remote", "London", "New York", "Berlin" };
    private List<CareerField>? AvailableFields { get; set; }
    private List<CareerRole>? AvailableRoles { get; set; }
    private HashSet<string> SelectedFields = new();
    private List<CareerRole> AllJobs = new(); // Populate from DB or API
    private List<CareerRole> FilteredJobs = new();

    [Parameter]
    [SupplyParameterFromQuery]
    public string role { get; set; }


    protected override async Task OnInitializedAsync()
    {
        //Cache available roles for 30 minutes
        AvailableFields = await ApiService.GetHttpClient().GetFromJsonAsync<List<CareerField>>("api/Db/career-fields");
        AvailableRoles = await ApiService.GetHttpClient().GetFromJsonAsync<List<CareerRole>>("api/Db/career-roles");
        await LoadJobs();
    }

    private async Task ToggleRole(string role)
    {
        if (!SelectedFields.Add(role))
            SelectedFields.Remove(role);

        currentPage = 1;
        await LoadJobs();
    }
    private async Task LoadJobs()
    {
        totalPages = 1;
        // Work entirely from cached jobs
        var query = AvailableRoles?.AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
            query = query?.Where(job => job != null && !string.IsNullOrWhiteSpace(job.Name) && job.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

        if (SelectedFields.Count > 0)
            query = query?.Where(job => job != null && !string.IsNullOrWhiteSpace(job.Name) && SelectedFields.Contains(job.Name));

        if (!string.IsNullOrWhiteSpace(selectedWorkType))
            query = query?.Where(job => job.WorkType == selectedWorkType);

        if (!string.IsNullOrWhiteSpace(selectedField))
            query = query?.Where(job => job.CareerField == selectedField);

        if (!string.IsNullOrWhiteSpace(selectedExperienceLevel))
            query = query?.Where(job => job.ExperienceLevel == selectedExperienceLevel);

        if (!string.IsNullOrWhiteSpace(selectedLocation))
            query = query?.Where(job => job.Location == selectedLocation);

        if (!string.IsNullOrWhiteSpace(role))
            query = query?.Where(r => r.Name == role);

        if (query is not null){
            var count = query.Count();
            totalPages = (int)Math.Ceiling(count / (double)itemsPerPage);

            FilteredJobs = query
                .Skip((currentPage - 1) * itemsPerPage)
                .Take(itemsPerPage)
                .ToList();
        }
    }

    private async Task ApplySearch()
    {
        role = "";
        currentPage = 1;
        await LoadJobs();
        StateHasChanged();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadJobs();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadJobs();
        }
    }
}