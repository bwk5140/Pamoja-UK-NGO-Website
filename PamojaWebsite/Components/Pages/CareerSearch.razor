@page "/careers/search"
@using PamojaWebsite.Data.Contexts

<PageTitle>Careers</PageTitle>

@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager NavManager
@implements IAsyncDisposable
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

@rendermode InteractiveServer

<!-- Hero Section -->
<section class="relative bg-green-900 text-white py-2 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <!-- Decorative background shapes -->
    <div class="absolute inset-0">
        <!-- Large blurred gradient blob -->
        <div class="absolute -top-32 -left-32 w-96 h-96 bg-gradient-to-r from-green-600 to-blue-800 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>

        <!-- Smaller accent circle -->
        <div class="absolute top-20 right-20 w-40 h-40 bg-green-700 rounded-full opacity-30 animate-bounce"></div>

        <!-- Diagonal rectangle -->
        <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-green-800 opacity-40 transform rotate-12"></div>

        <!-- Triangle using clip-path -->
        <div class="absolute top-1/2 right-0 w-64 h-64 bg-blue-900 opacity-30"
             style="clip-path: polygon(0 0, 100% 0, 0 100%);">
        </div>
    </div>

    <!-- Content -->
    <div class="relative max-w-7xl mx-auto">
        <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
            <h1 class="text-4xl mt-5 md:text-5xl font-bold mb-2">Search Careers</h1>
        </div>
    </div>
</section>

<section class="mb-16 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="flex items-center text-sm text-gray-600 mb-6" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <!-- About Us -->
                <li class="inline-flex items-center">
                    <a href="/careers"
                       class="inline-flex items-center text-secondary hover:text-gray-800 font-medium">
                        Careers
                    </a>
                </li>

                <!-- Separator -->
                <li>
                    <div class="flex items-center">
                        <svg class="w-4 h-4 text-gray-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                  clip-rule="evenodd" />
                        </svg>
                        @if (!string.IsNullOrWhiteSpace(role))
                        {
                            <a href="/careers/search/?role=@role"
                               class="ml-1 text-secondary hover:text-gray-800 font-medium font-bold">
                                Search Careers
                            </a>
                        }
                        else
                        {
                            <a href="/careers/search"
                               class="ml-1 text-secondary hover:text-gray-800 font-medium font-bold">
                                Search Careers
                            </a>
                        }
                    </div>
                </li>
            </ol>
        </nav>
        <h1 class="text-5xl font-bold text-gray-900 mb-6">
            Find your next job
        </h1>
    </div>
    <!-- Image + background art container -->
    <div class="relative w-full h-64">
        <!-- Background art layer -->
        <div class="absolute inset-0">
            <!-- Gradient blob -->
            <div class="absolute -top-24 -left-24 w-96 h-96 bg-gradient-to-tr from-green-300 to-blue-400 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>

            @* <!-- Accent circle -->
            <div class="absolute bottom-10 right-10 w-48 h-48 bg-green-200 rounded-full opacity-30 animate-pulse"></div>

            <!-- Diagonal rectangle -->
            <div class="absolute top-1/3 left-1/2 w-72 h-72 bg-blue-200 opacity-40 transform rotate-12"></div> *@
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1764053404132-QYCN6NRDWJ5KU4BC7EFC/unsplash-image-F2WX4BTIkpQ.jpg?format=500w"
                 alt="Psychology professionals"
                 class="w-full h-72 object-fit:fill relative z-10 rounded-lg shadow-lg">
        </div>
    </div>
</section>
<div class="max-w-7xl mx-auto px-4 py-15">
    <div class="flex flex-col lg:flex-row gap-8">
        <!-- Filter Card -->
        <div class="lg:w-1/4 bg-white shadow-md rounded-lg p-6">
            <h2 class="text-lg font-semibold mb-4">Filter Roles</h2>

            <!-- Hybrid and Remote -->
            <label class="block text-sm font-medium text-gray-700 mb-1">Work Type</label>
            <InputSelect @bind-Value="selectedWorkType" class="w-full mb-4 px-3 py-2 border rounded-md">
                <option value="">All</option>
                <option value="Hybrid">Hybrid</option>
            </InputSelect>

            <!-- Field -->
            <label class="block text-sm font-medium text-gray-700 mb-1">Field</label>
            <InputSelect @bind-Value="selectedField" class="w-full mb-4 px-3 py-2 border rounded-md">
                <option value="">All</option>
                @if (AvailableRoles is not null)
                {
                    @foreach (var field in AvailableRoles)
                    {
                        <option value="@field">@field</option>
                    }
                }
            </InputSelect>

            <!-- Experience Level -->
            <label class="block text-sm font-medium text-gray-700 mb-1">Experience Level</label>
            <InputSelect @bind-Value="selectedExperienceLevel" class="w-full mb-4 px-3 py-2 border rounded-md">
                <option value="">All</option>
                @foreach (var level in ExperienceLevels)
                {
                    <option value="@level">@level</option>
                }
            </InputSelect>

            <!-- Location -->
            <label class="block text-sm font-medium text-gray-700 mb-1">Location</label>
            <InputSelect @bind-Value="selectedLocation" class="w-full mb-4 px-3 py-2 border rounded-md">
                <option value="">All</option>
                @foreach (var location in AvailableLocations)
                {
                    <option value="@location">@location</option>
                }
            </InputSelect>

            <button @onclick="ApplySearch"
                    class="w-full mt-2 px-4 py-2 btn-primary text-white rounded-md hover:bg-blue-700">
                Apply Filters
            </button>
        </div>

        <!-- Results Column -->
        <div class="lg:w-3/4 flex flex-col gap-6">
            <!-- Job Cards Grid -->
            <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-6">
                @foreach (var job in FilteredJobs.Skip((currentPage - 1) * itemsPerPage).Take(itemsPerPage))
                {
                    <div class="bg-white shadow-md rounded-lg p-4">
                        <h3 class="text-lg font-semibold text-gray-800">@job.Name</h3>
                        <p class="text-sm text-gray-600">@job.Description</p>
                        <a href="@job.Link" class="text-blue-500 mt-2 inline-block">View Details →</a>
                    </div>
                }
            </div>

            <!-- Pagination Controls: Full Width -->
            <div class="mt-8 w-full flex justify-between items-center gap-2 mb-5">
                <!-- Items per page -->
                <div class="flex items-center gap-2">
                    <label class="text-sm font-medium text-gray-700">Items per page:</label>
                    <InputSelect @bind-Value="itemsPerPage" class="px-3 py-2 border rounded-md">
                        @foreach (var size in pageSizeOptions)
                        {
                            <option value="@size">@size</option>
                        }
                    </InputSelect>
                </div>

                <!-- Page navigation -->
                <div class="flex items-center gap-2">
                    <button @onclick="PreviousPage" disabled="@((currentPage == 1))"
                            class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300 disabled:opacity-50">
                        ← Prev
                    </button>

                    <span class="text-sm text-gray-700">Page @currentPage of @totalPages</span>

                    <button @onclick="NextPage" disabled="@((currentPage == totalPages))"
                            class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300 disabled:opacity-50">
                        Next →
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private string searchQuery = "";
    private string selectedWorkType = "";
    private string selectedField = "";
    private string selectedExperienceLevel = "";
    private string selectedLocation = "";
    private int currentPage = 1;
    private int itemsPerPage = 6;
    private List<int> pageSizeOptions = new() { 6, 12, 24 };
    private int totalPages => (int)Math.Ceiling((double)FilteredJobs.Count / itemsPerPage);

    private List<string> ExperienceLevels = new() { "Entry", "Mid", "Senior", "Lead" };
    private List<string> AvailableLocations = new() { "Nairobi", "Remote", "London", "New York", "Berlin" };
    private List<string>? AvailableRoles { get; set; }
    private HashSet<string> SelectedFields = new();
    private List<CareerRole> AllJobs = new(); // Populate from DB or API
    private List<CareerRole> FilteredJobs = new();

    [Parameter]
    [SupplyParameterFromQuery]
    public string role { get; set; }


    private ApplicationDbContext context = default!;

    protected override async Task OnInitializedAsync()
    {
        context = await DbFactory.CreateDbContextAsync();
        AllJobs = context.CareerRole.ToList();
        AvailableRoles = AllJobs
        .Select(job => job.CareerField)
        .Distinct()
        .OrderBy(field => field)
        .ToList();

        FilteredJobs = AllJobs;

        if (role is not null)
        {
            FilteredJobs = AllJobs.AsEnumerable<CareerRole>().Where(r => r.Name.Equals(role)).ToList();
        }
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    private void ToggleRole(string role)
    {
        if (!SelectedFields.Add(role))
            SelectedFields.Remove(role);

        ApplySearch();
    }

    private void ApplySearch()
    {
        currentPage = 1;
        FilteredJobs = AllJobs
            .Where(job =>
                (string.IsNullOrWhiteSpace(searchQuery) || job.CareerField.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) &&
                (SelectedFields.Count == 0 || SelectedFields.Contains(job.Name)) &&
                (string.IsNullOrWhiteSpace(selectedWorkType) || job.WorkType == selectedWorkType) &&
                (string.IsNullOrWhiteSpace(selectedField) || job.CareerField == selectedField) &&
                (string.IsNullOrWhiteSpace(selectedExperienceLevel) || job.ExperienceLevel == selectedExperienceLevel) &&
                (string.IsNullOrWhiteSpace(selectedLocation) || job.Location == selectedLocation)
            )
            .ToList();
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
            currentPage--;
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
            currentPage++;
    }
}