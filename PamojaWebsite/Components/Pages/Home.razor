    <!-- Values Section-->
    <section class="py-20 bg-gray-100">
         <div class="container mx-auto px-6">
            <div class="max-w-[1000px] mx-auto">
                <!-- Header -->
                <h2 class="text-4xl font-bold text-green-900 text-center mb-12">Our Values</h2>
                @* <div class="border-b-2 border-green-900 mb-6">
                    <h2 class="text-4xl font-semibold text-green-900 pt-8 pb-2 mb-6 pl-1/2">Values</h2>
                </div> *@

                <!-- Grid -->
                <div class="grid grid-cols-2 grid-rows-3 md:grid-cols-3 md:grid-rows-2 gap-6 text-center">
                    <!-- Integrity -->
                    <div class="bg-white rounded-lg shadow">
                        <figure class="m-0">
                            <svg viewBox="0 0 220 220" role="img" class="mx-auto transform scale-50">
                                <circle cx="110" cy="110" r="90" fill="none" stroke="#0ea5e9" stroke-width="14" opacity="0.65" />
                                <circle cx="110" cy="110" r="60" fill="#2563eb" />
                            </svg>
                            <figcaption class="font-semibold text-base">Integrity</figcaption>
                            <p class="mt-1 text-sm text-gray-700">Acting with honesty, transparency, and accountability in everything we do</p>
                        </figure>
                    </div>

                    <!-- Respect & Dignity -->
                    <div class="bg-white rounded-lg shadow p-4">
                        <figure class="m-0">
                            <svg viewBox="0 0 220 220" role="img" class="mx-auto transform scale-50">
                                <polygon points="110,30 190,180 30,180" fill="#a78bfa" />
                            </svg>
                            <figcaption class="mt-2 font-semibold text-base">Respect &amp; Dignity</figcaption>
                            <p class="mt-1 text-sm text-gray-700">Valuing each person’s uniqueness, upholding human rights, and treating all with compassion and fairness</p>
                        </figure>
                    </div>

                    <!-- Safety & Protection -->
                    <div class="bg-white rounded-lg shadow p-4">
                        <figure class="m-0">
                            <svg viewBox="0 0 220 220" role="img" class="mx-auto transform scale-50">
                                <polygon points="110,30 170,65 170,135 110,170 50,135 50,65" fill="#10b981" />
                            </svg>
                            <figcaption class="mt-2 font-semibold text-base">Safety &amp; Protection</figcaption>
                            <p class="mt-1 text-sm text-gray-700">Ensuring safety and wellbeing through supportive environments and robust safeguarding practices</p>
                        </figure>
                    </div>

                    <!-- Community & Collaboration -->
                    <div class="bg-white rounded-lg shadow p-4">
                        <figure class="m-0">
                            <svg viewBox="0 0 220 220" role="img" class="mx-auto transform scale-50">
                                <path d="M110,40 c-30,0 -55,25 -55,55 c0,35 30,55 55,70 c25,15 55,25 65,45"
                                      fill="none" stroke="#f59e0b" stroke-width="10" />
                                <path d="M110,40 c30,0 55,25 55,55 c0,35 -30,55 -55,70 c-25,15 -55,25 -65,45"
                                      fill="none" stroke="#facc15" stroke-width="10" />
                            </svg>
                            <figcaption class="mt-2 font-semibold text-base">Community &amp; Collaboration</figcaption>
                            <p class="mt-1 text-sm text-gray-700">Building inclusive communities that foster belonging, collaboration, and mutual support</p>
                        </figure>
                    </div>

                    <!-- Empowerment -->
                    <div class="bg-white rounded-lg shadow p-4">
                        <figure class="m-0">
                            <svg viewBox="0 0 220 220" role="img" class="mx-auto transform scale-50">
                                <path d="M110,35 L125,80 L170,85 L135,110 L150,155 L110,130 L70,155 L85,110 L50,85 L95,80 Z"
                                      fill="#7c3aed" />
                            </svg>
                            <figcaption class="mt-2 font-semibold text-base">Empowerment &amp; Prevention</figcaption>
                            <p class="mt-1 text-sm text-gray-700">Supporting people to make choices, build resilience, and take ownership of growth</p>
                        </figure>
                    </div>

                    <!-- Empathy & Care -->
                    <div class="bg-white rounded-lg shadow p-4">
                        <figure class="m-0">
                            <svg viewBox="0 0 220 220" role="img" class="mx-auto transform scale-50">
                                <path d="M20,130 C60,90 90,170 130,130 C160,100 185,115 200,105 L200,180 L20,180 Z"
                                      fill="#22d3ee" />
                            </svg>
                            <figcaption class="mt-2 font-semibold text-base">Empathy &amp; Care</figcaption>
                            <p class="mt-1 text-sm text-gray-700">Listening deeply and responding with understanding, compassion, and kindness</p>
                        </figure>
                    </div>
                </div>
            </div>
         </div>
    </section>

    <!-- Services Section -->
    <section class="py-20 bg-white">
        <div class="container mx-auto px-6">
            <h2 class="text-4xl font-bold text-green-900 text-center mb-12">Our Services</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Service 1 -->
                <div class="bg-gradient-to-br from-primary to-secondary text-gray-800 rounded-lg shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
                    <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1757321482597-FYSHDUANS0MYOCT2KFCV/unsplash-image-Ko3EMBFggok.jpg"
                         alt="Awareness & Prevention"
                         class="w-full h-48 object-cover">
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-4">Awareness & Prevention</h3>
                        <ul class="space-y-2 text-gray-800/90">
                            <li>• Wellbeing Assessment & Tembea Plan</li>
                            <li>• Challenging Stigma</li>
                            <li>• Suicide Prevention</li>
                            <li>• Recognizing Trauma</li>
                            <li>• Substance misuse support</li>
                        </ul>
                    </div>
                </div>

                <!-- Service 2 -->
                <div class="bg-gradient-to-br from-secondary to-accent text-gray-800 rounded-lg shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
                    <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1757319795783-PW800YV3WVWNMGBVVUZ3/unsplash-image-rg1y72eKw6o.jpg"
                         alt="Pamoja Workshops"
                         class="w-full h-48 object-cover">
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-4">Pamoja Workshops</h3>
                        <ul class="space-y-2 text-gray-800/90">
                            <li>• First Aid for Mental Health</li>
                            <li>• Safeguarding & Policy Integration</li>
                            <li>• Trauma Informed Practice</li>
                            <li>• Forensic Mental Health Care</li>
                            <li>• Neurodiversity and Identity</li>
                        </ul>
                    </div>
                </div>

                <!-- Service 3 -->
                <div class="bg-gradient-to-br from-accent to-primary text-gray-800 rounded-lg shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
                    <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1757320039101-LBDKT7SW3PKTBFQH46L4/unsplash-image-NTyBbu66_SI.jpg"
                         alt="Well Being"
                         class="w-full h-48 object-cover">
                    <div class="p-6">
                        <h3 class="text-xl font-semibold mb-4">Well Being</h3>
                        <ul class="space-y-2 text-gray-800/90">
                            <li>• Burn Out Prevention & Self-care</li>
                            <li>• Clinical Supervision</li>
                            <li>• Team Building</li>
                            <li>• Stress Management</li>
                            <li>• Eco Therapy</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="text-center mt-12">
                <a href="/services" class="bg-accent text-gray-800 px-8 py-3 rounded-full font-semibold hover:bg-orange-600 transition-colors duration-300 inline-flex items-center">
                    Learn More
                    <i data-feather="arrow-right" class="ml-2 w-4 h-4"></i>
                </a>
            </div>
        </div>
    </section>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("featherInit");
            await JS.InvokeVoidAsync("observeVideoVisibility", "myVideo");
        }
    }

}

