    <!-- Who We Are Section -->
    <section class="py-20 bg-white">
        <div class="container mx-auto px-6">
            <div class="flex flex-col md:flex-row items-center">
                <div class="md:w-1/2 mb-10 md:mb-0">
                    <h2 class="text-4xl font-bold text-green-900 mb-6">Who We Are</h2>
                    <p class="text-lg text-gray-700 mb-6 leading-relaxed">
                        Pamoja Counselling, Mental Wellbeing and Safeguarding Services was founded to address the urgent need for mental wellbeing and safeguarding support in communities where stigma, silence, and systemic barriers have long prevented access to care.
                    </p>
                    <p class="text-lg text-gray-700 mb-6 leading-relaxed">
                        The vision for Pamoja was inspired by lived experience. Its founder, Faith, combined her professional expertise as a mental health nurse and safeguarding specialist with personal experiences of bereavement, migration, and domestic abuse.
                    </p>
                    <div class="bg-green-800 text-white p-6 rounded-lg shadow-lg">
                        <p class="italic text-lg">
                            "Together, we bridge clinical expertise with safeguarding strategies that are both evidence-based and culturally relevant."
                        </p>
                    </div>
                </div>
                <div class="md:w-1/2">
                    <div class="ms-5 bg-white rounded-lg shadow-2xl p-8 text-gray-800">
                        @* <h2 class="text-3xl font-bold mb-4 text-green-800">
                            Our Mission & Vision
                        </h2> *@
                        <div class="space-y-6">
                            <div class="flex items-start">
                                <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1761336477679-QUMJ1WWE778S5KCMO800/unsplash-image-Q6KzWe-lq9Y.jpg"
                                     alt="Our Team"
                                     class="ms-1 w-full h-96 object-cover rounded-lg shadow-2xl">
                                @* <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1761a630-6e44-4264-9e8b-40609e682f3e/Vision.jpg"
                                     alt="Our Vision"
                                     class="w-16 h-16 rounded-full object-cover mr-4 flex-shrink-0"> *@

                            </div>
                            <div class="flex items-center">
                                @* <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/49958a89-c7ce-47c4-85cb-293063703f6f/Mission.jpg"
                                     alt="Our Mission"
                                     class="w-16 h-16 rounded-full object-cover mr-4 flex-shrink-0"> *@
                                <div class="me-3">
                                    <h3 class="text-xl font-bold text-secondary mb-2">Our Vision</h3>
                                    <p class="text-gray-600">Building a society that values mental wellbeing and safeguarding practice, ensuring every individual can thrive with dignity and respect.</p>
                                </div>
                                <div class="ms-3">
                                    <h3 class="text-xl font-bold text-secondary mb-2">Our Mission</h3>
