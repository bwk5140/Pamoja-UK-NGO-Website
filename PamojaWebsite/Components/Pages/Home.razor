@page "/"

<PageTitle>Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'auto'});
</script>

@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

@rendermode InteractiveServer
<div class="pt-[5%] mb-5 py-20 mt-5">
    <div class="container-xxxl" style="font-family: Calibri;">
        <!-- Hero Section -->
        <section class="relative bg-gradient-to-r from-primary to-secondary text-black overflow-hidden">
            <!-- Dark overlay -->
            @* <div class="absolute inset-0 bg-black opacity-20"></div> *@

            <div class="video-container">
                <video id="myVideo" autoplay
                       muted
                       loop
                       playsinline
                       class="background-video"
                       poster="/Images/Art/Elephant.png">
                    <source src="/Videos/Art/NewArt.mp4" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
                <div class="overlay">
                    <h1>Break the stigma, expand access, transform lives.</h1>
                    <p>Take the first step with Pamoja.</p>
                    <div class="buttons mb-5">
                        <a href="/about-us" class="btn">Learn More</a>
                    </div>
                    <div class="mt-5 animate-pulse px-8" style="font-size: xx-large;">
                    <h3>Akili bora, Afya bora</h3>
                </div>
                </div>

            </div>
        </section>
        <section class="py-20 bg-white">
            <div class="container mx-auto px-6">
                <div class="flex flex-col md:flex-row items-center">
                    <div class="md:w-1/2 mb-10 md:mb-0">
                        @* <h2 class="text-4xl font-bold text-green-900 mb-6">Who We Are</h2> *@
                        <p class="text-lg text-gray-700 mb-6 leading-relaxed">
                            Pamoja Counselling, Mental Wellbeing and Safeguarding Services was founded to address the urgent need for mental wellbeing and safeguarding support in communities where stigma, silence, and systemic barriers have long prevented access to care.
                        </p>
                        <p class="text-lg text-gray-700 mb-6 leading-relaxed">
                            We help communities integrate into new societies and reintegrate back into society having lived abroad and looking to settle back home.
                        </p>
                        <p class="text-lg text-gray-700 mb-6 leading-relaxed">
                            The vision for Pamoja was inspired by lived experience. Its founder, Faith, combined her professional expertise as a mental health nurse and safeguarding specialist with personal experiences of bereavement, migration, and domestic abuse.
                        </p>
                        <div class="bg-gray-200 text-gray-700 p-6 rounded-lg shadow-lg">
                            <p class="italic text-lg">
                                "Together, we bridge clinical expertise with safeguarding strategies that are both evidence-based and culturally relevant."
                            </p>
                        </div>
                    </div>
                    <div class="md:w-1/2">
                        <img src="Images/PamojaLogo.png"
                             class="h-96 w-96" />
                    </div>
                </div>
            </div>
        </section>
        <!--Mission/Vision Section-->
        <section class="p-20 rounded bg-gradient-to-tr from-red-300 to-yellow-400">
            <div class="center-container flex flex-col md:flex-row">
                <div class="bg-red-800 bg-yellow-100 p-5 w-104 sm:96 md:96 mt-5 rounded-xl">
                    <h2 class="mb-2 mt-3 text-red-800 text-yellow-600 underline underline-offset-8 text-center decoration-50" style="font-size: xx-large;">
                        Our Mission
                    </h2>
                    <p>
                        To build a society that values mental wellbeing and safeguarding practice,
                    </p>
                    <p>
                        ensuring every individual can thrive with dignity and respect.
                    </p>
                </div>
                <div>
                    <img src="Images/Art/diverse-hands.png"
                         class="h-80 w-full hidden sm:block" />
                </div>
                <div class="bg-red-800 bg-yellow-100 p-5 w-104 sm:96 md:96 mt-5 rounded-xl">
                    <h2 class="mb-2 mt-3 text-red-800 text-yellow-600 underline underline-offset-8 text-center decoration-40" style="font-size: xx-large;">
                        Our Vision
                    </h2>
                    <p>
                        To empower individuals and organisations with the skills, knowledge, and confidence to
                    </p>
                    <p>
                        promote mental well-being and effective safeguarding practice across Kenya.
                    </p>
                </div>
            </div>
        </section>
        <!-- Values Section-->
        <section class="py-20 bg-gray-100">
            <div class="container mx-auto px-6">
                <div class="max-w-7xl mx-auto">
                    <!-- Header -->
                    <h2 class="text-4xl font-bold text-green-900 text-center mb-2">Our Values</h2>

                    <!-- Grid -->
                    <div class="grid grid-cols-2 grid-rows-3 md:grid-cols-3 md:grid-rows-2 gap-6 text-center">
                        <!-- Integrity -->
                        <div>
                            <figure class="m-0">
                                <svg viewBox="0 0 220 220" role="img" class="mx-auto transform scale-50">
                                    <circle cx="110" cy="110" r="90" fill="none" stroke="#ff8500" stroke-width="14" opacity="0.65" />
                                    <circle cx="110" cy="110" r="60" fill="#2E7D32" />
                                </svg>
                                <figcaption class="font-semibold text-base">Integrity</figcaption>
                                <p class="mt-1 text-md text-gray-600">Acting with honesty, transparency, and accountability in everything we do</p>
                            </figure>
                        </div>

                        <!-- Respect & Dignity -->
                        <div>
                            <figure class="m-0">
                                <svg viewBox="0 0 220 220" role="img" class="mx-auto transform scale-50">
                                    <polygon points="110,30 190,180 30,180" fill="#ff8500" />
                                </svg>
                                <figcaption class="font-semibold text-base">Respect &amp; Dignity</figcaption>
                                <p class="mt-1 text-md text-gray-600">Valuing each person’s uniqueness, upholding human rights, and treating all with compassion and fairness</p>
                            </figure>
                        </div>

                        <!-- Safety & Protection -->
                        <div>
                            <figure class="m-0">
                                <svg viewBox="0 0 220 220" role="img" class="mx-auto transform scale-50">
                                    <polygon points="110,30 170,65 170,135 110,170 50,135 50,65" fill="#2E7D32" />
                                </svg>
                                <figcaption class="font-semibold text-base">Safety &amp; Protection</figcaption>
                                <p class="mt-1 text-md text-gray-600">Ensuring safety and wellbeing through supportive environments and robust safeguarding practices</p>
                            </figure>
                        </div>

                        <!-- Community & Collaboration -->
                        <div>
                            <figure class="m-0">
                                <svg viewBox="0 0 220 220" role="img" class="mx-auto transform scale-50">
                                    <path d="M110,40 c-30,0 -55,25 -55,55 c0,35 30,55 55,70 c25,15 55,25 65,45"
                                          fill="none" stroke="#2E7D32" stroke-width="10" />
                                    <path d="M110,40 c30,0 55,25 55,55 c0,35 -30,55 -55,70 c-25,15 -55,25 -65,45"
                                          fill="none" stroke="#ff8500" stroke-width="10" />
                                </svg>
                                <figcaption class="font-semibold text-base">Community &amp; Collaboration</figcaption>
                                <p class="mt-1 text-md text-gray-600">Building inclusive communities that foster belonging, collaboration, and mutual support</p>
                            </figure>
                        </div>

                        <!-- Empowerment -->
                        <div>
                            <figure class="m-0">
                                <svg viewBox="0 0 220 220" role="img" class="mx-auto transform scale-50">
                                    <path d="M110,35 L125,80 L170,85 L135,110 L150,155 L110,130 L70,155 L85,110 L50,85 L95,80 Z"
                                          fill="#2E7D32" />
                                </svg>
                                <figcaption class="font-semibold text-base">Empowerment &amp; Prevention</figcaption>
                                <p class="mt-1 text-md text-gray-600">Supporting people to make choices, build resilience, and take ownership of growth</p>
                            </figure>
                        </div>

                        <!-- Empathy & Care -->
                        <div>
                            <figure class="m-0">
                                <svg viewBox="0 0 220 220" role="img" class="mx-auto transform scale-50">
                                    <path d="M20,130 C60,90 90,170 130,130 C160,100 185,115 200,105 L200,180 L20,180 Z"
                                          fill="#ff8500" />
                                </svg>
                                <figcaption class="font-semibold text-base">Empathy &amp; Care</figcaption>
                                <p class="mt-1 text-md text-gray-600">Listening deeply and responding with understanding, compassion, and kindness</p>
                            </figure>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Services Section -->
        <div class="container mx-auto mt-5 px-4">
            <h2 class="text-4xl font-bold text-green-900 text-center mb-5">Our Services</h2>
        </div>

        <div class="py-20 bg-gray-100">
            <div class="container mx-auto px-4">
                <div class="mx-auto max-w-screen-xl">
                    <div class="grid grid-rows-3 gap-8">

                        <!-- Service 1 -->
                        <section class="relative text-white py-12 px-4 sm:px-6 lg:px-8">
                            <div class="absolute inset-0">
                                <img loading="lazy" src="Images/Art/Service1.png"
                                     alt="Pamoja Workshops"
                                     class="object-cover object-top w-full h-full" />
                            </div>

                            <div class="prose prose-lg relative opacity-90 px-4 font-sans max-w-full">
                                <div class="text-md mt-5 font-bold mb-2 max-w-md bg-white bg-opacity-10 p-4 rounded hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
                                    <h3 class="text-l text-black mb-4 font-semibold">Pamoja Workshops</h3>
                                    <ul class="space-y-2 font-light text-black">
                                        <li>• First Aid for Mental Health</li>
                                        <li>• Safeguarding & Policy Integration</li>
                                        <li>• Trauma Informed Practice</li>
                                        <li>• Forensic Mental Health Care</li>
                                        <li>• Neurodiversity and Identity</li>
                                    </ul>
                                    <button type="button"
                                            class="mt-3 btn bg-gray-700 hover:bg-green-900 text-white font-bold py-3 px-6 rounded-lg transition duration-300 inline-flex items-center"
                                            @onclick="ScrollToTarget">
                                        Get Started
                                        <i data-feather="arrow-right" class="ml-2"></i>
                                    </button>
                                </div>
                            </div>
                        </section>

                        <!-- Service 2 -->
                        <section class="relative bg-green-900 text-white py-6 px-4 sm:px-6 lg:px-8">
                            <div class="absolute inset-0">
                                <img loading="lazy" src="Images/Art/Service2.png"
                                     alt="Well Being"
                                     class="object-cover object-top w-full h-full" />
                            </div>

                            <div class="flex justify-end">
                                <div class="prose prose-lg relative opacity-90 font-sans max-w-full">
                                    <div class="text-md mt-5 font-bold mb-2 max-w-md bg-white bg-opacity-10 p-4 rounded shadow hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 text-right">
                                        <h3 class="text-l text-white font-semibold mb-4">Well Being</h3>
                                        <ul class="space-y-2 font-light text-white">
                                            <li>• Burn Out Prevention & Self-care</li>
                                            <li>• Clinical Supervision</li>
                                            <li>• Team Building</li>
                                            <li>• Stress Management</li>
                                            <li>• Eco Therapy</li>
                                        </ul>
                                        <button type="button"
                                                class="mt-3 btn bg-gray-700 hover:bg-green-900 text-white font-bold py-3 px-6 rounded-lg transition duration-300 inline-flex items-center"
                                                @onclick="ScrollToTarget">
                                            Get Started
                                            <i data-feather="arrow-right" class="ml-2"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Service 3 -->
                        <section class="relative text-white py-6 px-4 sm:px-6 lg:px-8">
                            <div class="absolute inset-0">
                                <img loading="lazy" src="Images/Art/Service3.png"
                                     alt="Awareness & Prevention"
                                     class="object-cover object-top w-full h-full" />
                            </div>

                            <div class="prose prose-lg relative opacity-90 px-4 font-sans max-w-full">
                                <div class="text-md mt-5 font-bold mb-2 max-w-md bg-white bg-opacity-10 p-4 rounded shadow hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
                                    <h3 class="text-l text-white font-semibold mb-4">Awareness & Prevention</h3>
                                    <ul class="text-md font-light space-y-2 text-white">
                                        <li>• Wellbeing Assessment & Tembea Plan</li>
                                        <li>• Challenging Stigma</li>
                                        <li>• Suicide Prevention</li>
                                        <li>• Recognizing Trauma</li>
                                        <li>• Substance misuse support</li>
                                    </ul>
                                    <button type="button"
                                            class="mt-3 btn bg-gray-700 hover:bg-green-900 text-white font-bold py-3 px-6 rounded-lg transition duration-300 inline-flex items-center"
                                            @onclick="ScrollToTarget">
                                        Get Started
                                        <i data-feather="arrow-right" class="ml-2"></i>
                                    </button>
                                </div>
                            </div>
                        </section>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("featherInit");
            await JS.InvokeVoidAsync("observeVideoVisibility", "myVideo");
        }
    }
    private async Task ScrollToTarget()
    {
        NavigationManager.NavigateTo("services");
    }
}

