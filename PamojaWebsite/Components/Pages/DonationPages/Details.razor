@page "/donations/details"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Details</h1>

    <div>
        <h2>Donation</h2>
        <hr />
        @if (donation is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">InvoiceNumber</dt>
                <dd class="col-sm-10">@donation.InvoiceNumber</dd>
                <dt class="col-sm-2">Name</dt>
                <dd class="col-sm-10">@donation.Name</dd>
                <dt class="col-sm-2">Email</dt>
                <dd class="col-sm-10">@donation.Email</dd>
                <dt class="col-sm-2">Currency</dt>
                <dd class="col-sm-10">@donation.Currency</dd>
                <dt class="col-sm-2">Amount</dt>
                <dd class="col-sm-10">@donation.Amount</dd>
                <dt class="col-sm-2">ProcessingFee</dt>
                <dd class="col-sm-10">@donation.ProcessingFee</dd>
                <dt class="col-sm-2">Total</dt>
                <dd class="col-sm-10">@donation.Total</dd>
            </dl>
            <div>
                <a href="@($"/donations/edit?id={donation.Id}")">Edit</a> |
                <a href="@($"/donations")">Back to List</a>
            </div>
        }
    </div>
</div>


@code {
    private Donation? donation;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        donation = await context.Donation.FirstOrDefaultAsync(m => m.Id == Id);

        if (donation is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
