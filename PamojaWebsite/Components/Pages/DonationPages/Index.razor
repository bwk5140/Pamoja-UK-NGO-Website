@page "/donations"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using PamojaWebsite.Data
@using PamojaWebsite.Data.Contexts
@implements IAsyncDisposable
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

<PageTitle>Index</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Index</h1>

    <p>
        <a href="donations/create">Create New</a>
    </p>

    <QuickGrid Class="table" Items="context.Donation">
        <PropertyColumn Property="donation => donation.InvoiceNumber" />
        <PropertyColumn Property="donation => donation.Name" />
        <PropertyColumn Property="donation => donation.Email" />
        <PropertyColumn Property="donation => donation.Currency" />
        <PropertyColumn Property="donation => donation.Amount" />
        <PropertyColumn Property="donation => donation.ProcessingFee" />
        <PropertyColumn Property="donation => donation.Total" />

        <TemplateColumn Context="donation">
            <a href="@($"donations/edit?id={donation.Id}")">Edit</a> |
            <a href="@($"donations/details?id={donation.Id}")">Details</a> |
            <a href="@($"donations/delete?id={donation.Id}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
</div>


@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
