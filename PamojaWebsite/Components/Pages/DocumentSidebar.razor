@using System.Text
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data

@inject IJSRuntime JS
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

    @rendermode @(new InteractiveServerRenderMode(prerender: false))

<aside id="sidebar" class="w-full bg-white border-r border-gray-200 overflow-y-auto no-print transition-all duration-300 h-full">
    <div class="p-6">
        <!-- Document Information -->
        <div class="mb-8">
            <h2 class="text-base font-semibold text-gray-800 mb-4 uppercase tracking-wider text-xs">Document Information</h2>
            <div class="space-y-3 text-sm">
                <div>
                    <div class="text-xs text-gray-500 font-medium">Title</div>
                    <div class="font-medium text-gray-800 break-words">@(Metadata?.Title ?? CurrentDoc?.Title ?? "N/A")</div>
                </div>
                <div>
                    <div class="text-xs text-gray-500 font-medium">Author</div>
                    <div class="font-medium text-gray-800">@(Metadata?.Author ?? CurrentDoc?.Author ?? "Unknown")</div>
                </div>
                <div>
                    <div class="text-xs text-gray-500 font-medium">Last Modified</div>
                    <div class="font-medium text-gray-800">
                        @(Metadata?.LastModified?.ToString("MMMM dd, yyyy") ?? CurrentDoc?.Date.ToString("MMMM dd, yyyy") ?? "N/A")
                    </div>
                </div>
                <div>
                    <div class="text-xs text-gray-500 font-medium">Category</div>
                    <div class="font-medium text-gray-800">@(Metadata?.Category ?? CurrentDoc?.Category ?? "General")</div>
                </div>
                @if (Metadata?.PageCount > 0)
                {
                    <div>
                        <div class="text-xs text-gray-500 font-medium">Pages</div>
                        <div class="font-medium text-gray-800">@Metadata.PageCount</div>
                    </div>
                }
            </div>
        </div>

        <!-- Table of Contents -->
        @if (Metadata?.TableOfContents?.Any() == true)
        {
            <div class="mb-8">
                <h2 class="text-base font-semibold text-gray-800 mb-4 uppercase tracking-wider text-xs">Table of Contents</h2>
                <nav class="space-y-1">
                    @foreach (var item in Metadata.TableOfContents)
                    {
                        <a href="@item.Anchor" aria-label="@item.Title" class="flex items-center py-2 px-3 text-sm text-gray-600 hover:bg-gray-50 hover:text-green-800 rounded-lg transition-colors">
                            <svg aria-label="Metadata icon" class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                            <span class="truncate">@item.Title</span>
                        </a>
                    }
                </nav>
            </div>
        }
@*         @if (CurrentDoc.ContentType == "application/pdf")
        {
            <!-- Document Tools -->
            <div class="mb-8">
                <h2 class="text-base font-semibold text-gray-800 mb-4 uppercase tracking-wider text-xs">Tools</h2>
