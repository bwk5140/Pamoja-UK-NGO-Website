@page "/services/book-appointment"

@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@rendermode InteractiveServer

<PageTitle>Edit</PageTitle>
<div class="container-xxxl">
    <!-- Banner Section -->
    <section class="relative bg-green-900 text-white py-2 px-4 sm:px-6 lg:px-8 overflow-hidden">
        <!-- Decorative background shapes -->
        <div class="absolute inset-0">
            <!-- Large blurred gradient blob -->
            <div class="absolute -top-32 -left-32 w-96 h-96 bg-gradient-to-r from-green-600 to-blue-800 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>

            <!-- Smaller accent circle -->
            <div class="absolute top-20 right-20 w-40 h-40 bg-green-700 rounded-full opacity-30 animate-bounce"></div>

            <!-- Diagonal rectangle -->
            <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-green-800 opacity-40 transform rotate-12"></div>

            <!-- Triangle using clip-path -->
            <div class="absolute top-1/2 right-0 w-64 h-64 bg-blue-900 opacity-30"
                 style="clip-path: polygon(0 0, 100% 0, 0 100%);">
            </div>
        </div>

        <!-- Content -->
        <div class="relative max-w-7xl mx-auto">
            <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
                <h1 class="text-4xl mt-5 md:text-5xl font-bold mb-2">Custom Package Solutions</h1>
            </div>
        </div>
    </section>
    
    <!-- Breadcrumb Section-->
    <section class="py-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Breadcrumb -->
            <nav class="flex items-center text-sm text-gray-600" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <!-- About Us -->
                    <li class="inline-flex items-center">
                        <a href="/services"
                           class="inline-flex items-center text-green-700 hover:text-green-800 font-medium">
                            Services
                        </a>
                    </li>

                    <!-- Separator -->
                    <li>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 text-gray-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                      d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                      clip-rule="evenodd" />
                            </svg>
                            <a href="/services/book-appointment"
                               class="ml-1 text-green-700 hover:text-green-800 font-medium font-bold">
                                Book an Appointment
                            </a>
                        </div>
                    </li>
                </ol>
            </nav>
        </div>
    </section>
    
    <section class="bg-white py-12 px-6 max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-4">Book an Appointment</h1>
        <p class="text-center text-lg text-gray-600 mb-6">Limited 1-Hour Consultations Now Available</p>
        <div class="bg-gray-100 p-6 rounded-lg shadow-md">
            <form class="space-y-4">
                <input type="text" placeholder="Full Name" class="w-full p-3 border rounded" />
                <input type="email" placeholder="Email Address" class="w-full p-3 border rounded" />
                <input type="tel" placeholder="Phone Number" class="w-full p-3 border rounded" />
                <input type="datetime-local" class="w-full p-3 border rounded" />
                <textarea placeholder="Brief Description of Needs" class="w-full p-3 border rounded h-32"></textarea>
                <button class="btn-primary text-white px-6 py-3 rounded hover:bg-blue-700">Book My Consultation</button>
            </form>
        </div>
    </section>
</div>

