@page "/about-us/raphael-imanyara"

<PageTitle>Raphael Imanyara | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!-- Hero Section -->
<section class="relative bg-green-900 text-white py-2 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <!-- Decorative background shapes -->
    <div class="absolute inset-0">
        <!-- Large blurred gradient blob -->
        <div class="absolute -top-32 -left-32 w-96 h-96 bg-gradient-to-r from-green-600 to-blue-800 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>

        <!-- Smaller accent circle -->
        <div class="absolute top-20 right-20 w-40 h-40 bg-green-700 rounded-full opacity-30 animate-bounce"></div>

        <!-- Diagonal rectangle -->
        <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-green-800 opacity-40 transform rotate-12"></div>

        <!-- Triangle using clip-path -->
        <div class="absolute top-1/2 right-0 w-64 h-64 bg-blue-900 opacity-30"
             style="clip-path: polygon(0 0, 100% 0, 0 100%);">
        </div>
    </div>

    <!-- Content -->
    <div class="relative max-w-7xl mx-auto">
        <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
            <h1 class="text-4xl mt-5 md:text-5xl font-bold mb-2">Raphael Imanyara</h1>
        </div>
        <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
            <h2 class="text-2xl md:text-3xl mb-2 font-light">Head of HR and Operations</h2>
        </div>
    </div>
</section>


<!-- Bio Section -->
<section class="py-16 bg-white">
    <div class="container mx-auto px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
            <nav class="flex items-center text-sm text-gray-600 mb-6" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <!-- About Us -->
                    <li class="inline-flex items-center">
                        <a href="/about-us"
                           class="inline-flex items-center text-green-700 hover:text-green-800 font-medium">
                            About Us
                        </a>
                    </li>

                    <!-- Separator -->
                    <li>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 text-gray-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                      d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                      clip-rule="evenodd" />
                            </svg>
                            <a href="/about-us/raphael-imanyara"
                               class="ml-1 text-green-700 hover:text-green-800 font-medium font-bold">
                                Raphael Imanyara
                            </a>
                        </div>
                    </li>
                </ol>
            </nav>
            <p class="text-s text-gray-900 mb-3">
                Raphael T. Imanyara is a highly experienced Human Resources professional with over 25 years of progressive leadership across pharmaceuticals,
                NGOs, hospitality, manufacturing, and real estate.
            </p>
            <p class="text-s text-gray-900 mb-3">
                He specializes in strategic HR management, performance improvement, policy development, talent acquisition, and change management.
            </p>
            <p class="text-s text-gray-900 mb-3">
                From 2021 to 2024, he served as Head of HR and Administration at Cosmos Pharmaceutical Manufacturing Company, where he restructured HR policies,
                strengthened performance management, and enhanced employee engagement and compliance.
            </p>
            <p class="text-s text-gray-900 mb-3">
                Between 2015 and 2021, Raphael worked as an HR Consultant and Trainer, delivering HR audits, policy frameworks, and capacity-building programs for organizations,
                including USAID projects and the Kenya Institute of Management.
            </p>
            <p class="text-s text-gray-900 mb-3">
                His earlier roles include Group HR Manager at Jakaranda Hotels, HR Manager at Kenga Hotels and Vipingo Ridge Ltd, and Group HR & Change Manager at Alliance Group of Hotels,
                where he led major restructuring, workforce optimization, and organizational development initiatives. He also managed regional HR operations for East African Breweries across Kenya, Uganda, and Tanzania.
            </p>
            <p class="text-s text-gray-900 mb-3">
                Raphael holds a BSc (Hons) from the University of Nairobi and a Postgraduate Diploma from Heriot-Watt University, Edinburgh.
            </p>
            <p class="text-s text-gray-900">
                A Certified Life Coach and member of IHRM Kenya, he is known for his strategic insight, people-centered leadership, and commitment to organizational excellence.
            </p>
            <div class="flex justify-end mt-12">
                <p class="text-s text-secondary mt-5">
                    Interested in joining the team? Find out more.
                </p>
            </div>
            <div class="flex justify-end mt-2">
                <a href="/careers"
                   class="bg-green-700 hover:bg-green-800 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition">
                    Careers
                </a>
            </div>
        </div>
    </div>
</section>

