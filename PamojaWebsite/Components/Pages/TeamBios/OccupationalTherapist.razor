@page "/about-us/benjamin-wafula"

<PageTitle>Benjamin Sifuna Wafula | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'auto'});
</script>
<div class="pt-[5%] mb-5 py-20 mt-5">
    <!-- Hero Section -->
    <section class="relative py-20 mt-5 bg-green-900 text-white py-2 px-4 sm:px-6 lg:px-8 overflow-hidden">
        <!-- Decorative background shapes -->
        <div class="absolute inset-0">
            <!-- Large blurred gradient blob -->
            <div class="absolute -top-32 -left-32 w-96 h-96 bg-gradient-to-r from-green-600 to-blue-800 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>

            <!-- Smaller accent circle -->
            <div class="absolute top-20 right-20 w-40 h-40 bg-green-700 rounded-full opacity-30 animate-bounce"></div>

            <!-- Diagonal rectangle -->
            <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-green-800 opacity-40 transform rotate-12"></div>

            <!-- Triangle using clip-path -->
            <div class="absolute top-1/2 right-0 w-64 h-64 bg-blue-900 opacity-30"
                 style="clip-path: polygon(0 0, 100% 0, 0 100%);">
            </div>
        </div>

        <!-- Content -->
        <div class="relative max-w-7xl mx-auto">
            <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
                <h1 class="text-4xl mt-5 md:text-5xl font-bold mb-2">Benjamin Sifuna Wafula</h1>
            </div>
            <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
                <h2 class="text-2xl md:text-3xl mb-2 font-light">Occupational Therapist</h2>
            </div>
        </div>
    </section>


    <!-- Bio Section -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-6 lg:px-8">
            <div class="max-w-4xl mx-auto">
                <nav class="flex items-center text-sm text-gray-600 mb-6" aria-label="Breadcrumb">
                    <ol class="inline-flex items-center space-x-1 md:space-x-3">
                        <!-- About Us -->
                        <li class="inline-flex items-center">
                            <a href="/about-us" aria-label="Navigate to about-us"
                               class="inline-flex items-center text-green-700 hover:text-green-800 font-medium">
                                About Us
                            </a>
                        </li>

                        <!-- Separator -->
                        <li>
                            <div class="flex items-center">
                                <svg class="w-4 h-4 text-gray-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd"
                                          d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                          clip-rule="evenodd" />
                                </svg>
                                <a href="/about-us/benjamin-wafula" aria-label="Navigate to current page"
                                   class="ml-1 text-green-700 hover:text-green-800 font-medium font-bold">
                                    Benjamin Sifuna Wafula
                                </a>
                            </div>
                        </li>
                    </ol>
                </nav>
                <!-- Right-aligned image with abstract shapes -->
                <div class="relative flex justify-end py-20">
                    <!-- Image itself -->
                    <img src="Images/Team/Benjamin.jpg"
                         alt="Benjamin Sifuna Wafula"
                         class="relative z-10 w-96 h-96 md:w-72 rounded-lg object-cover object-top shadow-lg rounded-15" />
                </div>
                <p class="text-s text-gray-900 mb-3">
                    Benjamin Sifuna Wafula is a Kenyan Occupational Therapist with professional experience across mental health, safeguarding, and rehabilitation settings.
                    He provides ethical, client-centred occupational therapy assessment and intervention for individuals experiencing mental health challenges, psychosocial distress,
                    and functional difficulties. His practice is grounded in the belief that meaningful participation is central to recovery.
                </p>
                <p class="text-s text-gray-900 mb-3">
                    Benjamin’s work takes a holistic focus by supporting individuals to regain independence, enhance daily functioning, and engage meaningfully in their life roles and occupations.
                    He is trained in both Kenya and Sweden and has professional experience working across Kenya in diverse clinical and community contexts.
                </p>
                <p class="text-s text-gray-900 mb-3">
                    He is registered with the Occupational Therapists Council of Kenya and is a member of the Kenya Occupational Therapists Association (KOTA). Benjamin is committed to trauma-informed,
                    rights-based practice and to promoting safety, dignity, resilience, and sustainable wellbeing for individuals and communities.
                </p>
                <div class="flex justify-end mt-12">
                    <p class="text-s text-secondary mt-5">
                        Interested in joining the team? Find out more.
                    </p>
                </div>
                <div class="flex justify-end mt-2">
                    <a href="/careers" aria-label="Navigate to careers"
                       class="bg-green-700 hover:bg-green-800 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition">
                        Careers
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>

