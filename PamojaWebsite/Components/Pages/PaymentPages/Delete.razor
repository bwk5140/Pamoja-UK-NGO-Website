@page "/payments/delete"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Delete</h1>

    <p>Are you sure you want to delete this?</p>
    <div>
        <h2>Payment</h2>
        <hr />
        @if (payment is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">InvoiceNumber</dt>
                <dd class="col-sm-10">@payment.InvoiceNumber</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Name</dt>
                <dd class="col-sm-10">@payment.Name</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">PaymentMethod</dt>
                <dd class="col-sm-10">@payment.PaymentMethod</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Email</dt>
                <dd class="col-sm-10">@payment.Email</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Currency</dt>
                <dd class="col-sm-10">@payment.Currency</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Amount</dt>
                <dd class="col-sm-10">@payment.Amount</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">CentsAmount</dt>
                <dd class="col-sm-10">@payment.CentsAmount</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">ProcessingFee</dt>
                <dd class="col-sm-10">@payment.ProcessingFee</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Total</dt>
                <dd class="col-sm-10">@payment.Total</dd>
            </dl>
            <EditForm method="post" Model="payment" OnValidSubmit="DeletePayment" FormName="delete" Enhance>
                <button type="submit" class="btn btn-danger" disabled="@(payment is null)">Delete</button> |
                <a href="/payments">Back to List</a>
            </EditForm>
        }
    </div>
</div>

@code {
    private Payment? payment;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        payment = await context.Payment.FirstOrDefaultAsync(m => m.Id == Id);

        if (payment is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeletePayment()
    {
        using var context = DbFactory.CreateDbContext();
        context.Payment.Remove(payment!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/payments");
    }
}
