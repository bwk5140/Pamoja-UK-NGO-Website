@page "/payments/create"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Create</h1>

    <h2>Payment</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Payment" OnValidSubmit="AddPayment" FormName="create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <label for="invoicenumber" class="form-label">InvoiceNumber:</label>
                    <InputText id="invoicenumber" @bind-Value="Payment.InvoiceNumber" class="form-control" />
                    <ValidationMessage For="() => Payment.InvoiceNumber" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Payment.Name" class="form-control" />
                    <ValidationMessage For="() => Payment.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="paymentmethod" class="form-label">PaymentMethod:</label>
                    <InputText id="paymentmethod" @bind-Value="Payment.PaymentMethod" class="form-control" />
                    <ValidationMessage For="() => Payment.PaymentMethod" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email:</label>
                    <InputText id="email" @bind-Value="Payment.Email" class="form-control" />
                    <ValidationMessage For="() => Payment.Email" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="currency" class="form-label">Currency:</label>
                    <InputText id="currency" @bind-Value="Payment.Currency" class="form-control" />
                    <ValidationMessage For="() => Payment.Currency" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="amount" class="form-label">Amount:</label>
                    <InputNumber id="amount" @bind-Value="Payment.Amount" class="form-control" />
                    <ValidationMessage For="() => Payment.Amount" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="centsamount" class="form-label">CentsAmount:</label>
                    <InputNumber id="centsamount" @bind-Value="Payment.CentsAmount" class="form-control" />
                    <ValidationMessage For="() => Payment.CentsAmount" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="processingfee" class="form-label">ProcessingFee:</label>
                    <InputNumber id="processingfee" @bind-Value="Payment.ProcessingFee" class="form-control" />
                    <ValidationMessage For="() => Payment.ProcessingFee" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="total" class="form-label">Total:</label>
                    <InputNumber id="total" @bind-Value="Payment.Total" class="form-control" />
                    <ValidationMessage For="() => Payment.Total" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
        </div>
    </div>

    <div>
        <a href="/payments">Back to List</a>
    </div>
</div>


@code {
    [SupplyParameterFromForm]
    private Payment Payment { get; set; } = default!;

    protected override void OnInitialized() => Payment ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddPayment()
    {
        using var context = DbFactory.CreateDbContext();
        context.Payment.Add(Payment);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/payments");
    }
}
