@page "/services"

<PageTitle>Our Services</PageTitle>

@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<!-- Hero Section -->
<section class="relative bg-green-900 text-white py-2 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <!-- Decorative background shapes -->
    <div class="absolute inset-0">
        <!-- Large blurred gradient blob -->
        <div class="absolute -top-32 -left-32 w-96 h-96 bg-gradient-to-r from-green-600 to-blue-800 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>

        <!-- Smaller accent circle -->
        <div class="absolute top-20 right-20 w-40 h-40 bg-green-700 rounded-full opacity-30 animate-bounce"></div>

        <!-- Diagonal rectangle -->
        <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-green-800 opacity-40 transform rotate-12"></div>

        <!-- Triangle using clip-path -->
        <div class="absolute top-1/2 right-0 w-64 h-64 bg-blue-900 opacity-30"
             style="clip-path: polygon(0 0, 100% 0, 0 100%);">
        </div>
    </div>

    <!-- Content -->
    <div class="relative max-w-7xl mx-auto">
        <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
            <h1 class="text-4xl mt-5 md:text-5xl font-bold mb-2">Services</h1>
        </div>
    </div>
</section>

<!-- Services Grid -->
<section class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
        <div class="grid md:grid-cols-3 lg:grid-cols-3 gap-8">
            <!-- Education Service -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow" @onclick=GoToEducationService style="cursor: pointer;">
                <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1755859608390-8K6UY597102585EWC3DK/unsplash-image-83tkHLPgg2Q.jpg"
                     alt="Education" class="w-full h-56 object-cover">
                <div class="p-6">
                    <h3 class="text-xl font-semibold text-green-900 mb-3">EDUCATION</h3>
                    <p class="text-gray-600 mb-4">Specialized mental health programs and safeguarding solutions for educational institutions.</p>
                    <a href="/services/school-package" class="text-secondary font-medium hover:text-green-900 transition-colors">Learn More</a>
                </div>
            </div>

            <!-- Corporate Service -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow" @onclick=GoToCorporateService style="cursor: pointer;">
                <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1755860315993-TS8O2TSP2TESCTSAYUV7/unsplash-image-n95VMLxqM2I.jpg"
                     alt="Corporate" class="w-full h-56 object-cover">
                <div class="p-6">
                    <h3 class="text-xl font-semibold text-green-900 mb-3">CORPORATE</h3>
                    <p class="text-gray-600 mb-4">Workplace mental health programs and employee safeguarding initiatives.</p>
                    <a href="/services/company-package" class="text-secondary font-medium hover:text-green-900 transition-colors">Learn More</a>
                </div>
            </div>

            <!-- Healthcare Service -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow" @onclick=GoToHealthcareService style="cursor: pointer;">
                <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/08729196-ff49-4901-a747-1457caab553a/unsplash-image-hgD5IfjyIt8.jpg"
                     alt="Healthcare" class="w-full h-56 object-cover">
                <div class="p-6">
                    <h3 class="text-xl font-semibold text-green-900 mb-3">HEALTHCARE</h3>
                    <p class="text-gray-600 mb-4">Mental health support and safeguarding training for healthcare professionals.</p>
                    <a href="/services/health-care-package" class="text-secondary font-medium hover:text-green-900 transition-colors">Learn More</a>
                </div>
            </div>

            <!-- Community Service -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow" @onclick=GoToCommunityService style="cursor: pointer;">
                <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1756065844575-FYR6STBPIGWC8VPZKJAJ/unsplash-image-0cgpyigyIkM.jpg"
                     alt="Community" class="w-full h-56 object-cover">
                <div class="p-6">
                    <h3 class="text-xl font-semibold text-green-900 mb-3">COMMUNITY</h3>
                    <p class="text-gray-600 mb-4">Community-based mental health programs and public safeguarding awareness.</p>
                    <a href="/services/community-package" class="text-secondary font-medium hover:text-green-900 transition-colors">Learn More</a>
                </div>
            </div>

            <!-- Public Services -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow" @onclick=GoToPubliServices style="cursor: pointer;">
                <img src="https://images.squarespace-cdn.com/content/v1/68446487371399108ce11f7f/1755863017190-U4ON4758HAMDZIQOTUJY/unsplash-image-8wOToN7KeQ4.jpg"
                     alt="Public Services" class="w-full h-56 object-cover">
                <div class="p-6">
                    <h3 class="text-xl font-semibold text-green-900 mb-3">PUBLIC SERVICES</h3>
                    <p class="text-gray-600 mb-4">Mental health support for public service workers and safeguarding frameworks.</p>
                    <a href="services/public-services-package" class="text-secondary font-medium hover:text-green-900 transition-colors">Learn More</a>
                </div>
            </div>

            <!-- Consultation Card -->
            <div class="bg-gradient-to-br from-primary to-secondary rounded-lg shadow-md overflow-hidden text-primary">
                <div class="p-8 h-full flex flex-col justify-center">
                    <h3 class="text-2xl font-bold mb-4 text-green-900">Need Custom Solutions?</h3>
                    <p class="mb-6 text-secondary">We provide tailored mental health and safeguarding programs for your specific needs.</p>
                    <a href="/services/book-appointment"
                       class="bg-white text-green-900 px-6 py-3 rounded-lg font-semibold text-center transform hover:bg-gray-100 hover:text-primary transition-colors">
                        Book an Appointment
                    </a>
                </div>
            </div>    
        </div>
    </div>
</section>

@code {
    private void GoToEducationService()
    {
        NavigationManager.NavigateTo("/services/school-package");
    }
    private void GoToCorporateService()
    {
        NavigationManager.NavigateTo("/services/company-package");
    }
    private void GoToCommunityService()
    {
        NavigationManager.NavigateTo("/services/community-package");
    }
    private void GoToHealthcareService()
    {
        NavigationManager.NavigateTo("/services/health-care-package");
    }
    private void GoToPubliServices()
    {
        NavigationManager.NavigateTo("services/public-services-package");
    }
}
