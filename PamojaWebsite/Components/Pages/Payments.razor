@page "/payment"

<PageTitle>Payment | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!--Scripts-->
<head>
    <script src="payment.min.js" defer></script>
    <script defer src="https://js.stripe.com/v3/"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'auto'});
    </script>
</head>

@inject IJSRuntime JS
@inject MyApiService ApiService
@inject IMemoryCache Cache
@inject IHttpClientFactory ClientFactory
@inject PayPalOptions PayPalOpts
@inject NavigationManager NavigationManager
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

@rendermode InteractiveServer
<div class="pt-[5%] mb-5 py-20 mt-5">
    <div class="max-w-3xl mx-auto py-20 p-6">
        <main class="container mx-auto px-4 py-12">
            <div class="max-w-3xl mx-auto bg-white rounded-xl shadow-lg overflow-hidden">
                <div class="p-8">
                    <div class="text-center mb-8">
                        <i data-feather="check-circle" class="w-12 h-12 text-green-500 mx-auto"></i>
                        <h1 class="text-3xl font-bold text-gray-800 mt-4">Donation Invoice</h1>
                        <p class="text-gray-600 mt-2">Thank you for your generosity!</p>
                    </div>

                    <div class="border-b border-gray-200 pb-6 mb-6">
                        <div class="flex justify-between items-center mb-4">
                            <div>
                                <h2 class="text-lg font-semibold text-gray-800 mb-3">
                                    Pamoja Counselling, Mental Wellbeing and
                                    Safeguarding Services
                                </h2>
                                <p class="text-sm text-gray-600">
                                    Unit 3, Office A, 1st Floor, 6-7 St Mary At Hill

                                    London, EC3R 8EE, England
                                </p>
                            </div>
                            <div class="text-right">
                                @if (donation is not null)
                                {
                                    <p class="text-sm text-gray-600 mb-3">Invoice <span id="invoice-number">@donation.InvoiceNumber</span></p>
                                }
                                else
                                {
                                    <p class="text-sm text-gray-600">Invoice #<span id="invoice-number">Loading...</span></p>
                                }
                                <p class="text-sm text-gray-600"><span id="invoice-date">@DateOnly.FromDateTime(DateTime.UtcNow).ToLongDateString()</span></p>
                            </div>
                        </div>
                    </div>

                    <div class="mb-8">
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                                    </tr>
                                </thead>
                                @if (donation is not null)
                                {
                                    <tbody class="bg-white divide-y divide-gray-200">
                                        <tr>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Charitable Donation</td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" id="donation-amount">@CurrencySymbols[donation.Currency]@donation.Amount</td>
                                        </tr>
                                        <tr>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Processing Fee</td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" id="processing-fee">@CurrencySymbols[donation.Currency]@donation.ProcessingFee</td>
                                        </tr>
                                        <tr class="bg-gray-50">
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Total</td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900" id="total-amount">@CurrencySymbols[donation.Currency]@donation.Total</td>
                                        </tr>
                                    </tbody>
                                }
                                else
                                {
                                    <tbody class="bg-white divide-y divide-gray-200">
                                        <tr>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Charitable Donation</td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" id="donation-amount">Loading...</td>
                                        </tr>
                                        <tr>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Processing Fee</td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" id="processing-fee">Loading...</td>
                                        </tr>
                                        <tr class="bg-gray-50">
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Total</td>
                                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900" id="total-amount">Loading...</td>
                                        </tr>
                                    </tbody>
                                }
                            </table>
                        </div>
                    </div>

                    <div class="bg-green-50 rounded-lg p-4 mb-6">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <i data-feather="info" class="h-5 w-5 text-green-600"></i>
                            </div>
                            <div class="ml-3">
                                <h3 class="text-sm font-medium text-green-800">Your donation is tax deductible</h3>
                                <div class="mt-2 text-sm text-green-700">
                                    <p>
                                        Pamoja Counselling, Mental Wellbeing and Safeguarding Services is a registered 501(c)(3)
                                        nonprofit organization. Your donation is tax-deductible to the extent allowed by law.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <h1 class="text-2xl font-semibold mb-4">Checkout</h1>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <button class=@($"px-4 py-2 rounded border-2 {(selected == PaymentMethod.Stripe ? "border-green-600" : "border-gray-300 hover:bg-gray-50")}")
                    @onclick="() => SelectMethod(PaymentMethod.Stripe)">
                Credit/Debit Card
            </button>

            <button class=@($"px-4 py-2 rounded border-2 {(selected == PaymentMethod.PayPal ? "border-green-600" : "border-gray-300 hover:bg-gray-50")}")
                    @onclick="() => SelectMethod(PaymentMethod.PayPal)">
                PayPal
            </button>

            <button class=@($"px-4 py-2 rounded border-2 {(selected == PaymentMethod.Mpesa ? "border-green-600" : "border-gray-300 hover:bg-gray-50")}")
                    @onclick="() => SelectMethod(PaymentMethod.Mpesa)">
                M‑Pesa
            </button>
        </div>

        <div class="mt-6" style="display:@(selected == PaymentMethod.Stripe ? "block" : "none")">
            <div id="stripe-payment-element" class="p-4 border rounded"></div>
            <button class="mt-4 px-4 py-2 bg-green-600 text-white rounded" @onclick="ConfirmStripe" disabled="@isProcessing">
                @(isProcessing ? "Processing" + "..." : "Pay")
            </button>
        </div>
        @if (donation is not null)
        {
            <div class="mt-6" style="display:@(selected == PaymentMethod.PayPal ? "block" : "none")">
                <script src="https://www.paypal.com/sdk/js?client-id=@paypalClientId&currency=@donation.Currency"></script>
                <div id="paypal-buttons" class="p-2"></div>
            </div>
        }
        else
        {
            <div class="mt-6" style="display:@(selected == PaymentMethod.PayPal ? "block" : "none")">
                <script src="https://www.paypal.com/sdk/js?client-id=@paypalClientId&currency=@currency"></script>
                <div id="paypal-buttons" class="p-2"></div>
            </div>
        }
        <div class="mt-6 space-y-4" style="display:@(selected == PaymentMethod.Mpesa ? "block" : "none")">
            <label class="block">
                <span class="text-sm text-gray-700">Phone (E.164, e.g., 2547XXXXXXXX)</span>
                <input class="mt-1 w-full border rounded px-3 py-2" @bind="mpesaPhone" />
            </label>
            <button class="px-4 py-2 bg-green-600 text-white rounded" @onclick="SendStkPush">Send STK Push</button>
            @if (!string.IsNullOrEmpty(success_message))
            {
                <p class="mt-2 text-sm text-green-700">@success_message</p>
            }
            @if (!string.IsNullOrEmpty(failure_message))
            {
                <p class="mt-2 text-sm text-red-700">@failure_message</p>
            }
        </div>
    </div>
</div>

@code {
    enum PaymentMethod { Stripe, PayPal, Mpesa }

    PaymentMethod selected = PaymentMethod.Stripe;

    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    private string? id;

    [Parameter]
    public Donation? donation { get; set; }
    private Payment? Payment;
    private bool isProcessing = false;

    private IJSObjectReference? paymentModule;
    private IJSObjectReference? stripeSession;

    Dictionary<string, string> CurrencySymbols = new()
    {
        { "USD", "$" },
        { "EUR", "€" },
        { "GBP", "£" },
        { "JPY", "¥" },
        { "CAD", "C$" },
        { "AUD", "A$" },
        { "KES", "KSh" }
    };

    long amountCents;
    string mpesaPhone = "";
    string message = "";
    string currency = "USD";
    string failure_message = "";
    string success_message = "";

    // For PayPal script load
    string paypalClientId => PayPalOpts.ClientId;

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var donations = await (await ApiService.GetClient()).GetFromJsonAsync<List<Donation>>("api/donations");
        donation = donation ?? donations.FirstOrDefault(d => d.Id == id);
        if (donation is not null)
            amountCents = (long)(donation.Amount * 100);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Import the module once
            paymentModule = await JS.InvokeAsync<IJSObjectReference>("import", "/payment.min.js");

            // Initialize Stripe and keep the returned session reference
            stripeSession = await paymentModule.InvokeAsync<IJSObjectReference>(
                "initStripePayment", amountCents, donation.Currency, donation.Email);
        }

        if (selected == PaymentMethod.PayPal && paymentModule != null)
        {
            // Call your exported function
            await paymentModule.InvokeVoidAsync("renderPayPal", (double)donation.Amount, donation.Currency);
        }
    }

    async Task ConfirmStripe()
    {
        if (stripeSession is not null)
        {
            isProcessing = true;
            // Call the submit() function you returned in payments.js
            var result = await stripeSession.InvokeAsync<PaymentResult>("submit");

            if (!result.Success && result.Error is not null)
            {
                var error = result.Error;
                //message = error.message;
                NavigationManager.NavigateTo($"/payment-unsuccessful?message={message}");
            }
            else
            {
                message = "Payment confirmed!";
            }
            Payment payment = new Payment();
            payment.Name = donation.Name;
            payment.InvoiceNumber = donation.InvoiceNumber;
            payment.Email = donation.Email;
            payment.Amount = donation.Amount;
            payment.Total = donation.Total;
            payment.Currency = donation.Currency;
            payment.ProcessingFee = donation.ProcessingFee;
            payment.CentsAmount = amountCents;
            payment.PaymentMethod = "Stripe";
            Payment = payment;
            using var context = DbFactory.CreateDbContext();
            context.Payment.Add(payment);
            await context.SaveChangesAsync();
            isProcessing = false;
            NavigationManager.NavigateTo($"/payment-confirmation?Id={payment.Id}");
        }
    }

    async Task SendStkPush()
    {
        isProcessing = true;
        var response = await (await ApiService.GetClient()).PostAsJsonAsync("/api/mpesa/stkpush", new { phone = mpesaPhone, amount = donation.Total });

        if (response.IsSuccessStatusCode)
        {
            message = response.IsSuccessStatusCode ? "STK push sent. Check your phone." : "Failed to send STK push.";
            success_message = response.IsSuccessStatusCode ? "STK push sent. Check your phone." : null;
            // ✅ Redirect after backend confirms payment
            NavigationManager.NavigateTo($"/payment-confirmation?Id={Payment.Id}");
        }
        else
        {
            failure_message = response.IsSuccessStatusCode ? null : "Failed to send STK push.";
            NavigationManager.NavigateTo($"/payment-unsuccessful?message={failure_message}");
        }
        isProcessing = false;
        
    }

    void SelectMethod(PaymentMethod method)
    {
        selected = method;
        message = "";
        StateHasChanged();
    }
    public class PaymentResult
    {
        public bool Success { get; set; }
        public object? Error { get; set; }
    }

}