@page "/tableofcontents/delete"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Delete</h1>

    <p>Are you sure you want to delete this?</p>
    <div>
        <h2>TableOfContents</h2>
        <hr />
        @if (tableofcontents is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Title</dt>
                <dd class="col-sm-10">@tableofcontents.Title</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Anchor</dt>
                <dd class="col-sm-10">@tableofcontents.Anchor</dd>
            </dl>
            <EditForm method="post" Model="tableofcontents" OnValidSubmit="DeleteTableOfContents" FormName="delete" Enhance>
                <button type="submit" class="btn btn-danger" disabled="@(tableofcontents is null)">Delete</button> |
                <a href="/tableofcontents">Back to List</a>
            </EditForm>
        }
    </div>
</div>

@code {
    private TableOfContents? tableofcontents;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        tableofcontents = await context.TableOfContents.FirstOrDefaultAsync(m => m.Id == Id);

        if (tableofcontents is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteTableOfContents()
    {
        using var context = DbFactory.CreateDbContext();
        context.TableOfContents.Remove(tableofcontents!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/tableofcontents");
    }
}
