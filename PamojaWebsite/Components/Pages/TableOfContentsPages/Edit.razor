@page "/tableofcontents/edit"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Edit</h1>

    <h2>TableOfContents</h2>
    <hr />
    @if (TableOfContents is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="row">
            <div class="col-md-4">
                <EditForm method="post" Model="TableOfContents" OnValidSubmit="UpdateTableOfContents" FormName="edit" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary role="alert" />
                    <input type="hidden" name="TableOfContents.Id" value="@TableOfContents.Id" />
                    <div class="mb-3">
                        <label for="title" class="form-label">Title:</label>
                        <InputText id="title" @bind-Value="TableOfContents.Title" class="form-control" />
                        <ValidationMessage For="() => TableOfContents.Title" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="anchor" class="form-label">Anchor:</label>
                        <InputText id="anchor" @bind-Value="TableOfContents.Anchor" class="form-control" />
                        <ValidationMessage For="() => TableOfContents.Anchor" class="text-danger" />
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </EditForm>
            </div>
        </div>
    }

    <div>
        <a href="/tableofcontents">Back to List</a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string Id { get; set; }

    [SupplyParameterFromForm]
    private TableOfContents? TableOfContents { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        TableOfContents ??= await context.TableOfContents.FirstOrDefaultAsync(m => m.Id == Id);

        if (TableOfContents is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateTableOfContents()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(TableOfContents!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!TableOfContentsExists(TableOfContents!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/tableofcontents");
    }

    private bool TableOfContentsExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.TableOfContents.Any(e => e.Id == id);
    }
}
