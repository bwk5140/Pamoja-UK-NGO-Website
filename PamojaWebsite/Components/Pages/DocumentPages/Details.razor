@page "/documents/details"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Details</h1>

    <div>
        <h2>Document</h2>
        <hr />
        @if (document is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Title</dt>
                <dd class="col-sm-10">@document.Title</dd>
                <dt class="col-sm-2">Description</dt>
                <dd class="col-sm-10">@document.Description</dd>
                <dt class="col-sm-2">Category</dt>
                <dd class="col-sm-10">@document.Category</dd>
                <dt class="col-sm-2">ContentType</dt>
                <dd class="col-sm-10">@document.ContentType</dd>
                <dt class="col-sm-2">Data</dt>
                <dd class="col-sm-10">@document.Data</dd>
            </dl>
            <div>
                <a href="@($"/documents/edit?id={document.Id}")">Edit</a> |
                <a href="@($"/documents")">Back to List</a>
            </div>
        }
    </div>
</div>

@code {
    private Document? document;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        document = await context.Document.FirstOrDefaultAsync(m => m.Id == Id);

        if (document is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
