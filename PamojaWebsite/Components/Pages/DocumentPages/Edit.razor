@page "/documents/edit"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Edit</h1>

    <h2>Document</h2>
    <hr />
    @if (Document is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="row">
            <div class="col-md-4">
                <EditForm method="post" Model="Document" OnValidSubmit="UpdateDocument" FormName="edit" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary role="alert" />
                    <input type="hidden" name="Document.Id" value="@Document.Id" />
                    <div class="mb-3">
                        <label for="title" class="form-label">Title:</label>
                        <InputText id="title" @bind-Value="Document.Title" class="form-control" />
                        <ValidationMessage For="() => Document.Title" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description:</label>
                        <InputText id="description" @bind-Value="Document.Description" class="form-control" />
                        <ValidationMessage For="() => Document.Description" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="category" class="form-label">Category:</label>
                        <InputText id="category" @bind-Value="Document.Category" class="form-control" />
                        <ValidationMessage For="() => Document.Category" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="contenttype" class="form-label">ContentType:</label>
                        <InputText id="contenttype" @bind-Value="Document.ContentType" class="form-control" />
                        <ValidationMessage For="() => Document.ContentType" class="text-danger" />
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </EditForm>
            </div>
        </div>
    }

    <div>
        <a href="/documents">Back to List</a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string Id { get; set; }

    [SupplyParameterFromForm]
    private Document? Document { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Document ??= await context.Document.FirstOrDefaultAsync(m => m.Id == Id);

        if (Document is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateDocument()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Document!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!DocumentExists(Document!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/documents");
    }

    private bool DocumentExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Document.Any(e => e.Id == id);
    }
}
