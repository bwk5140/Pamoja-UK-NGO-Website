@page "/documents/create"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Create</h1>

    <h2>Document</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Document" OnValidSubmit="AddDocument" FormName="create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <label for="title" class="form-label">Title:</label>
                    <InputText id="title" @bind-Value="Document.Title" class="form-control" />
                    <ValidationMessage For="() => Document.Title" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label>
                    <InputText id="description" @bind-Value="Document.Description" class="form-control" />
                    <ValidationMessage For="() => Document.Description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="category" class="form-label">Category:</label>
                    <InputText id="category" @bind-Value="Document.Category" class="form-control" />
                    <ValidationMessage For="() => Document.Category" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="contenttype" class="form-label">ContentType:</label>
                    <InputText id="contenttype" @bind-Value="Document.ContentType" class="form-control" />
                    <ValidationMessage For="() => Document.ContentType" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
        </div>
    </div>

    <div>
        <a href="/documents">Back to List</a>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Document Document { get; set; } = default!;

    protected override void OnInitialized() => Document ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddDocument()
    {
        using var context = DbFactory.CreateDbContext();
        context.Document.Add(Document);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/documents");
    }
}
