@page "/countrycodes/delete"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Delete</h1>

    <p>Are you sure you want to delete this?</p>
    <div>
        <h2>CountryCode</h2>
        <hr />
        @if (countrycode is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Code</dt>
                <dd class="col-sm-10">@countrycode.Code</dd>
            </dl>
            <EditForm method="post" Model="countrycode" OnValidSubmit="DeleteCountryCode" FormName="delete" Enhance>
                <button type="submit" class="btn btn-danger" disabled="@(countrycode is null)">Delete</button> |
                <a href="/countrycodes">Back to List</a>
            </EditForm>
        }
    </div>
</div>

@code {
    private CountryCode? countrycode;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        countrycode = await context.CountryCode.FirstOrDefaultAsync(m => m.Id == Id);

        if (countrycode is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteCountryCode()
    {
        using var context = DbFactory.CreateDbContext();
        context.CountryCode.Remove(countrycode!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/countrycodes");
    }
}
