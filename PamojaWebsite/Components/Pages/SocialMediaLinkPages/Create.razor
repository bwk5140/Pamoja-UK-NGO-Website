@page "/socialmedialinks/create"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Create</h1>

    <h2>SocialMediaLink</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="SocialMediaLink" OnValidSubmit="AddSocialMediaLink" FormName="create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <label for="platform" class="form-label">Platform:</label>
                    <InputText id="platform" @bind-Value="SocialMediaLink.Platform" class="form-control" />
                    <ValidationMessage For="() => SocialMediaLink.Platform" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="url" class="form-label">Url:</label>
                    <InputText id="url" @bind-Value="SocialMediaLink.Url" class="form-control" />
                    <ValidationMessage For="() => SocialMediaLink.Url" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
        </div>
    </div>

    <div>
        <a href="/socialmedialinks">Back to List</a>
    </div>
</div>


@code {
    [SupplyParameterFromForm]
    private SocialMediaLink SocialMediaLink { get; set; } = default!;

    protected override void OnInitialized() => SocialMediaLink ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddSocialMediaLink()
    {
        using var context = DbFactory.CreateDbContext();
        context.SocialMediaLink.Add(SocialMediaLink);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/socialmedialinks");
    }
}
