@page "/tags"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using PamojaWebsite.Data
@using PamojaWebsite.Data.Contexts
@implements IAsyncDisposable
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory

<PageTitle>Index</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Index</h1>

    <p>
        <a href="tags/create">Create New</a>
    </p>

    <QuickGrid Class="table" Items="context.Tag">
        <PropertyColumn Property="tag => tag.Name" />

        <TemplateColumn Context="tag">
            <a href="@($"tags/edit?id={tag.Id}")">Edit</a> |
            <a href="@($"tags/details?id={tag.Id}")">Details</a> |
            <a href="@($"tags/delete?id={tag.Id}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
</div>

@code {
    private ApplicationDbContext context = default!;

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        await ImportTagsFromFile("C:/Users/brian/Desktop/Apps/PamojaWebsiteUK/PamojaWebsite/Tags.txt");
    }
    public async Task ImportTagsFromFile(string filePath)
    {
        // Read all lines from the text file
        var lines = await File.ReadAllLinesAsync(filePath);

        foreach (var line in lines)
        {
            var tagName = line.Trim();

            if (string.IsNullOrWhiteSpace(tagName))
                continue;

            // Check if tag already exists
            var exists = await context.Tag.AnyAsync(t => t.Name == tagName);
            if (!exists)
            {
                var tag = new Tag
                {
                    Name = tagName
                };

                context.Tag.Add(tag);
            }
        }
        await context.SaveChangesAsync();
    }
    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
