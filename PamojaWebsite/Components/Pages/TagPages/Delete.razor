@page "/tags/delete"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Delete</h1>

    <p>Are you sure you want to delete this?</p>
    <div>
        <h2>Tag</h2>
        <hr />
        @if (tag is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Name</dt>
                <dd class="col-sm-10">@tag.Name</dd>
            </dl>
            <EditForm method="post" Model="tag" OnValidSubmit="DeleteTag" FormName="delete" Enhance>
                <button type="submit" class="btn btn-danger" disabled="@(tag is null)">Delete</button> |
                <a href="/tags">Back to List</a>
            </EditForm>
        }
    </div>
</div>


@code {
    private Tag? tag;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        tag = await context.Tag.FirstOrDefaultAsync(m => m.Id.ToString() == Id);

        if (tag is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteTag()
    {
        using var context = DbFactory.CreateDbContext();
        context.Tag.Remove(tag!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/tags");
    }
}
