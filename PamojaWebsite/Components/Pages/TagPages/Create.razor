@page "/tags/create"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Create</h1>

    <h2>Tag</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Tag" OnValidSubmit="AddTag" FormName="create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Tag.Name" class="form-control" />
                    <ValidationMessage For="() => Tag.Name" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
        </div>
    </div>

    <div>
        <a href="/tags">Back to List</a>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Tag Tag { get; set; } = default!;

    protected override void OnInitialized() => Tag ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddTag()
    {
        using var context = DbFactory.CreateDbContext();
        context.Tag.Add(Tag);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/tags");
    }
}
