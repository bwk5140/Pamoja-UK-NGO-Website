@page "/about-us/isabella-munandi"
@rendermode InteractiveServer
<PageTitle>Isabella Munandi | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>
@inject NavigationManager NavigationManager
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
<script>
    function loadGA() {
      if (window.gaLoaded) return;
      window.gaLoaded = true;

      var script = document.createElement('script');
      script.src = "https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG";
      script.async = true;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'pamojasafeguardingnetwork.co.uk', 'anonymize_ip': true});
    }

    // Fire when browser is idle or after first interaction
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => setTimeout(loadGA, 2000));
    } else {
      setTimeout(loadGA, 3000);
    }
</script>
<div class="sm:pt-[10%] md:pt-[4%] mb-5 py-20">
    <!-- Hero Section -->
    <section class="relative py-20 mt-5 bg-orange-900 text-white py-2 px-4 sm:px-6 lg:px-8 overflow-hidden">
        <!-- Decorative background shapes -->
        <div class="absolute inset-0">
            <!-- Large blurred gradient blob -->
            <div class="absolute -top-32 -left-32 w-96 h-96 bg-gradient-to-r from-orange-600 to-yellow-800 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-pulse"></div>

            <!-- Smaller accent circle -->
            <div class="absolute top-20 right-20 w-40 h-40 bg-orange-700 rounded-full opacity-30 animate-bounce"></div>

            <!-- Diagonal rectangle -->
            <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-orange-800 opacity-40 transform rotate-12"></div>

            <!-- Triangle using clip-path -->
            <div class="absolute top-1/2 right-0 w-64 h-64 bg-blue-900 opacity-30"
                 style="clip-path: polygon(0 0, 100% 0, 0 100%);">
            </div>
        </div>

        <!-- Content -->
        <div class="relative max-w-7xl mx-auto">
            <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
                <h1 class="text-4xl mt-5 md:text-5xl font-bold mb-2">Isabella Munandi</h1>
            </div>
            <div class="md:grid md:grid-cols-2 md:gap-12 items-center">
                <h2 class="text-2xl md:text-3xl mb-2 font-light">Board Member</h2>
            </div>
        </div>
    </section>


    <!-- Bio Section -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-6 lg:px-8">
            <div class="max-w-4xl mx-auto">
                <nav class="flex items-center text-sm text-gray-600 mb-6" aria-label="Breadcrumb">
                    <ol class="inline-flex items-center space-x-1 md:space-x-3">
                        <!-- About Us -->
                        <li class="inline-flex items-center">
                            <a href="/about-us" aria-label="Navigate to about-us"
                               class="inline-flex items-center text-red-700 hover:text-red-800 font-medium">
                                About Us
                            </a>
                        </li>

                        <!-- Separator -->
                        <li>
                            <div class="flex items-center">
                                <svg aria-label="Separator" class="w-4 h-4 text-gray-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd"
                                          d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                          clip-rule="evenodd" />
                                </svg>
                                <a href="/about-us/isabella-munandi" aria-label="Navigate to current page"
                                   class="ml-1 text-red-700 hover:text-red-800 font-medium font-bold">
                                    Isabella Munandi
                                </a>
                            </div>
                        </li>
                    </ol>
                </nav>
                <!-- Right-aligned image with abstract shapes -->
                @* <div class="relative flex justify-end py-20">
                    <!-- Image itself -->
                    <img fetchpriority="high"
                         loading="eager" src="Images/Team/Isabella_Munandi.webp"
                         alt="Isabella Munandi"
                         class="relative z-10 w-96 h-96 md:w-72 rounded-lg object-cover object-top shadow-lg rounded-15" />
                </div> *@
                <p class="text-s text-gray-900 mb-3">
                    Isabella Kambua Munandi is a Kenyan Sociologist and Social Safeguards Specialist with over twenty-five years of professional experience in social safeguards, social risk management, 
                    research, monitoring, evaluation and learning, and community development. She has supported the Government of Kenya, 
                    development partners and consulting organisations in the design, implementation and oversight of infrastructure and development programmes across Kenya and the Eastern Africa region.
                </p>
                <p class="text-s text-gray-900 mb-3">
                    Her work has focused on strengthening institutions, promoting inclusive stakeholder engagement, managing social risks, supporting community development, and enhancing compliance with national 
                    and international environmental and social standards. She has provided technical advisory services across the transport, water, urban development and community infrastructure sectors, helping 
                    organisations strengthen governance, accountability, and sustainable development outcomes.
                </p>
                <p class="text-s text-gray-900 mb-3">
                    Isabella is passionate about strengthening institutions and advancing practical approaches to safeguarding, ethical governance and the wellbeing of individuals and communities.
                </p>
                <p class="text-s text-gray-900 mb-3">
                    In addition to her consultancy work, Isabella provides training support to the Wangari Maathai Institute for Peace and Environmental Studies at the University of Nairobi through its Environmental 
                    Impact Assessment (EIA) Short Course programme. She contributes to the professional training of environmental assessment practitioners on Resettlement Action Plans (RAPs), with particular emphasis 
                    on the relationship between Environmental and Social Impact Assessment (ESIA) and RAP preparation.
                </p>
                <p class="text-s text-gray-900 mb-3">
                    As a Board Member of the Pamoja Mental Health and Safeguarding Network, Isabella contributes her experience in governance, social risk management and institutional strengthening to support the Network's 
                    mission of promoting safeguarding, mental wellbeing, and accountable organisational practice.
                </p>
            </div>
        </div>
    </section>
</div>
