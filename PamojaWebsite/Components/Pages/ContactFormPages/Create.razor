@page "/contactforms/create"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Create</h1>

    <h2>ContactForm</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="ContactForm" OnValidSubmit="AddContactForm" FormName="create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="ContactForm.Name" class="form-control" />
                    <ValidationMessage For="() => ContactForm.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="organization" class="form-label">Organization:</label>
                    <InputText id="organization" @bind-Value="ContactForm.Organization" class="form-control" />
                    <ValidationMessage For="() => ContactForm.Organization" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email:</label>
                    <InputText id="email" @bind-Value="ContactForm.Email" class="form-control" />
                    <ValidationMessage For="() => ContactForm.Email" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="phone" class="form-label">Phone:</label>
                    <InputText id="phone" @bind-Value="ContactForm.Phone" class="form-control" />
                    <ValidationMessage For="() => ContactForm.Phone" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="selectedservice" class="form-label">SelectedService:</label>
                    <InputText id="selectedservice" @bind-Value="ContactForm.SelectedService" class="form-control" />
                    <ValidationMessage For="() => ContactForm.SelectedService" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="message" class="form-label">Message:</label>
                    <InputText id="message" @bind-Value="ContactForm.Message" class="form-control" />
                    <ValidationMessage For="() => ContactForm.Message" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="package" class="form-label">Package:</label>
                    <InputText id="package" @bind-Value="ContactForm.Package" class="form-control" />
                    <ValidationMessage For="() => ContactForm.Package" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="receivedat" class="form-label">ReceivedAt:</label>
                    <InputDate id="receivedat" @bind-Value="ContactForm.ReceivedAt" class="form-control" />
                    <ValidationMessage For="() => ContactForm.ReceivedAt" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
        </div>
    </div>

    <div>
        <a href="/contactforms">Back to List</a>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private ContactForm ContactForm { get; set; } = default!;

    protected override void OnInitialized() => ContactForm ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddContactForm()
    {
        using var context = DbFactory.CreateDbContext();
        context.ContactForm.Add(ContactForm);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/contactforms");
    }
}
