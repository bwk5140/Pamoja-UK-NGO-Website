@page "/contactforms/details"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Details</h1>

    <div>
        <h2>ContactForm</h2>
        <hr />
        @if (contactform is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Name</dt>
                <dd class="col-sm-10">@contactform.Name</dd>
                <dt class="col-sm-2">Organization</dt>
                <dd class="col-sm-10">@contactform.Organization</dd>
                <dt class="col-sm-2">Email</dt>
                <dd class="col-sm-10">@contactform.Email</dd>
                <dt class="col-sm-2">Phone</dt>
                <dd class="col-sm-10">@contactform.Phone</dd>
                <dt class="col-sm-2">SelectedService</dt>
                <dd class="col-sm-10">@contactform.SelectedService</dd>
                <dt class="col-sm-2">Message</dt>
                <dd class="col-sm-10">@contactform.Message</dd>
                <dt class="col-sm-2">Package</dt>
                <dd class="col-sm-10">@contactform.Package</dd>
                <dt class="col-sm-2">ReceivedAt</dt>
                <dd class="col-sm-10">@contactform.ReceivedAt</dd>
            </dl>
            <div>
                <a href="@($"/contactforms/edit?id={contactform.Id}")">Edit</a> |
                <a href="@($"/contactforms")">Back to List</a>
            </div>
        }
    </div>
</div>

@code {
    private ContactForm? contactform;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        contactform = await context.ContactForm.FirstOrDefaultAsync(m => m.Id == Id);

        if (contactform is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
