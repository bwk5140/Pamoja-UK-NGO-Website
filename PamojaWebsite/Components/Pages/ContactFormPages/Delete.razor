@page "/contactforms/delete"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Delete</h1>

    <p>Are you sure you want to delete this?</p>
    <div>
        <h2>ContactForm</h2>
        <hr />
        @if (contactform is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Name</dt>
                <dd class="col-sm-10">@contactform.Name</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Organization</dt>
                <dd class="col-sm-10">@contactform.Organization</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Email</dt>
                <dd class="col-sm-10">@contactform.Email</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Phone</dt>
                <dd class="col-sm-10">@contactform.Phone</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">SelectedService</dt>
                <dd class="col-sm-10">@contactform.SelectedService</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Message</dt>
                <dd class="col-sm-10">@contactform.Message</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">Package</dt>
                <dd class="col-sm-10">@contactform.Package</dd>
            </dl>
            <dl class="row">
                <dt class="col-sm-2">ReceivedAt</dt>
                <dd class="col-sm-10">@contactform.ReceivedAt</dd>
            </dl>
            <EditForm method="post" Model="contactform" OnValidSubmit="DeleteContactForm" FormName="delete" Enhance>
                <button type="submit" class="btn btn-danger" disabled="@(contactform is null)">Delete</button> |
                <a href="/contactforms">Back to List</a>
            </EditForm>
        }
    </div>
</div>

@code {
    private ContactForm? contactform;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        contactform = await context.ContactForm.FirstOrDefaultAsync(m => m.Id == Id);

        if (contactform is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteContactForm()
    {
        using var context = DbFactory.CreateDbContext();
        context.ContactForm.Remove(contactform!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/contactforms");
    }
}
