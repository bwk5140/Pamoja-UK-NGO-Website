@page "/payment-unsuccessful"
@using Microsoft.JSInterop
@using System.Linq.Expressions
@using System.ComponentModel.DataAnnotations

@inject MyApiService ApiService
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS
@inject IMemoryCache Cache
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Payment-Unsuccessful | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
<script>
    function loadGA() {
      if (window.gaLoaded) return;
      window.gaLoaded = true;

      var script = document.createElement('script');
      script.src = "https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG";
      script.async = true;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'pamojasafeguardingnetwork.co.uk', 'anonymize_ip': true});
    }

    // Fire when browser is idle or after first interaction
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => setTimeout(loadGA, 2000));
    } else {
      setTimeout(loadGA, 3000);
    }
</script>

@rendermode InteractiveServer
<div class="sm:pt-[10%] md:pt-[4%] mb-5 py-20">
    <div class="max-w-screen-sm mx-auto">
        <div class="mt-5 text-center text-[#2f4f4f]">
            <a href="/" class="no-underline" alt="Navigate to the home page">
                <img fetchpriority="high"
                     loading="eager" alt="Pamoja logo" class="mb-2" src="Images/PamojaLogo.png" width="80" height="60" />
            </a>
            <div class="max-w-screen-sm mx-auto mt-5 text-center text-gray-600">
                <!-- Centered container -->
                <div class="flex justify-center">
                    <!-- Card -->
                    <div class="max-w-[350px] w-full bg-white shadow rounded">
                        <!-- Card header -->
                        <div class="px-4 py-2 border-b">
                            <strong>Payment Abandoned</strong>
                        </div>

                        <!-- Card body -->
                        <div class="p-4">
                            <!-- Red alert card -->
                            <div class="mt-2 mb-2 max-w-[1200px] border-l-8 border-r-2 border-t-2 border-b-2 border-red-600 text-red-600 bg-white rounded">
                                <div class="p-2 flex items-center space-x-2">
                                    <img fetchpriority="high"
                                         loading="eager" alt="Info circle red icon" src="Icons/info-circle-red.svg" />
                                    <span>Your payment was unsuccessful.</span>
                                </div>
                            </div>

                            <p>Status: @message</p>

                            <!-- Blue info card -->
                            <div class="mt-2 mb-2 text-gray-600 bg-white rounded">
                                <div class="p-2">
                                    You have not been charged
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    [SupplyParameterFromQuery]
    public string? message { get; set; }

    private string? id;

    [Parameter]
    public Payment? payment { get; set; }

    Dictionary<string, string> CurrencySymbols = new()
    {
        { "USD", "$" },
        { "EUR", "€" },
        { "GBP", "£" },
        { "JPY", "¥" },
        { "CAD", "C$" },
        { "AUD", "A$" },
        { "KES", "KSh" }
    };

    protected override async Task OnInitializedAsync()
    {
        var payments = await ApiService.GetHttpClient().GetFromJsonAsync<List<Payment>>("api/Db/refreshed-payments");
        payment = payment ?? payments.FirstOrDefault(d => d.Id == id);
    }
}
