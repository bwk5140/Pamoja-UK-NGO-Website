@page "/blogcategories/create"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Create</h1>

    <h2>BlogCategory</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="BlogCategory" OnValidSubmit="AddBlogCategory" FormName="create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="BlogCategory.Name" class="form-control" />
                    <ValidationMessage For="() => BlogCategory.Name" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
        </div>
    </div>

    <div>
        <a href="/blogcategories">Back to List</a>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private BlogCategory BlogCategory { get; set; } = default!;

    protected override void OnInitialized() => BlogCategory ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddBlogCategory()
    {
        using var context = DbFactory.CreateDbContext();
        context.BlogCategory.Add(BlogCategory);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/blogcategories");
    }
}
