@page "/blogcategories/details"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Details</h1>

    <div>
        <h2>BlogCategory</h2>
        <hr />
        @if (blogcategory is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Name</dt>
                <dd class="col-sm-10">@blogcategory.Name</dd>
            </dl>
            <div>
                <a href="@($"/blogcategories/edit?id={blogcategory.Id}")">Edit</a> |
                <a href="@($"/blogcategories")">Back to List</a>
            </div>
        }
    </div>
</div>

@code {
    private BlogCategory? blogcategory;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        blogcategory = await context.BlogCategory.FirstOrDefaultAsync(m => m.Id == Id);

        if (blogcategory is null)
        {
            NavigationManager.NavigateTo("/not-found");
        }
    }
}
