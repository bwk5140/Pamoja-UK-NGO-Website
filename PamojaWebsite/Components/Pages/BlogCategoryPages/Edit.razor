@page "/blogcategories/edit"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Edit</h1>

    <h2>BlogCategory</h2>
    <hr />
    @if (BlogCategory is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="row">
            <div class="col-md-4">
                <EditForm method="post" Model="BlogCategory" OnValidSubmit="UpdateBlogCategory" FormName="edit" Enhance>
                    <DataAnnotationsValidator />
                    <ValidationSummary role="alert" />
                    <input type="hidden" name="BlogCategory.Id" value="@BlogCategory.Id" />
                    <div class="mb-3">
                        <label for="name" class="form-label">Name:</label>
                        <InputText id="name" @bind-Value="BlogCategory.Name" class="form-control" />
                        <ValidationMessage For="() => BlogCategory.Name" class="text-danger" />
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </EditForm>
            </div>
        </div>
    }

    <div>
        <a href="/blogcategories">Back to List</a>
    </div>
</div>


@code {
    [SupplyParameterFromQuery]
    private string Id { get; set; }

    [SupplyParameterFromForm]
    private BlogCategory? BlogCategory { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        BlogCategory ??= await context.BlogCategory.FirstOrDefaultAsync(m => m.Id == Id);

        if (BlogCategory is null)
        {
            NavigationManager.NavigateTo("/not-found");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateBlogCategory()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(BlogCategory!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!BlogCategoryExists(BlogCategory!.Id))
            {
                NavigationManager.NavigateTo("/not-found");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/blogcategories");
    }

    private bool BlogCategoryExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.BlogCategory.Any(e => e.Id == id);
    }
}
