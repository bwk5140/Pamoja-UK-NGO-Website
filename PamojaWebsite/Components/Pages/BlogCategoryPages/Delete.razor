@page "/blogcategories/delete"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <h1>Delete</h1>

    <p>Are you sure you want to delete this?</p>
    <div>
        <h2>BlogCategory</h2>
        <hr />
        @if (blogcategory is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Name</dt>
                <dd class="col-sm-10">@blogcategory.Name</dd>
            </dl>
            <EditForm method="post" Model="blogcategory" OnValidSubmit="DeleteBlogCategory" FormName="delete" Enhance>
                <button type="submit" class="btn btn-danger" disabled="@(blogcategory is null)">Delete</button> |
                <a href="/blogcategories">Back to List</a>
            </EditForm>
        }
    </div>
</div>

@code {
    private BlogCategory? blogcategory;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        blogcategory = await context.BlogCategory.FirstOrDefaultAsync(m => m.Id == Id);

        if (blogcategory is null)
        {
            NavigationManager.NavigateTo("/not-found");
        }
    }

    private async Task DeleteBlogCategory()
    {
        using var context = DbFactory.CreateDbContext();
        context.BlogCategory.Remove(blogcategory!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/blogcategories");
    }
}
