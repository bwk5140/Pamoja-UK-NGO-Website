@using Microsoft.AspNetCore.Identity
@using PamojaWebsite.Data

@inject IStringLocalizer<SharedResource> Loc

@inject SignInManager<ApplicationUser> SignInManager

<div class="pt-[5%] mb-5 py-20">
    <ul class="flex flex-col space-y-2">
        <li>
            <NavLink href="Account/Manage" Match="NavLinkMatch.All"
                     class="block px-4 py-2 rounded-md hover:bg-blue-100 hover:text-blue-700"
                     activeClass="bg-green-800 text-white">
                @Loc["Username"]
            </NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/Name"
                     class="block px-4 py-2 rounded-md hover:bg-blue-100 hover:text-blue-700"
                     activeClass="bg-green-800 text-white">
                @Loc["Name"]
            </NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/Email"
                     class="block px-4 py-2 rounded-md hover:bg-blue-100 hover:text-blue-700"
                     activeClass="bg-green-800 text-white">
                @Loc["Email"]
            </NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/Bio"
                     class="block px-4 py-2 rounded-md hover:bg-blue-100 hover:text-blue-700"
                     activeClass="bg-green-800 text-white">
                @Loc["Bio"]
            </NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/Mobile"
                     class="block px-4 py-2 rounded-md hover:bg-blue-100 hover:text-blue-700"
                     activeClass="bg-green-800 text-white">
                @Loc["Mobile"]
            </NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/SocialMedia"
                     class="block px-4 py-2 rounded-md hover:bg-blue-100 hover:text-blue-700"
                     activeClass="bg-green-800 text-white">
                @Loc["SocialMedia"]
            </NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/ChangePassword"
                     class="block px-4 py-2 rounded-md hover:bg-blue-100 hover:text-blue-700"
                     activeClass="bg-green-800 text-white">
                @Loc["Password"]
            </NavLink>
        </li>
        @if (hasExternalLogins)
        {
            <li>
                <NavLink href="Account/Manage/ExternalLogins"
                         class="block px-4 py-2 rounded-md hover:bg-blue-100 hover:text-blue-700"
                         activeClass="bg-green-800 text-white">
                    External logins
                </NavLink>
            </li>
        }
        <li>
            <NavLink href="Account/Manage/TwoFactorAuthentication"
                     class="block px-4 py-2 rounded-md hover:bg-blue-100 hover:text-blue-700"
                     activeClass="bg-green-800 text-white">
                Two-factor authentication
            </NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/PersonalData"
                     class="block px-4 py-2 rounded-md hover:bg-blue-100 hover:text-blue-700"
                     activeClass="bg-green-800 text-white">
                Personal data
            </NavLink>
        </li>
    </ul>
</div>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
