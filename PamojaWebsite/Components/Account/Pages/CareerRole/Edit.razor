@page "/Career-Roles/edit"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Edit</PageTitle>

<div class="container mx-auto px-4 py-12">
    <section class="text-green-900 rounded-xl p-2">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-2xl md:text-5xl font-bold mb-4">Edit</h1>
        </div>
    </section>
    <div class="space-y-8">
        <div class="p-8 text-end">
            <a href="/Career-Roles" class="bg-gray-100 text-green-900 p-3 rounded-full hover:bg-gray-200 transition">
                Back to List
            </a>
        </div>
    </div>
    <div class="row mx-auto px-20">
        <div class="col-md-8">
            @if (CareerRole is null)
            {
                <p><em>Loading...</em></p>
            }
            else
            {
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
                    <div class="bg-white p-8 rounded-xl shadow-lg">
                        <EditForm method="post" Model="careerRoleDTO" OnValidSubmit="UpdateCareerRole" FormName="edit" Enhance>
                            <DataAnnotationsValidator />
                            <ValidationSummary role="alert" />
                            <div class="mb-3">
                                <label for="name" class="form-label">Title:</label>
                                <InputText id="name" @bind-Value="careerRoleDTO.Name" class="form-control" />
                                <ValidationMessage For="() => careerRoleDTO.Name" class="text-danger" />
                            </div>
                            <div class="mb-3">
                                <label for="careerfield" class="form-label">Field:</label>
                                <InputText id="careerfield" @bind-Value="careerRoleDTO.CareerField" class="form-control" />
                                <ValidationMessage For="() => careerRoleDTO.CareerField" class="text-danger" />
                            </div>
                            <div class="mb-3">
                                <label for="experiencelevel" class="form-label">Experience Level:</label>
                                <InputSelect id="level" class="form-select" @bind-Value="careerRoleDTO.ExperienceLevel">
                                    <option value="">-- Choose an experience level --</option>
                                    @foreach (var level in ExperienceLevels)
                                    {
                                        <option value="@level">@level</option>
                                    }
                                </InputSelect>

                                <ValidationMessage For="() => careerRoleDTO.ExperienceLevel" class="text-danger" />
                            </div>
                            <div class="mb-3">
                                <label for="location" class="form-label">Location:</label>
                                <InputSelect id="location" class="form-select" @bind-Value="careerRoleDTO.Location">
                                    <option value="">-- Choose a location --</option>
                                    @foreach (var location in AvailableLocations)
                                    {
                                        <option value="@location">@location</option>
                                    }
                                </InputSelect>

                                <ValidationMessage For="() => careerRoleDTO.Location" class="text-danger" />
                            </div>
                            <div class="mb-3">
                                <label for="worktype" class="form-label">Work Type:</label>
                                <InputSelect id="worktype" class="form-select" @bind-Value="careerRoleDTO.WorkType">
                                    <option value="">-- Choose a work type --</option>
                                    @foreach (var worktype in WorkTypes)
                                    {
                                        <option value="@worktype">@worktype</option>
                                    }
                                </InputSelect>

                                <ValidationMessage For="() => careerRoleDTO.WorkType" class="text-danger" />
                            </div>
                            <div class="mb-3">
                                <label for="name" class="form-label">Description:</label>
                                <InputTextArea rows="6" id="name" @bind-Value="careerRoleDTO.Description" class="form-control" />
                                <ValidationMessage For="() => careerRoleDTO.Description" class="text-danger" />
                            </div>
                            <div class="mb-3">
                                <label for="name" class="form-label">Link:</label>
                                <InputText id="name" @bind-Value="careerRoleDTO.Link" class="form-control" />
                                <ValidationMessage For="() => careerRoleDTO.Link" class="text-danger" />
                            </div>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string Id { get; set; }

    private List<string> ExperienceLevels = new() { "Entry", "Mid", "Senior", "Lead" };

    private List<string> AvailableLocations = new() { "Nairobi", "Remote", "London" };

    private List<string> WorkTypes = new() { "Hybrid", "Remote", "On-Site" };

    [SupplyParameterFromForm]
    private CareerRoleDTO careerRoleDTO { get; set; } = new();

    private CareerRole? CareerRole { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        CareerRole ??= await context.CareerRole.FirstOrDefaultAsync(m => m.Id == Id);

        if (CareerRole is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        careerRoleDTO.Name = CareerRole.Name;
        careerRoleDTO.Description = CareerRole.Description;
        careerRoleDTO.WorkType = CareerRole.WorkType;
        careerRoleDTO.Location = CareerRole.Location;
        careerRoleDTO.ExperienceLevel = CareerRole.ExperienceLevel;
        careerRoleDTO.Link = CareerRole.Link;
        careerRoleDTO.CareerField = CareerRole.CareerField;
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateCareerRole()
    {
        using var context = DbFactory.CreateDbContext();

        try
        {
            CareerRole.Name = careerRoleDTO.Name;
            CareerRole.Description = careerRoleDTO.Description;
            CareerRole.WorkType = careerRoleDTO.WorkType;
            CareerRole.Location = careerRoleDTO.Location;
            CareerRole.ExperienceLevel = careerRoleDTO.ExperienceLevel;
            CareerRole.Link = careerRoleDTO.Link;
            CareerRole.CareerField = careerRoleDTO.CareerField;
            context.Attach(CareerRole!).State = EntityState.Modified;
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!CareerRoleExists(CareerRole!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/Career-Roles");
    }

    private bool CareerRoleExists(string id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.CareerRole.Any(e => e.Id == id);
    }
    public class CareerRoleDTO
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? WorkType { get; set; }
        public string? Location { get; set; }
        public string? ExperienceLevel { get; set; }
        public string? Link { get; set; }
        public string? CareerField { get; set; }
    }
}
