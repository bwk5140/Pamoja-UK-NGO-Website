@page "/Career-Roles/details"
@using Microsoft.EntityFrameworkCore
@using PamojaWebsite.Data
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<div class="container mx-auto px-4 py-12">
    <section class="text-green-900 rounded-xl p-2">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-2xl md:text-5xl font-bold mb-4">Details</h1>
        </div>
    </section>
    <div class="space-y-8">
        <div class="p-8 text-end">
            <a href="/Career-Roles" class="bg-gray-100 text-green-900 p-3 rounded-full hover:bg-gray-200 transition">
                Back to List
            </a>
        </div>
    </div>
    <div class="row mx-auto px-20">
        <div class="col-md-8">
            @if (careerrole is null)
            {
                <p><em>Loading...</em></p>
            }
            else
            {
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
                    <div class="bg-white p-8 rounded-xl shadow-lg">
                        <form class="space-y-6">
                            <div>
                                <label for="name" class="block text-gray-700 mb-2">Title</label>
                                <input type="text" id="name" disabled value="@careerrole.Name" class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                                focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            </div>
                            <div>
                                <label for="field" class="block text-gray-700 mb-2">Field</label>
                                <input type="text" id="field" disabled value="@careerrole.CareerField" class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                                focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            </div>
                            <div>
                                <label for="experiencelevel" class="block text-gray-700 mb-2">Field</label>
                                <input type="text" id="experiencelevel" disabled value="@careerrole.ExperienceLevel" class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                                        focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            </div>
                            <div>
                                <label for="location" class="block text-gray-700 mb-2">Field</label>
                                <input type="text" id="location" disabled value="@careerrole.Location" class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                                        focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            </div>
                            <div>
                                <label for="worktype" class="block text-gray-700 mb-2">Field</label>
                                <input type="text" id="worktype" disabled value="@careerrole.WorkType" class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                                        focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            </div>
                            <div>
                                <label for="description" class="block text-gray-700 mb-2">Description</label>
                                <textarea rows="6" type="text" id="description" disabled class="w-full px-4 py-3 border border-gray-300 rounded-lg
                                                    focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                    @careerrole.Description
                                </textarea>
                            </div>
                            <div>
                                <a href="@careerrole.Link" class="text-blue-500 mt-2 inline-block">View Details →</a>
                            </div>
                            <div class="py-1">
                                <a href="@($"Career-Roles/edit?id={careerrole.Id}")" class="bg-gray-200 text-green-900 p-2 rounded hover:bg-gray-300 transition">
                                    Edit
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private CareerRole? careerrole;

    [SupplyParameterFromQuery]
    private string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        careerrole = await context.CareerRole.FirstOrDefaultAsync(m => m.Id == Id);

        if (careerrole is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
