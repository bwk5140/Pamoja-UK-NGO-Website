@page "/Account/Lockout"

@inject IStringLocalizer<SharedResource> Loc

<PageTitle>Locked out</PageTitle>

<div class="container-sm" style="text-align: center; color: #2f4f4f;">
    <div class="flex justify-center w-full">
        <a href="/" style="text-decoration: none;"><img class="mb-2" src="Images/PamojaLogo.png" width="180" height="140" /></a>
    </div>
    <div class="center-container">
        <div class="card" style="border-radius: 15px; width: 400px;">
            <div class="card-header">
                <h5>@Loc["LockedOut"]</h5>
            </div>
            <div class="card-body">
                <p class="text-danger" role="alert">
                    @Loc["AccountLockedOut"]
                </p>
            </div>
        </div>
    </div>
</div>