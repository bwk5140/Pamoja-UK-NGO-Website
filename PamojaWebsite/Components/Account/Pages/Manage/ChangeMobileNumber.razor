@page "/Account/Manage/Mobile"

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager

@inject IStringLocalizer<SharedResource> Loc

<PageTitle>Profile</PageTitle>

<div class="pt-[5%] mb-5 py-20">
    <div class="flex justify-center max-w-xl mx-auto">
        <div class="bg-white p-8 rounded-xl shadow-lg w-96 border border-gray-200">
            <h2 class="text-2xl font-bold mb-6 text-green-900">@Loc["Mobile"]</h2>
            <StatusMessage />
            <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="form-floating mb-3">
                    <label for="Input.PhoneNumber" class="relative text-gray-500 text-sm transition-all peer-placeholder-shown:top-5 peer-placeholder-shown:text-gray-400 peer-placeholder-shown:text-base peer-focus:top-2 peer-focus:text-gray-500 peer-focus:text-sm">@Loc["EnterPhoneNumber"]</label>
                    <InputText @bind-Value="Input.PhoneNumber" id="Input.PhoneNumber" class="@($"{InputClass(() => Input.PhoneNumber)}")" />
                    <ValidationMessage For="() => Input.PhoneNumber" class="text-danger" />
                </div>
                <button type="submit" style="background-color: #2f4f4f; color: white;"
                        class="w-full btn btn-lg btn-primary mb-3 p-2 rounded">
                    @Loc["Save"]
                </button>
            </EditForm>
        </div>
    </div>
</div>



@code {
    private ApplicationUser user = default!;
    private string? phoneNumber;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private EditContext editContext;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        if (user is not null){
            phoneNumber = await UserManager.GetPhoneNumberAsync(user);
        }
        Input.PhoneNumber ??= phoneNumber;
    }

    private async Task OnValidSubmitAsync()
    {
        if (Input.PhoneNumber != phoneNumber)
        {
            var setPhoneResult = await UserManager.SetPhoneNumberAsync(user, Input.PhoneNumber);
            if (!setPhoneResult.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus("Error: Failed to set phone number.", HttpContext);
            }
        }
        if (user is not null){
            await SignInManager.RefreshSignInAsync(user);
            RedirectManager.RedirectToCurrentPageWithStatus("Your profile has been updated", HttpContext);
        }
        else{
            return;
        }
    }
    // Helper to compute Tailwind classes and add red border when field has errors
    private string InputClass<T>(Expression<Func<T>> accessor)
    {
        var baseClasses = "w-full px-4 py-2 border rounded-md focus:ring-primary-500 focus:border-primary-500";
        return HasValidationError(accessor)
            ? $"{baseClasses} border-red-500 focus:border-red-500"
            : $"{baseClasses} border-gray-300";
    }

    private bool HasValidationError<T>(Expression<Func<T>> accessor)
    {
        if (editContext == null) return false;
        var field = FieldIdentifier.Create(accessor);
        return editContext.GetValidationMessages(field).Any();
    }
    private sealed class InputModel
    {
        [Required]
        [Phone]
        [Display(Name = "Phone number")]
        public string? PhoneNumber { get; set; }
    }
}
