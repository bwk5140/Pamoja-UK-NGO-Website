@page "/Account/Manage/DeletePersonalData"

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger

<PageTitle>Delete Personal Data</PageTitle>


<div class="pt-[5%] mb-5 py-20">
    <StatusMessage Message="@message" />

    <h3 class="font-bold text-gray-500 mb-2 mt-5">Delete Personal Data</h3>
    <div class="alert alert-warning" role="alert">
        <p>
            <strong class="mt-2 mb-2">Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
        </p>
    </div>
    <div class="flex justify-center max-w-xl mx-auto mt-5">
        <div class="bg-white p-8 rounded-xl shadow-lg w-96 border border-gray-200">
            <EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                @if (requirePassword)
                {
                    <div class="form-floating mb-3">
                        <label for="Input.Password" class="relative text-gray-500 text-sm transition-all peer-placeholder-shown:top-5 peer-placeholder-shown:text-gray-400 peer-placeholder-shown:text-base peer-focus:top-2 peer-focus:text-gray-500 peer-focus:text-sm">Password</label>
                        <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="@($"{InputClass(() => Input.Password)}")" autocomplete="current-password" aria-required="true" placeholder="Please enter your password." />
                        <ValidationMessage For="() => Input.Password" class="text-danger" />
                    </div>
                }
                <div class="py-2">
                    <button type="submit"
                            class="w-full btn btn-lg btn-danger bg-red-600 text-white mb-3 p-4 rounded">
                        Delete data and close my account
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool requirePassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private EditContext editContext;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        if (user is not null){
            requirePassword = await UserManager.HasPasswordAsync(user);
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is not null){
            if (requirePassword && !await UserManager.CheckPasswordAsync(user, Input.Password))
            {
                message = "Error: Incorrect password.";
                return;
            }

            var result = await UserManager.DeleteAsync(user);
            if (!result.Succeeded)
            {
                throw new InvalidOperationException("Unexpected error occurred deleting user.");
            }

            await SignInManager.SignOutAsync();

            var userId = await UserManager.GetUserIdAsync(user);
            Logger.LogInformation("User with ID '{UserId}' deleted themselves.", userId);
        }
        RedirectManager.RedirectToCurrentPage();
    }
    // Helper to compute Tailwind classes and add red border when field has errors
    private string InputClass<T>(Expression<Func<T>> accessor)
    {
        var baseClasses = "w-full px-4 py-2 border rounded-md focus:ring-primary-500 focus:border-primary-500";
        return HasValidationError(accessor)
            ? $"{baseClasses} border-red-500 focus:border-red-500"
            : $"{baseClasses} border-gray-300";
    }

    private bool HasValidationError<T>(Expression<Func<T>> accessor)
    {
        if (editContext == null) return false;
        var field = FieldIdentifier.Create(accessor);
        return editContext.GetValidationMessages(field).Any();
    }
    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
