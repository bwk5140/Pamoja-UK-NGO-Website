@page "/Account/AccessDenied"

@inject IStringLocalizer<SharedResource> Loc

<PageTitle>Access denied</PageTitle>

<div class="container-sm mt-5" style="text-align: center; color: #2f4f4f;">
    <a href="/" style="text-decoration: none;"><img src="CompanyLogo.png" width="90" height="60" /></a>
    <div class="center-container">
        <div class="card" style="border-radius: 15px; width: 400px;">
            <div class="card-header">
                <h4 class="text-danger">@Loc["AccessDenied"]</h4>
            </div>
            <div class="card-body">
                <p class="text-danger">@Loc["DontHaveAccess"]</p>
            </div>
        </div>
    </div>
</div>
