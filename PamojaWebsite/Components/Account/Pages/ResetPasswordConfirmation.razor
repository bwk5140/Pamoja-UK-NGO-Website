@page "/Account/ResetPasswordConfirmation"

@inject IStringLocalizer<SharedResource> Loc

<PageTitle>Reset password confirmation | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'auto'});
</script>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <div class="container-sm" style="text-align: center; color: #2f4f4f;">
        <div class="flex justify-center w-full">
            <a aria-label="Navigate to home page" href="/" style="text-decoration: none;"><img alt="Pamoja logo" loading="lazy" class="mb-2" src="Images/PamojaLogo.png" width="180" height="140" /></a>
        </div>
        <div class="flex justify-center max-w-xl mx-auto">
            <div class="bg-white p-8 rounded-xl shadow-lg w-96 border border-gray-200">
                <h2 class="text-2xl font-bold mb-6 text-green-900">@Loc["ResetPasswordConfirmation"]</h2>
                <p role="alert">
                    @Loc["YourPassHasBeenReset"] <a href="Account/Login">@Loc["ClickHereToLogin"]</a>.
                </p>
            </div>
        </div>
    </div>
</div>