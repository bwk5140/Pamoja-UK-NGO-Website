@page "/Account/Login"

@inject IStringLocalizer<SharedResource> Loc
@inject EmailEncryptor EmailEncryptor
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<InitLogin> Logger
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager


<PageTitle>Log in | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'auto'});
</script>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <div class="container-sm" style="text-align: center;">
        <div class="flex justify-center w-full">
            <a href="/" style="text-decoration: none;"><img loading="lazy" class="mb-2" src="Images/PamojaLogo.png" width="180" height="140" /></a>
        </div>
        <div class="center-container">
            <div class="card" style="border-radius: 15px; width: 400px;">
                <div class="card-header">
                    <h4 class="header mb-3">@Loc["Login"]</h4>
                </div>
                <div class="card-body">
                    <StatusMessage Message="@errorMessage" />
                    <EditForm Model="Input" method="post" OnValidSubmit="InitiateUserLogin" FormName="login">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" role="alert" />
                        <div class="form form-floating mb-3">
                            <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="" />
                            <label for="Input.Email">@Loc["EmailOrUsername"]</label>
                            <ValidationMessage For="() => Input.Email" class="text-danger" />
                        </div>
                        <button type="submit" style="background-color: #2f4f4f; color: white;"
                                class="w-100 btn btn-lg btn-primary mb-3">
                            @Loc["Continue"]
                        </button>
                        <a class="text-green-900 mt-4 mb-4" href="/Account/Register">@Loc["Register"] here</a>
                    </EditForm>
                </div>
                <section>
                    <div style="display: flex; align-items: center; text-align: center; color: gray;">
                        <hr style="flex: 1;" />
                        <span style="padding: 0 1em;">or</span>
                        <hr style="flex: 1;" />
                    </div>
                    <ExternalLoginPicker />
                </section>
            </div>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear the existing external cookie to ensure a clean login process
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
        if (!string.IsNullOrWhiteSpace(Id) && string.IsNullOrWhiteSpace(Input.Email))
        {
            Input.Email = EmailEncryptor.DecryptEmail(Id);
        }
    }

    public async Task InitiateUserLogin()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email!);
        var encryptedEmail = EmailEncryptor.EncryptEmail(Input.Email);
        if (user is not null && !string.IsNullOrWhiteSpace(encryptedEmail))
        {
            RedirectManager.RedirectTo(
            "/Account/Login/Complete",
                new() { ["returnUrl"] = ReturnUrl, ["Id"] = encryptedEmail });
        }
        else
        {
            RedirectManager.RedirectTo(
            "/Account/Register/Initial",
            new() { ["returnUrl"] = ReturnUrl, ["Id"] = encryptedEmail });
        }
    }

    private sealed class InputModel
    {
        [Required]
        public string Email { get; set; } = "";
    }
}
