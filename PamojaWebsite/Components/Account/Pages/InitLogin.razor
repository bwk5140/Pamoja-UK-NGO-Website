@page "/Account/Login"

@inject IStringLocalizer<SharedResource> Loc
@inject EmailEncryptor EmailEncryptor
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<InitLogin> Logger
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager


<PageTitle>Log in | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'auto'});
</script>

<div class="pt-[5%] mb-5 py-20 mt-5">
    <div class="container-sm" style="text-align: center;">
        <div class="flex justify-center w-full">
            <a aria-label="Navigate to home page" href="/" style="text-decoration: none;"><img alt="Pamoja logo" loading="lazy" class="mb-2" src="Images/PamojaLogo.png" width="180" height="140" /></a>
        </div>
        <div class="flex justify-center max-w-xl mx-auto">
            <div class="bg-white p-8 rounded-xl shadow-lg w-96 border border-gray-200">
                <h2 class="text-2xl font-bold mb-6 text-green-900">@Loc["Login"]</h2>
                <StatusMessage Message="@errorMessage" />
                <EditForm Model="Input" method="post" OnValidSubmit="InitiateUserLogin" FormName="login">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />

                    <div style="text-align: left;">
                        <label for="Input.Email" class="relative text-gray-500 text-sm transition-all peer-placeholder-shown:top-5 peer-placeholder-shown:text-gray-400 peer-placeholder-shown:text-base peer-focus:top-2 peer-focus:text-gray-500 peer-focus:text-sm">@Loc["EmailOrUsername"]</label>
                        <InputText @bind-Value="Input.Email" id="Input.Email" class="@InputClass(() => Input.Email)" autocomplete="username" aria-required="true" placeholder="" />
                        <ValidationMessage For="@(() => Input.Email)" class="text-sm text-red-600 mt-1" />
                    </div>
                    <div class="py-2">
                        <button type="submit" style="background-color: #2f4f4f; color: white;"
                                class="w-full btn btn-lg btn-primary mb-3 p-2 rounded-md">
                            @Loc["Continue"]
                        </button>
                    </div>
                </EditForm>
                <section>
                    <div style="display: flex; align-items: center; text-align: center; color: gray;">
                        <hr style="flex: 1;" />
                        <span style="padding: 0 1em;">or</span>
                        <hr style="flex: 1;" />
                    </div>
                    <ExternalLoginPicker />
                </section>
                <div style="display: flex; align-items: center; text-align: center; color: gray;">
                    <hr style="flex: 1;" />
                    <span style="padding: 0 1em;">
                        <a class="text-green-900" aria-details="Register as a new user" href="/Account/Register">@Loc["Register"]</a>
                    </span>
                    <hr style="flex: 1;" />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    private EditContext editContext;

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear the existing external cookie to ensure a clean login process
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
        if (!string.IsNullOrWhiteSpace(Id) && string.IsNullOrWhiteSpace(Input.Email))
        {
            Input.Email = EmailEncryptor.DecryptEmail(Id);
        }
    }

    public async Task InitiateUserLogin()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email!);
        var encryptedEmail = EmailEncryptor.EncryptEmail(Input.Email);
        if (user is not null && !string.IsNullOrWhiteSpace(encryptedEmail))
        {
            RedirectManager.RedirectTo(
            "/Account/Login/Complete",
                new() { ["returnUrl"] = ReturnUrl, ["Id"] = encryptedEmail });
        }
        else
        {
            RedirectManager.RedirectTo(
            "/Account/Register/Initial",
            new() { ["returnUrl"] = ReturnUrl, ["Id"] = encryptedEmail });
        }
    }
    private string InputClass<T>(Expression<Func<T>> accessor)
    {
        var baseClasses = "w-full px-4 py-2 border rounded-md focus:ring-primary-500 focus:border-primary-500";
        return HasValidationError(accessor)
            ? $"{baseClasses} border-red-500 focus:border-red-500"
            : $"{baseClasses} border-gray-300";
    }

    private bool HasValidationError<T>(Expression<Func<T>> accessor)
    {
        if (editContext == null) return false;
        var field = FieldIdentifier.Create(accessor);
        return editContext.GetValidationMessages(field).Any();
    }
    private sealed class InputModel
    {
        [Required]
        public string Email { get; set; } = "";
    }
}
