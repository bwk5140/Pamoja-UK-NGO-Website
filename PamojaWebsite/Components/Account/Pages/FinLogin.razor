@page "/Account/Login/Complete"

@inject IStringLocalizer<SharedResource> Loc
@inject EmailEncryptor EmailEncryptor
@inject IDbContextFactory<PamojaWebsite.Data.Contexts.ApplicationDbContext> DbFactory
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<FinLogin> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Log in | Pamoja Counselling, Mental Wellbeing and Safeguarding Services</PageTitle>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG"></script>
<script>
    function loadGA() {
      if (window.gaLoaded) return;
      window.gaLoaded = true;

      var script = document.createElement('script');
      script.src = "https://www.googletagmanager.com/gtag/js?id=G-KY5W04MBEG";
      script.async = true;
      document.head.appendChild(script);

      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KY5W04MBEG', {'cookie_domain': 'pamojasafeguardingnetwork.co.uk', 'anonymize_ip': true});
    }

    // Fire when browser is idle or after first interaction
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => setTimeout(loadGA, 2000));
    } else {
      setTimeout(loadGA, 3000);
    }
</script>

<div class="pt-[10%] mb-5 py-10">
    <div class="container-sm" style="text-align: center;">
        <div class="flex justify-center w-full">
            <a aria-label="Navigate to home page" href="/" style="text-decoration: none;">
                <img fetchpriority="high"
                     loading="eager" src="Images/PamojaLogo.webp" class="h-36 w-36" alt="Pamoja logo" width="128" height="128" />
            </a>
        </div>
        <div class="flex justify-center max-w-xl mx-auto">
            <div class="bg-white p-8 rounded-xl shadow-lg w-96 border border-gray-200">
                <h2 class="text-2xl font-bold mb-6 text-green-900">@Loc["Login"]</h2>
                <StatusMessage Message="@errorMessage" />
                <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />
                    @if (Email is not null)
                    {
                        <div class="row mb-3 bg-gray-50 rounded-md p-4">
                            <div class="col-sm-9" style="text-align: left;">
                                <strong>@Email</strong>
                            </div>
                            <div class="col-sm-3" style="text-align: right;">
                                <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Login", new Dictionary<string, object?>
                                   { ["ReturnUrl"] = ReturnUrl, ["Id"] = EmailEncryptor.EncryptEmail(Email) }))" style="text-decoration: none;">
                                    @Loc["Change"]
                                </a>
                            </div>
                        </div>
                    }
                    <div style="text-align: left;">
                        <label for="Input.password" class="relative text-gray-500 text-sm transition-all peer-placeholder-shown:top-5 peer-placeholder-shown:text-gray-400 peer-placeholder-shown:text-base peer-focus:top-2 peer-focus:text-gray-500 peer-focus:text-sm">@Loc["Password"]</label>
                        <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="@InputClass(() => Input.Password)" autocomplete="current-password" aria-required="true"
                                   placeholder="" />
                        <ValidationMessage For="@(() => Input.Password)" class="text-sm text-red-600 mt-1" />
                    </div>
                    <div class="checkbox mb-3" style="text-align:left;">
                        <label class="form-label">
                            <InputCheckbox @bind-Value="Input.RememberMe" class="darker-border-checkbox form-check-input" />
                            @Loc["RememberMe"]
                        </label>
                    </div>
                    <div class="py-2">
                        <button type="submit" style="background-color: #2f4f4f; color: white;"
                                class="w-full btn btn-lg btn-primary mb-3 p-2 rounded-md">
                            @Loc["Login"]
                        </button>
                    </div>
                </EditForm>
                <div>
                    <p>
                        <a style="color: darkslategray;" href="Account/ForgotPassword">@Loc["ForgotPassword"]</a>
                    </p>
                    <p>
                        <a style="color: darkslategray;" href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?>
                                                         { ["ReturnUrl"] = ReturnUrl }))">@Loc["Registration"]</a>
                    </p>
                </div>
            </div>
        </div>     
    </div>
</div>


@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Id { get; set; }

    [Parameter]
    public string? Email { get; set; }

    [Parameter]
    public string? EncryptedEmail { get; set; }

    private EditContext editContext;

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear the existing external cookie to ensure a clean login process
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
        if (!string.IsNullOrWhiteSpace(Id))
        {
            Email = EmailEncryptor.DecryptEmail(Id);
        }
    }

    public async Task LoginUser()
    {
        // This doesn't count login failures towards account lockout
        // To enable password failures to trigger account lockout, set lockoutOnFailure: true

        var result = await SignInManager.PasswordSignInAsync(Email, Input.Password, Input.RememberMe, lockoutOnFailure: false);
        ReturnUrl = "/";
        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo(
                "Account/LoginWith2fa",
                new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User account locked out.");
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            errorMessage = Loc["Invalid Login"];
        }
    }
    private string InputClass<T>(Expression<Func<T>> accessor)
    {
        var baseClasses = "w-full px-4 py-2 border rounded-md focus:ring-primary-500 focus:border-primary-500";
        return HasValidationError(accessor)
            ? $"{baseClasses} border-red-500 focus:border-red-500"
            : $"{baseClasses} border-gray-300";
    }

    private bool HasValidationError<T>(Expression<Func<T>> accessor)
    {
        if (editContext == null) return false;
        var field = FieldIdentifier.Create(accessor);
        return editContext.GetValidationMessages(field).Any();
    }
    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Remember me?")]
        public bool RememberMe { get; set; }
    }
}
